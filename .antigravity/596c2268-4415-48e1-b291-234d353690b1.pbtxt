  file_change {
    absolute_path_uri: "file:///src/components/RestaurantSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { UtensilsCrossed, Leaf, MapPin, Sparkles, Info } from \'lucide-react\';\nimport { RestaurantRecommendation } from \'../types\';\nimport { getFoodPhoto } from \'../utils/imageService\';\n\ninterface RestaurantSectionProps {\n  restaurants?: RestaurantRecommendation[];\n  destination: string;\n  isLargeText: boolean;\n}\n\nexport const RestaurantSection: React.FC<RestaurantSectionProps> = ({\n  restaurants,\n  destination,\n  isLargeText,\n}) => {\n  if (!restaurants || restaurants.length === 0) {\n    return (\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-8 text-center shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <UtensilsCrossed className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-black text-[#1A1A1A]\">Food & Dining Guide</h3>\n        <p className=\"mt-1 text-sm font-medium text-stone-500\">\n          No dining recommendations were included in this plan.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-black\' : \'text-lg sm:text-xl font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A]\">\n                <UtensilsCrossed className=\"h-5 w-5\" />\n              </span>\n              <h2 className={`${titleSize} text-[#1A1A1A]`}>\n                Top Food & Restaurant Guide in {destination.split(\',\')[0]}\n              </h2>\n            </div>\n            <p className={`mt-1 font-medium text-stone-600 ${bodySize}`}>\n              Iconic local dishes, vegetarian-friendly eateries, and comfortable dining spaces with estimated prices in \342\202\271 for two.\n            </p>\n          </div>\n          <span className=\"inline-flex self-start sm:self-auto rounded-full border border-[#1A1A1A] bg-[#C5E876] px-3 py-1 text-xs font-black text-[#1A1A1A]\">\n            Prices in INR (\342\202\271) for Two\n          </span>\n        </div>\n      </div>\n\n      {/* Restaurant Cards Grid */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-3\">\n        {restaurants.map((place, idx) => {\n          const photoUrl = getFoodPhoto(place.must_try_dish || place.cuisine_type);\n          const isPureVeg = place.veg_friendliness.toLowerCase().includes(\'pure veg\');\n          const isVegFriendly = place.veg_friendliness.toLowerCase().includes(\'excellent veg\') || isPureVeg;\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[6px_6px_0px_0px_#1A1A1A] transition hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_#1A1A1A]\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden border-b-2 border-[#1A1A1A] bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={place.must_try_dish}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-flex items-center gap-1 rounded-full border border-[#1A1A1A] px-3 py-1 text-xs font-black shadow-xs ${\n                      isPureVeg\n                        ? \'bg-[#C5E876] text-[#1A1A1A]\'\n                        : isVegFriendly\n                        ? \'bg-[#89CFF0] text-[#1A1A1A]\'\n                        : \'bg-white text-[#1A1A1A]\'\n                    }`}\n                  >\n                    {isVegFriendly && <Leaf className=\"h-3.5 w-3.5\" />}\n                    <span>{place.veg_friendliness}</span>\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl border border-white bg-black/80 px-3 py-1 text-xs font-black text-white backdrop-blur-xs\">\n                  Approx \342\202\271{place.approx_cost_inr_for_two?.toLocaleString(\'en-IN\') || \'\342\200\224\'} for two\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <h3 className={`font-black text-[#1A1A1A] ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                    {place.name}\n                  </h3>\n                  <p className=\"text-xs font-bold text-stone-600\">{place.cuisine_type}</p>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-[#1A1A1A]\" />\n                    <span>{place.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Must Try Dish */}\n                <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <p className=\"text-xs font-black text-[#1A1A1A] uppercase tracking-wide flex items-center gap-1\">\n                    <Sparkles className=\"h-3 w-3 text-[#1A1A1A]\" />\n                    Must-Try Specialty\n                  </p>\n                  <p className={`mt-0.5 font-black text-[#1A1A1A] ${isLargeText ? \'text-base\' : \'text-sm\'}`}>\n                    {place.must_try_dish}\n                  </p>\n                </div>\n\n                {/* Senior & Family Tips */}\n                <div className=\"flex-1 rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <p className=\"text-xs font-black text-stone-700 uppercase tracking-wide flex items-center gap-1\">\n                    <Info className=\"h-3 w-3 text-[#1A1A1A]\" />\n                    Dining & Comfort Tip\n                  </p>\n                  <p className={`mt-1 font-medium text-stone-700 ${bodySize}`}>\n                    {place.senior_and_family_tips}\n                  </p>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
