      replacement_content: "import React from \'react\';\nimport {\n  Bus,\n  ShieldCheck,\n  Luggage,\n  HeartHandshake,\n  Check,\n  AlertTriangle,\n  Accessibility,\n} from \'lucide-react\';\nimport { LocalLogisticsGuide } from \'../types\';\n\ninterface LogisticsGuideCardProps {\n  guide: LocalLogisticsGuide;\n  isLargeText: boolean;\n}\n\nexport const LogisticsGuideCard: React.FC<LogisticsGuideCardProps> = ({ guide, isLargeText }) => {\n  const titleSize = isLargeText ? \'text-lg sm:text-xl font-bold\' : \'text-base sm:text-lg font-bold\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Transit Advice */}\n      <div className=\"rounded-3xl border border-stone-200 bg-white p-6 shadow-xs\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-blue-800\">\n            <Bus className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className={`${titleSize} text-stone-900`}>Recommended Local Transit Method</h3>\n            <p className=\"text-xs text-stone-500\">Fastest and most comfortable ways to get around</p>\n          </div>\n        </div>\n        <p className={`mt-4 font-medium text-stone-800 ${bodySize}`}>\n          {guide.best_transit_method}\n        </p>\n      </div>\n\n      {/* Senior & Accessibility Notes */}\n      {guide.senior_and_accessibility_notes && (\n        <div className=\"rounded-3xl border border-emerald-200 bg-emerald-50/70 p-6 shadow-xs\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-600 text-white\">\n              <Accessibility className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h3 className={`${titleSize} text-emerald-950`}>\n                Senior & Accessibility Comfort Notes\n              </h3>\n              <p className=\"text-xs text-emerald-700\">Special assistance, elevators & walking ease</p>\n            </div>\n          </div>\n          <p className={`mt-3 font-medium text-emerald-900 ${bodySize}`}>\n            {guide.senior_and_accessibility_notes}\n          </p>\n        </div>\n      )}\n\n      {/* Grid: Etiquette & Packing */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2\">\n        {/* Cultural Etiquette */}\n        <div className=\"rounded-3xl border border-stone-200 bg-white p-6 shadow-xs space-y-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-800\">\n              <HeartHandshake className=\"h-5 w-5\" />\n            </div>\n            <h3 className={`${titleSize} text-stone-900`}>Local Etiquette & Customs</h3>\n          </div>\n          <ul className=\"space-y-2.5\">\n            {guide.cultural_etiquette_alerts.map((item, idx) => (\n              <li key={idx} className={`flex items-start gap-2.5 ${bodySize} text-stone-700`}>\n                <AlertTriangle className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-600\" />\n                <span>{item}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Packing Essentials */}\n        <div className=\"rounded-3xl border border-stone-200 bg-white p-6 shadow-xs space-y-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800\">\n              <Luggage className=\"h-5 w-5\" />\n            </div>\n            <h3 className={`${titleSize} text-stone-900`}>Packing Essentials</h3>\n          </div>\n          <ul className=\"space-y-2.5\">\n            {guide.packing_essentials.map((item, idx) => (\n              <li key={idx} className={`flex items-start gap-2.5 ${bodySize} text-stone-700`}>\n                <Check className=\"mt-0.5 h-4 w-4 shrink-0 text-emerald-600\" />\n                <span>{item}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
