  file_change {
    absolute_path_uri: "file:///src/components/HotelSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Building2, Check, Sparkles, MapPin, IndianRupee, HeartHandshake } from \'lucide-react\';\nimport { HotelRecommendation } from \'../types\';\nimport { getHotelPhoto } from \'../utils/imageService\';\n\ninterface HotelSectionProps {\n  hotels?: HotelRecommendation[];\n  destination: string;\n  isLargeText: boolean;\n}\n\nexport const HotelSection: React.FC<HotelSectionProps> = ({ hotels, destination, isLargeText }) => {\n  if (!hotels || hotels.length === 0) {\n    return (\n      <div className=\"rounded-3xl border border-stone-200 bg-white p-8 text-center\">\n        <Building2 className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-bold text-stone-800\">Hotel Recommendations</h3>\n        <p className=\"mt-1 text-sm text-stone-500\">\n          No hotel recommendations were included in this itinerary generation.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-bold\' : \'text-lg sm:text-xl font-bold\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-xs\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-8 w-8 items-center justify-center rounded-xl bg-amber-100 text-amber-800\">\n                <Building2 className=\"h-4 w-4\" />\n              </span>\n              <h2 className={`${titleSize} text-stone-900`}>\n                Recommended Stays & Hotels in {destination.split(\',\')[0]}\n              </h2>\n            </div>\n            <p className={`mt-1 text-stone-600 ${bodySize}`}>\n              Carefully curated accommodations across budget tiers, prioritizing comfort, elevator access, and neighborhood safety.\n            </p>\n          </div>\n          <span className=\"inline-flex self-start sm:self-auto rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200\">\n            All prices in INR (\342\202\271)\n          </span>\n        </div>\n      </div>\n\n      {/* Hotel Cards Grid */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-3\">\n        {hotels.map((hotel, idx) => {\n          const photoUrl = getHotelPhoto(hotel.category, hotel.name);\n          const isLuxury = hotel.category.toLowerCase().includes(\'luxury\') || hotel.category.toLowerCase().includes(\'heritage\');\n          const isBudget = hotel.category.toLowerCase().includes(\'budget\');\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={hotel.name}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-block rounded-full px-3 py-1 text-xs font-bold shadow-xs ${\n                      isLuxury\n                        ? \'bg-amber-500 text-white\'\n                        : isBudget\n                        ? \'bg-emerald-600 text-white\'\n                        : \'bg-stone-900 text-white\'\n                    }`}\n                  >\n                    {hotel.category}\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl bg-black/75 px-3 py-1 text-xs font-bold text-white backdrop-blur-xs\">\n                  \342\202\271{hotel.approx_price_inr_per_night?.toLocaleString(\'en-IN\') || \'\342\200\224\'} / night\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <h3 className={`font-bold text-stone-900 ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                    {hotel.name}\n                  </h3>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-amber-600\" />\n                    <span>{hotel.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Best For Badge */}\n                <div className=\"rounded-xl border border-amber-200 bg-amber-50/70 p-3\">\n                  <div className=\"flex items-start gap-2\">\n                    <HeartHandshake className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" />\n                    <div>\n                      <p className=\"text-xs font-bold text-amber-900 uppercase tracking-wide\">\n                        Best Suited For\n                      </p>\n                      <p className={`text-xs text-amber-800 ${isLargeText ? \'text-sm\' : \'text-xs\'}`}>\n                        {hotel.best_for}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Highlights List */}\n                <div className=\"flex-1 space-y-1.5\">\n                  <p className=\"text-xs font-bold text-stone-500 uppercase tracking-wider\">\n                    Key Highlights\n                  </p>\n                  <ul className=\"space-y-1.5\">\n                    {hotel.key_highlights?.map((highlight, hIdx) => (\n                      <li key={hIdx} className={`flex items-start gap-2 ${bodySize} text-stone-700`}>\n                        <Check className=\"mt-1 h-3.5 w-3.5 shrink-0 text-emerald-600\" />\n                        <span>{highlight}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
