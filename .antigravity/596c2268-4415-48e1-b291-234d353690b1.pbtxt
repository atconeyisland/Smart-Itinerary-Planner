        lines {
          text: "              estimated_duration_hours: 2.0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              description: \"Indo-Saracenic museum housing miniature paintings, antique weaponry, Persian carpets, and an Egyptian mummy in cool, shaded galleries with elevator access.\","
