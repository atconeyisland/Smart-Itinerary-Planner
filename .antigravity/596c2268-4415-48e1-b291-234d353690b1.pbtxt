mbol = getCurrencySymbol(currencyCode);\n  const formattedNumber = new Intl.NumberFormat(currencyCode === \'INR\' ? \'en-IN\' : \'en-US\', {\n    maximumFractionDigits: 0,\n  }).format(numeric);\n\n  return `${symbol}${formattedNumber}`;\n}\n"
