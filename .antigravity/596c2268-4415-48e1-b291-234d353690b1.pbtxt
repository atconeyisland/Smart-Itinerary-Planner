        lines {
          text: "          title: \"The Louvre Was Built as a Medieval Fortress\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"The Louvre was originally constructed in 1190 as a defensive fortress against Viking raids. You can still see the excavated medieval moat foundations in the museum basement!\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          tag: \"History\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
