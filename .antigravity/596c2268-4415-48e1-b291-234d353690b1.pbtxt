  file_change {
    absolute_path_uri: "file:///src/components/CostBreakdownCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { DollarSign, Utensils, Ticket, AlertCircle } from \'lucide-react\';\nimport { EstimatedCosts } from \'../types\';\n\ninterface CostBreakdownCardProps {\n  costs: EstimatedCosts;\n  totalDays: number;\n}\n\nexport const CostBreakdownCard: React.FC<CostBreakdownCardProps> = ({\n  costs,\n  totalDays,\n}) => {\n  const dailyTotal = (costs.activities_per_day || 0) + (costs.food_per_day || 0);\n  const tripTotal = dailyTotal * totalDays;\n\n  return (\n    <div className=\"rounded-2xl border border-stone-200 bg-white p-5 shadow-sm\">\n      <div className=\"flex items-center justify-between border-b border-stone-100 pb-3\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-800\">\n            <DollarSign className=\"h-4 w-4\" />\n          </div>\n          <h3 className=\"text-sm font-bold text-stone-900\">Estimated Cost Breakdown</h3>\n        </div>\n        <span className=\"rounded-md bg-stone-100 px-2 py-0.5 text-xs font-semibold text-stone-600\">\n          Currency: {costs.currency || \'USD\'}\n        </span>\n      </div>\n\n      <div className=\"mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3\">\n        {/* Activities */}\n        <div className=\"rounded-xl border border-stone-100 bg-stone-50/70 p-3\">\n          <div className=\"flex items-center gap-2 text-stone-600\">\n            <Ticket className=\"h-3.5 w-3.5 text-amber-700\" />\n            <span className=\"text-xs font-medium\">Activities / Day</span>\n          </div>\n          <p className=\"mt-1.5 text-lg font-bold text-stone-900\">\n            {costs.currency} {costs.activities_per_day}\n          </p>\n          <span className=\"text-[11px] text-stone-500\">Admissions & experiences</span>\n        </div>\n\n        {/* Food */}\n        <div className=\"rounded-xl border border-stone-100 bg-stone-50/70 p-3\">\n          <div className=\"flex items-center gap-2 text-stone-600\">\n            <Utensils className=\"h-3.5 w-3.5 text-amber-700\" />\n            <span className=\"text-xs font-medium\">Food & Dining / Day</span>\n          </div>\n          <p className=\"mt-1.5 text-lg font-bold text-stone-900\">\n            {costs.currency} {costs.food_per_day}\n          </p>\n          <span className=\"text-[11px] text-stone-500\">Breakfast, lunch, cafes & dinner</span>\n        </div>\n\n        {/* Total Est */}\n        <div className=\"rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-3\">\n          <div className=\"flex items-center gap-2 text-emerald-800\">\n            <DollarSign className=\"h-3.5 w-3.5 text-emerald-700\" />\n            <span className=\"text-xs font-bold\">Total Trip Est. ({totalDays}d)</span>\n          </div>\n          <p className=\"mt-1.5 text-lg font-extrabold text-emerald-900\">\n            ~{costs.currency} {tripTotal}\n          </p>\n          <span className=\"text-[11px] text-emerald-700\">~{costs.currency} {dailyTotal}/day per traveler</span>\n        </div>\n      </div>\n\n      {/* Hidden Fees & Taxes Callout */}\n      {costs.hidden_fees_notes && (\n        <div className=\"mt-3.5 flex items-start gap-2 rounded-xl border border-amber-200/80 bg-amber-50/50 p-3 text-xs text-stone-700\">\n          <AlertCircle className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" />\n          <div>\n            <span className=\"font-semibold text-amber-900\">Hidden Fees, Passes & Tourist Taxes: </span>\n            <span className=\"leading-relaxed\">{costs.hidden_fees_notes}</span>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { EstimatedCosts } from \'../types\';\n\ninterface CostBreakdownCardProps {\n  costs: EstimatedCosts;\n  totalDays: number;\n}\n\nexport const CostBreakdownCard: React.FC<CostBreakdownCardProps> = ({\n  costs,\n  totalDays,\n}) => {\n  const dailyTotal = (costs.activities_per_day || 0) + (costs.food_per_day || 0);\n  const tripTotal = dailyTotal * totalDays;\n\n  return (\n    <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-6 shadow-[6px_6px_0px_0px_#1A1A1A] text-[#1A1A1A]\">\n      <h2 className=\"text-xs font-black uppercase tracking-widest mb-4 flex items-center justify-between\">\n        <span className=\"flex items-center gap-2\">\n          <span className=\"w-2.5 h-2.5 bg-[#1A1A1A] rounded-full\" />\n          Estimated Costs\n        </span>\n        <span className=\"rounded-md border border-[#1A1A1A] bg-white px-2 py-0.5 text-[10px] font-black uppercase\">\n          {costs.currency || \'USD\'}\n        </span>\n      </h2>\n\n      <div className=\"space-y-4\">\n        <div className=\"flex justify-between items-end border-b-2 border-[#1A1A1A] border-dashed pb-2\">\n          <span className=\"text-xs font-bold opacity-70 uppercase tracking-wider\">Daily Average</span>\n          <span className=\"text-2xl sm:text-3xl font-black\">\n            ${dailyTotal} <small className=\"text-xs opacity-60 font-bold\">{costs.currency || \'USD\'}</small>\n          </span>\n        </div>\n\n        <div className=\"flex justify-between items-center text-xs sm:text-sm font-bold border-b border-[#1A1A1A]/10 pb-1.5\">\n          <span className=\"opacity-80\">Activities & Admissions / Day</span>\n          <span className=\"font-black\">${costs.activities_per_day}</span>\n        </div>\n\n        <div className=\"flex justify-between items-center text-xs sm:text-sm font-bold border-b border-[#1A1A1A]/10 pb-1.5\">\n          <span className=\"opacity-80\">Food & Dining / Day</span>\n          <span className=\"font-black\">${costs.food_per_day}</span>\n        </div>\n\n        <div className=\"flex justify-between items-center text-xs sm:text-sm font-black pt-1\">\n          <span className=\"uppercase tracking-wider opacity-90\">Total Est. ({totalDays} Days)</span>\n          <span className=\"text-lg font-black bg-white px-2.5 py-0.5 rounded-lg border border-[#1A1A1A]\">\n            ~${tripTotal}\n          </span>\n        </div>\n\n        {costs.hidden_fees_notes && (\n          <div className=\"mt-4 p-3.5 bg-white/70 rounded-2xl text-xs font-medium leading-relaxed italic border-2 border-[#1A1A1A]/10\">\n            <span className=\"font-black not-italic uppercase text-[10px] tracking-wider block mb-0.5 text-[#1A1A1A]\">\n              Taxes & Pass Strategy:\n            </span>\n            {costs.hidden_fees_notes}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
