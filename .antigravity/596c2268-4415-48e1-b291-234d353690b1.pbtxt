    replacement_chunks {
      replacement_content: "import { ItineraryPlanResponse, PlannerInputs } from \'./types\';\n\nexport const SAMPLE_PRESETS: { label: string; description: string; inputs: PlannerInputs; data: ItineraryPlanResponse }[] = [\n  {\n    label: \'Kyoto Cultural & Culinary Journey\',\n    description: \'4-day immersive stroll through ancient temples, tea gardens, and Nishiki Market flavours.\',\n    inputs: {\n      destination: \'Kyoto, Japan\',\n      duration: 4,\n      travelers: \'Couple\',\n      budget: \'Moderate ($180/day)\',\n      pace: \'Balanced\',\n      interests: \'Historic temples, traditional tea ceremony, local food markets, zen gardens\',\n      constraints: \'Early riser preferred, vegetarian-friendly lunch options\'\n    },\n    data: {\n      trip_summary: {\n        destination: \"Kyoto, Japan\",\n        total_days: 4,\n        theme_vibe: \"Timeless Zen, Shaded Bamboo Glades & Artisan Gastronomy\",\n        budget_strategy: \"Prioritized historic temple admissions and curated multi-course dinner allocations while utilizing efficient regional transit passes.\"\n      },\n      estimated_costs: {\n        currency: \"USD\",\n        activities_per_day: 35,\n        food_per_day: 75,\n        hidden_fees_notes: \"Kyoto municipal accommodation tax (approx 200\342\200\223500 JPY/night paid in cash upon check-in) and selective temple garden entrance fees.\"\n      },\n      itinerary: [\n        {\n          day_number: 1,\n          day_theme: \"Sacred Torii Gates & Historic Gion Alleys\",\n          geographical_focus: \"Southern Higashiyama & Fushimi\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Fushimi Inari-Taisha Dawn Ascent\",\n              estimated_duration_hours: 2.5,\n              description: \"Hike beneath thousands of vermilion torii gates winding through Mount Inari. Beat the daytime tour groups by arriving before 7:30 AM.\",\n              cost_tier: \"Free\",\n              insider_tip: \"Continue past the Yotsutsuji intersection halfway up for unobstructed photo angles and sweeping city vistas.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Kiyomizu-dera & Sannenzaka Stone Streets\",\n              estimated_duration_hours: 3.0,\n              description: \"Explore the wooden stage hanging without nails over maple canopies, then descend through cobblestone preserved merchant lanes.\",\n              cost_tier: \"$\",\n              insider_tip: \"Sample fresh cinnamon yatsuhashi mochi samples offered by traditional confectioners along Ninenzaka.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Gion Shirakawa Twilight Stroll & Obanzai Dinner\",\n              estimated_duration_hours: 2.5,\n              description: \"Wander the willow-lined canal lanterns in the geiko district before settling into a cozy Obanzai restaurant for seasonal Kyoto small plates.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Reserve counter seating at an authentic Obanzai bar along Pontocho Alley to watch chefs plate seasonal dashi-simmered vegetables.\"\n            }\n          ]\n        },\n        {\n          day_number: 2,\n          day_theme: \"Arashiyama Bamboo Groves & Sagano Heritage\",\n          geographical_focus: \"Western Kyoto (Arashiyama)\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Tenryu-ji Zen Garden & Bamboo Grove\",\n              estimated_duration_hours: 2.5,\n              description: \"Walk the 14th-century Sogenchi garden reflecting the surrounding mountains, entering the serene bamboo forest before the midday rush.\",\n              cost_tier: \"$\",\n              insider_tip: \"Exit the bamboo forest toward Okochi Sanso Villa to escape crowds and enjoy included matcha and sweet cake.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Iwatayama Monkey Park & Togetsukyo Bridge\",\n              estimated_duration_hours: 2.0,\n              description: \"Cross the historic wooden bridge and take a gentle 20-minute scenic hike up to the wild macaque sanctuary overlooking the Oi River.\",\n              cost_tier: \"$\",\n              insider_tip: \"Wear comfortable walking shoes; the uphill gravel path is shaded but steady.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Yudofu (Silken Tofu) Hotpot Feast\",\n              estimated_duration_hours: 2.0,\n              description: \"Savor centuries-old Buddhist Shojin Ryori and hotpot tofu served with ginger, green onions, and savory bonito or kelp broth.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Look for garden courtyard dining near the riverbank for illuminated bamboo views while dining.\"\n            }\n          ]\n        },\n        {\n          day_number: 3,\n          day_theme: \"Golden Pavilion, Zen Rock Garden & Nishiki Market\",\n          geographical_focus: \"Northern Kyoto & Downtown Karasuma\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Kinkaku-ji (Golden Pavilion) & Ryoan-ji\",\n              estimated_duration_hours: 2.5,\n              description: \"Marvel at the top two floors covered in pure gold leaf shimmering over Mirror Pond, then meditate beside the 15 mysterious stones of Ryoan-ji.\",\n              cost_tier: \"$\",\n              insider_tip: \"Visit right at 9:00 AM opening for calm reflections before bus groups arrive.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Nishiki Market Street Food Safari\",\n              estimated_duration_hours: 2.5,\n              description: \"Traverse Kyoto\'s 400-year-old kitchen sampling octopus skewers, grilled dashi tamagoyaki, matcha soft serve, and soy milk donuts.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Eat in front of the stall where you buy; walking while eating is considered impolite in Japan.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Kamogawa Riverbank Sunset & Craft Beer\",\n              estimated_duration_hours: 2.0,\n              description: \"Join locals sitting along the cool riverbank stones (Kamo River) or dine on seasonal Kawayuka wooden platforms above the water.\",\n              cost_tier: \"$\",\n              insider_tip: \"During May to September, book a Kawayuka river terrace table in advance for open-air dining.\"\n            }\n          ]\n        },\n        {\n          day_number: 4,\n          day_theme: \"Philosopher\'s Path, Silver Pavilion & Uji Green Tea\",\n          geographical_focus: \"Northern Higashiyama & Uji Foothills\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Ginkaku-ji & The Philosopher\'s Path\",\n              estimated_duration_hours: 2.5,\n              description: \"Stroll the stone path alongside a cherry-tree canal honoring philosopher Nishida Kitaro, ending at Nanzen-ji\'s brick aqueduct.\",\n              cost_tier: \"$\",\n              insider_tip: \"Stop at Honen-in along the path, a secluded moss-covered gate temple free of tourist congestion.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Traditional Chanoyu Tea Ceremony Experience\",\n              estimated_duration_hours: 2.0,\n              description: \"Participate in a mindful tea ceremony guided by a licensed master, learning the philosophy of ichi-go ichi-e (one time, one meeting).\",\n              cost_tier: \"$$\",\n              insider_tip: \"Wear clean socks or bring white tabi socks as shoes must be removed on tatami mats.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Farewell Kaiseki Banquet in Pontoch\305\215\",\n              estimated_duration_hours: 2.5,\n              description: \"Conclude your journey with an exquisite multi-course Kaiseki dinner highlighting seasonal Kyoto heirloom vegetables and fresh sashimi.\",\n              cost_tier: \"$$$\",\n              insider_tip: \"Kaiseki menus change monthly based on lunar solar terms; ask your host for the translated menu scroll.\"\n            }\n          ]\n        }\n      ],\n      local_logistics_guide: {\n        best_transit_method: \"Combine Kyoto City Subway with IC Card (ICOCA/Suica) and express Kyoto City Bus lines. Rent electric bikes for Arashiyama.\",\n        cultural_etiquette_alerts: [\n          \"Do not photograph Geiko or Maiko on private streets in Gion; strict local signage fines apply.\",\n          \"Keep voice volume low on public transit and silence mobile ringers.\",\n          \"Tipping is NOT customary anywhere in Japan and may cause confusion.\",\n          \"Carry a small bag for your trash as public bins are rare across Kyoto.\"\n        ],\n        packing_essentials: [\n          \"Easy slip-on walking shoes (temples require frequent shoe removal)\",\n          \"Small coin pouch for cash-only temple admission booths and market vendors\",\n          \"Modest shoulders-and-knees attire for temple sanctuaries\",\n          \"Compact umbrella or UV sun parasol\"\n        ]\n      }\n    }\n  },\n  {\n    label: \'Paris Art, Historic Quarters & Gastronomy\',\n    description: \'3-day curated Parisian journey balancing iconic museums, bohemian quarters, and boulangerie hopping.\',\n    inputs: {\n      destination: \'Paris, France\',\n      duration: 3,\n      travelers: \'Solo Traveler\',\n      budget: \'Moderate ($200/day)\',\n      pace: \'Balanced\',\n      interests: \'Art museums, historic architecture, specialty bakeries, vintage flea markets\',\n      constraints: \'Avoid overly touristy restaurants, museum pass optimization\'\n    },\n    data: {\n      trip_summary: {\n        destination: \"Paris, France\",\n        total_days: 3,\n        theme_vibe: \"Bohemian Artistry, Fl\303\242neur Strolls & Butter-Laden Haute Gastronomy\",\n        budget_strategy: \"Optimized with Paris Museum Pass combined with bakery-style lunches and handpicked neighborhood bistros.\"\n      },\n      estimated_costs: {\n        currency: \"EUR\",\n        activities_per_day: 40,\n        food_per_day: 65,\n        hidden_fees_notes: \"City tourist tax (taxe de s\303\251jour \342\202\2545\342\200\2238/night) and mandatory timed-entry reservation slots for the Louvre and Mus\303\251e d\'Orsay.\"\n      },\n      itinerary: [\n        {\n          day_number: 1,\n          day_theme: \"The Seine, \303\216le de la Cit\303\251 & Saint-Germain Literary Cafes\",\n          geographical_focus: \"1st, 4th, and 6th Arrondissements\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Sainte-Chapelle & Notre-Dame Forecourt\",\n              estimated_duration_hours: 2.5,\n              description: \"Gaze at 1,113 stained glass panels in the 13th-century royal chapel, then walk across the bridge to Notre-Dame cathedral and Shakespeare & Company.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Book the very first Sainte-Chapelle 9:00 AM slot on a sunny morning when light floods the upper sanctuary.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Mus\303\251e d\'Orsay Masterpieces & Tuileries Garden\",\n              estimated_duration_hours: 3.0,\n              description: \"Marvel at Monet, Van Gogh, and Degas inside the converted Beaux-Arts railway station, then relax with an espresso in the Tuileries green chairs.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Visit the 5th-floor clock face cafe for a silhouette photo framing Sacr\303\251-C\305\223ur across the city.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Le Marais Hidden Courtyards & Traditional Bistro\",\n              estimated_duration_hours: 2.5,\n              description: \"Stroll Place des Vosges and cobblestone alleys before savoring steak frites or duck confit at an authentic Marais zinc-bar bistro.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Order the \'formule du soir\' (set menu) at neighborhood spots for the best seasonal value.\"\n            }\n          ]\n        },\n        {\n          day_number: 2,\n          day_theme: \"Montmartre Bohemian Heights & Canal Saint-Martin\",\n          geographical_focus: \"18th & 10th Arrondissements\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Sacr\303\251-C\305\223ur Dome & Secret Montmartre Vineyards\",\n              estimated_duration_hours: 2.5,\n              description: \"Climb the dome steps for panoramic rooftop views, then escape the Place du Tertre portrait painters by wandering Rue de l\'Abreuvoir and Clos Montmartre vineyard.\",\n              cost_tier: \"$\",\n              insider_tip: \"Take the side staircase from Rue Cortot to see Mus\303\251e de Montmartre and Renoir\'s former garden studio.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Canal Saint-Martin Bakery Hop & Iron Bridges\",\n              estimated_duration_hours: 3.0,\n              description: \"Pick up award-winning sourdough pain des amis from Du Pain et des Id\303\251es, enjoying pastries beside the vintage canal locks and indie concept boutiques.\",\n              cost_tier: \"$\",\n              insider_tip: \"Try the \'Escargot Pistache Chocolat\' pastry; it sells out by mid-afternoon.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Seine Sunset Cruise & Natural Wine Bar\",\n              estimated_duration_hours: 2.5,\n              description: \"Board an open-air Vedettes du Pont Neuf boat at dusk as the Eiffel Tower begins its hourly sparkle, followed by natural wine and small plates in Belleville.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Buy Vedettes du Pont Neuf tickets online for an open-time discount barcode.\"\n            }\n          ]\n        },\n        {\n          day_number: 3,\n          day_theme: \"Louvre Sculptures, Palais Royal & Left Bank Flea Hunting\",\n          geographical_focus: \"1st & 7th Arrondissements\",\n          schedule: [\n            {\n              time_slot: \"Morning\",\n              activity_name: \"Targeted Louvre Masterpieces Tour\",\n              estimated_duration_hours: 3.0,\n              description: \"Focus on the Richelieu Wing French sculptures, Winged Victory of Samothrace, and Napoleon III apartments to avoid museum exhaustion.\",\n              cost_tier: \"$$\",\n              insider_tip: \"Enter via the Carrousel du Louvre underground mall or Porte des Lions to bypass the glass pyramid queue.\"\n            },\n            {\n              time_slot: \"Afternoon\",\n              activity_name: \"Palais-Royal Colonnes de Buren & Covered Passages\",\n              estimated_duration_hours: 2.5,\n              description: \"Walk between Daniel Buren\'s striped black-and-white art columns and explore 19th-century glass-roofed arcades (Galerie Vivienne).\",\n              cost_tier: \"Free\",\n              insider_tip: \"Galerie Vivienne houses antiquarian bookshops and cozy tea salons tucked away from street traffic.\"\n            },\n            {\n              time_slot: \"Evening\",\n              activity_name: \"Champ de Mars Night Glow & Classic Brasserie Dinner\",\n              estimated_duration_hours: 2.5,\n              description: \"Picnic with artisan cheeses, fresh baguette, and berries on the lawn near the Eiffel Tower, wrapping up with classic French onion soup.\",\n              cost_tier: \"$$\",\n              insider_tip: \"The tower sparkles for exactly five minutes at the beginning of every hour after dusk until 1:00 AM.\"\n            }\n          ]\n        }\n      ],\n      local_logistics_guide: {\n        best_transit_method: \"Paris M\303\251tro via Navigo Easy contactless pass on your smartphone or physical card (single trips or 10-ticket carnet).\",\n        cultural_etiquette_alerts: [\n          \"Always say \'Bonjour Madame/Monsieur\' immediately upon entering any shop or cafe before asking a question.\",\n          \"Keep your M\303\251tro ticket or scanned pass until you have completely exited the station (inspectors check exits).\",\n          \"Service is included in bills (service compris); leaving 5\342\200\22310% extra is appreciated for attentive service but optional.\"\n        ],\n        packing_essentials: [\n          \"Supportive, broken-in walking sneakers for cobblestones and historic staircases\",\n          \"Crossbody anti-theft daypack for metro travel\",\n          \"Reusable tote bag for bakery and market purchases\",\n          \"EU Type C/E plug adapter and power bank\"\n        ]\n      }\n    }\n  }\n];\n"
    }
