  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  PlannerInputs,\n  ItineraryPlanResponse,\n  ActivityItem,\n} from \'./types\';\nimport { SAMPLE_PRESETS } from \'./sampleData\';\nimport { Navbar } from \'./components/Navbar\';\nimport { PlannerForm } from \'./components/PlannerForm\';\nimport { ItineraryView } from \'./components/ItineraryView\';\nimport { JsonModal } from \'./components/JsonModal\';\nimport { ActivitySwapModal } from \'./components/ActivitySwapModal\';\nimport { AlertCircle, Sparkles } from \'lucide-react\';\n\nexport default function App() {\n  const [inputs, setInputs] = useState<PlannerInputs>({\n    destination: \'Kyoto, Japan\',\n    duration: 4,\n    travelers: \'Couple\',\n    budget: \'Moderate ($120-220/day)\',\n    pace: \'Balanced\',\n    interests: \'Historic Sites, Street Food & Markets, Art & Museums, Architecture\',\n    constraints: \'Vegetarian-friendly lunch options, Avoid tourist crowds\',\n  });\n\n  const [itineraryData, setItineraryData] = useState<ItineraryPlanResponse | null>(\n    SAMPLE_PRESETS[0].data\n  );\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  // Completed checklist items\n  const [completedActivities, setCompletedActivities] = useState<\n    Record<string, boolean>\n  >({});\n\n  // JSON schema modal\n  const [isJsonModalOpen, setIsJsonModalOpen] = useState<boolean>(false);\n\n  // Swap activity modal state\n  const [swapModalState, setSwapModalState] = useState<{\n    isOpen: boolean;\n    dayNumber: number;\n    dayTheme: string;\n    geographicalFocus: string;\n    activityIndex: number;\n    currentActivity: ActivityItem | null;\n  }>({\n    isOpen: false,\n    dayNumber: 1,\n    dayTheme: \'\',\n    geographicalFocus: \'\',\n    activityIndex: 0,\n    currentActivity: null,\n  });\n\n  // Switch between form and results view\n  const [viewMode, setViewMode] = useState<\'form\' | \'results\'>(\'results\');\n\n  const handleSelectPreset = (index: number) => {\n    const preset = SAMPLE_PRESETS[index];\n    if (preset) {\n      setInputs(preset.inputs);\n      setItineraryData(preset.data);\n      setCompletedActivities({});\n      setViewMode(\'results\');\n      setErrorMessage(null);\n    }\n  };\n\n  const handleGenerateItinerary = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoading(true);\n    setErrorMessage(null);\n\n    try {\n      const response = await fetch(\'/api/plan-itinerary\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(inputs),\n      });\n\n      const resJson = await response.json();\n      if (resJson.success && resJson.data) {\n        setItineraryData(resJson.data);\n        setCompletedActivities({});\n        setViewMode(\'results\');\n      } else {\n        throw new Error(resJson.error || \'Failed to generate itinerary.\');\n      }\n    } catch (err: any) {\n      console.error(\'Generation error:\', err);\n      // If API fails or backend error, provide meaningful message and allow graceful fallback\n      setErrorMessage(\n        err.message ||\n          \'Could not reach AI engine. Ensure your GEMINI_API_KEY is configured or choose a preset.\'\n      );\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleToggleActivity = (activityId: string) => {\n    setCompletedActivities((prev) => ({\n      ...prev,\n      [activityId]: !prev[activityId],\n    }));\n  };\n\n  const handleOpenSwapModal = (\n    dayNumber: number,\n    activityIndex: number,\n    activity: ActivityItem\n  ) => {\n    const day = itineraryData?.itinerary.find((d) => d.day_number === dayNumber);\n    setSwapModalState({\n      isOpen: true,\n      dayNumber,\n      dayTheme: day?.day_theme || \'\',\n      geographicalFocus: day?.geographical_focus || \'\',\n      activityIndex,\n      currentActivity: activity,\n    });\n  };\n\n  const handleActivitySwapped = (\n    dayNumber: number,\n    activityIndex: number,\n    newActivity: ActivityItem\n  ) => {\n    if (!itineraryData) return;\n\n    const updatedItinerary = itineraryData.itinerary.map((day) => {\n      if (day.day_number === dayNumber) {\n        const updatedSchedule = [...day.schedule];\n        updatedSchedule[activityIndex] = newActivity;\n        return { ...day, schedule: updatedSchedule };\n      }\n      return day;\n    });\n\n    setItineraryData({\n      ...itineraryData,\n      itinerary: updatedItinerary,\n    });\n  };\n\n  const handleResetToForm = () => {\n    setViewMode(\'form\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-stone-100/70 text-stone-900 selection:bg-amber-200\">\n      {/* Navigation bar */}\n      <Navbar\n        onReset={handleResetToForm}\n        onOpenJsonModal={() => setIsJsonModalOpen(true)}\n        hasItinerary={Boolean(itineraryData)}\n      />\n\n      {/* Main Container */}\n      <main className=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\">\n        {/* Error notification banner */}\n        {errorMessage && (\n          <div className=\"mb-6 mx-auto max-w-4xl flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 shadow-xs\">\n            <AlertCircle className=\"mt-0.5 h-5 w-5 shrink-0 text-red-600\" />\n            <div className=\"flex-1\">\n              <p className=\"font-semibold\">Generation Notice</p>\n              <p className=\"text-xs text-red-700\">{errorMessage}</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setErrorMessage(null)}\n              className=\"text-xs font-bold text-red-800 underline hover:no-underline\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {/* View switching */}\n        {viewMode === \'form\' || !itineraryData ? (\n          <PlannerForm\n            inputs={inputs}\n            onChange={setInputs}\n            onSubmit={handleGenerateItinerary}\n            isLoading={isLoading}\n            onSelectPreset={handleSelectPreset}\n          />\n        ) : (\n          <ItineraryView\n            itineraryData={itineraryData}\n            inputs={inputs}\n            completedActivities={completedActivities}\n            onToggleActivity={handleToggleActivity}\n            onSwapActivity={handleOpenSwapModal}\n            onOpenJsonModal={() => setIsJsonModalOpen(true)}\n            onModifyInputs={() => setViewMode(\'form\')}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"mt-16 border-t border-stone-200 bg-stone-50 py-8 text-center text-xs text-stone-500\">\n        <div className=\"mx-auto max-w-7xl px-4\">\n          <p className=\"font-medium text-stone-700\">\n            Smart Itinerary Planner Engine \342\200\242 Powered by Gemini AI\n          </p>\n          <p className=\"mt-1 text-stone-400\">\n            Enforcing geographic realism, buffer timing integrity, variety thresholds & neighborhood clustering.\n          </p>\n        </div>\n      </footer>\n\n      {/* Modals */}\n      <JsonModal\n        isOpen={isJsonModalOpen}\n        onClose={() => setIsJsonModalOpen(false)}\n        data={itineraryData}\n      />\n\n      <ActivitySwapModal\n        isOpen={swapModalState.isOpen}\n        onClose={() => setSwapModalState((prev) => ({ ...prev, isOpen: false }))}\n        dayNumber={swapModalState.dayNumber}\n        dayTheme={swapModalState.dayTheme}\n        geographicalFocus={swapModalState.geographicalFocus}\n        activityIndex={swapModalState.activityIndex}\n        currentActivity={swapModalState.currentActivity}\n        destination={inputs.destination}\n        budget={inputs.budget}\n        onActivitySwapped={handleActivitySwapped}\n      />\n    </div>\n  );\n}\n"
    }
