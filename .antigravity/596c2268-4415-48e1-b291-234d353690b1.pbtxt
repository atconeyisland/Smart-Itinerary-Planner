    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Compass, RotateCcw, Printer, Type } from \'lucide-react\';\n\ninterface NavbarProps {\n  onReset: () => void;\n  hasItinerary: boolean;\n  onPrint?: () => void;\n  isLargeText: boolean;\n  onToggleLargeText: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  onReset,\n  hasItinerary,\n  onPrint,\n  isLargeText,\n  onToggleLargeText,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b border-stone-200 bg-white/95 backdrop-blur-md shadow-xs print:hidden\">\n      <div className=\"mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6\">\n        {/* Brand */}\n        <div\n          onClick={hasItinerary ? onReset : undefined}\n          className={`flex items-center gap-3 ${hasItinerary ? \'cursor-pointer\' : \'\'}`}\n        >\n          <div className=\"flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-500 text-white shadow-xs\">\n            <Compass className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-lg font-bold tracking-tight text-stone-900 sm:text-xl\">\n                Travel Planner\n              </h1>\n              <span className=\"hidden sm:inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200\">\n                INR (\342\202\271) Edition\n              </span>\n            </div>\n            <p className=\"text-xs text-stone-500 hidden sm:block\">\n              Easy, comfortable & accessible travel itineraries for everyone\n            </p>\n          </div>\n        </div>\n\n        {/* Actions */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Senior & Accessibility friendly font size toggle */}\n          <button\n            type=\"button\"\n            onClick={onToggleLargeText}\n            className={`inline-flex items-center gap-1.5 rounded-xl border px-3 py-2 text-xs font-medium transition ${\n              isLargeText\n                ? \'border-amber-400 bg-amber-50 text-amber-900 font-semibold\'\n                : \'border-stone-200 bg-stone-50 text-stone-700 hover:bg-stone-100\'\n            }`}\n            title=\"Toggle larger, senior-friendly text for easier reading\"\n          >\n            <Type className=\"h-4 w-4 text-amber-600\" />\n            <span className=\"hidden xs:inline\">{isLargeText ? \'Standard Text\' : \'Larger Text (A+)\'}</span>\n          </button>\n\n          {hasItinerary && onPrint && (\n            <button\n              type=\"button\"\n              onClick={onPrint}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-xs font-semibold text-stone-800 shadow-xs transition hover:bg-stone-50 active:scale-98\"\n            >\n              <Printer className=\"h-4 w-4 text-stone-600\" />\n              <span>Print / Save PDF</span>\n            </button>\n          )}\n\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 rounded-xl bg-amber-500 px-4 py-2 text-xs font-semibold text-white shadow-xs transition hover:bg-amber-600 active:scale-98\"\n            >\n              <RotateCcw className=\"h-4 w-4\" />\n              <span>Plan New Trip</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
