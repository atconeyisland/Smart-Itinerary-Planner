  file_change {
    absolute_path_uri: "file:///src/components/ItineraryView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Calendar,\n  Building2,\n  UtensilsCrossed,\n  Languages,\n  Compass,\n  Sparkles,\n  Printer,\n  ChevronRight,\n} from \'lucide-react\';\nimport { ItineraryPlanResponse, ActivityItem } from \'../types\';\nimport { TripSummaryHeader } from \'./TripSummaryHeader\';\nimport { DayScheduleCard } from \'./DayScheduleCard\';\nimport { CostBreakdownCard } from \'./CostBreakdownCard\';\nimport { LogisticsGuideCard } from \'./LogisticsGuideCard\';\nimport { HotelSection } from \'./HotelSection\';\nimport { RestaurantSection } from \'./RestaurantSection\';\nimport { SurvivalPhrasesSection } from \'./SurvivalPhrasesSection\';\nimport { FunFactsSection } from \'./FunFactsSection\';\n\ninterface ItineraryViewProps {\n  plan: ItineraryPlanResponse;\n  completedActivities: Record<string, boolean>;\n  onToggleComplete: (activityKey: string) => void;\n  onOpenSwapModal: (dayNumber: number, activity: ActivityItem, geoFocus: string) => void;\n  onPrintPdf: () => void;\n  isLargeText: boolean;\n}\n\ntype TabType = \'schedule\' | \'hotels\' | \'restaurants\' | \'phrases\' | \'logistics\';\n\nexport const ItineraryView: React.FC<ItineraryViewProps> = ({\n  plan,\n  completedActivities,\n  onToggleComplete,\n  onOpenSwapModal,\n  onPrintPdf,\n  isLargeText,\n}) => {\n  const [activeTab, setActiveTab] = useState<TabType>(\'schedule\');\n  const [selectedDayFilter, setSelectedDayFilter] = useState<number | \'all\'>(\'all\');\n\n  const filteredDays =\n    selectedDayFilter === \'all\'\n      ? plan.itinerary\n      : plan.itinerary.filter((d) => d.day_number === selectedDayFilter);\n\n  const tabs = [\n    {\n      id: \'schedule\' as TabType,\n      label: \'Day-by-Day Plan\',\n      icon: Calendar,\n      count: plan.itinerary.length ? `${plan.itinerary.length} Days` : undefined,\n    },\n    {\n      id: \'hotels\' as TabType,\n      label: \'Hotels & Stays\',\n      icon: Building2,\n      count: plan.hotel_recommendations?.length ? `${plan.hotel_recommendations.length} Options` : undefined,\n    },\n    {\n      id: \'restaurants\' as TabType,\n      label: \'Food & Dining\',\n      icon: UtensilsCrossed,\n      count: plan.restaurant_recommendations?.length ? `${plan.restaurant_recommendations.length} Spots` : undefined,\n    },\n    {\n      id: \'phrases\' as TabType,\n      label: \'Local Phrases & Survival\',\n      icon: Languages,\n      count: plan.local_phrases?.length ? `${plan.local_phrases.length} Phrases` : undefined,\n    },\n    {\n      id: \'logistics\' as TabType,\n      label: \'Tips & Logistics\',\n      icon: Compass,\n    },\n  ];\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Hero Header */}\n      <TripSummaryHeader\n        summary={plan.trip_summary}\n        estimatedCosts={plan.estimated_costs}\n        onPrintPdf={onPrintPdf}\n        isLargeText={isLargeText}\n      />\n\n      {/* Main Tab Navigation Bar */}\n      <div className=\"print:hidden border-b border-stone-200 bg-white rounded-2xl p-1.5 shadow-xs\">\n        <nav className=\"flex flex-wrap items-center gap-1.5\" aria-label=\"Tabs\">\n          {tabs.map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                type=\"button\"\n                onClick={() => setActiveTab(tab.id)}\n                className={`flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs sm:text-sm font-bold transition ${\n                  isActive\n                    ? \'bg-amber-500 text-white shadow-xs\'\n                    : \'text-stone-600 hover:bg-stone-100 hover:text-stone-900\'\n                }`}\n              >\n                <Icon className=\"h-4 w-4 shrink-0\" />\n                <span>{tab.label}</span>\n                {tab.count && (\n                  <span\n                    className={`rounded-md px-1.5 py-0.5 text-[11px] font-semibold ${\n                      isActive\n                        ? \'bg-amber-600 text-white\'\n                        : \'bg-stone-100 text-stone-600\'\n                    }`}\n                  >\n                    {tab.count}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Tab 1: Day-by-Day Schedule */}\n      {activeTab === \'schedule\' && (\n        <div className=\"space-y-8\">\n          {/* Day Selector Pill Filter */}\n          <div className=\"print:hidden flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-4 shadow-2xs\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-stone-400\">\n                Filter by Day:\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => setSelectedDayFilter(\'all\')}\n                  className={`rounded-xl px-3.5 py-1.5 text-xs font-bold transition ${\n                    selectedDayFilter === \'all\'\n                      ? \'bg-stone-900 text-white shadow-xs\'\n                      : \'bg-stone-100 text-stone-600 hover:bg-stone-200\'\n                  }`}\n                >\n                  All Days ({plan.itinerary.length})\n                </button>\n                {plan.itinerary.map((d) => (\n                  <button\n                    key={d.day_number}\n                    type=\"button\"\n                    onClick={() => setSelectedDayFilter(d.day_number)}\n                    className={`rounded-xl px-3.5 py-1.5 text-xs font-bold transition ${\n                      selectedDayFilter === d.day_number\n                        ? \'bg-amber-500 text-white shadow-xs\'\n                        : \'bg-stone-100 text-stone-600 hover:bg-stone-200\'\n                    }`}\n                  >\n                    Day {d.day_number}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"text-xs text-stone-500 hidden sm:block\">\n              Click activity checkboxes to mark visited places\n            </div>\n          </div>\n\n          {/* Day Cards */}\n          <div className=\"space-y-6\">\n            {filteredDays.map((day) => (\n              <DayScheduleCard\n                key={day.day_number}\n                day={day}\n                destination={plan.trip_summary.destination}\n                completedActivities={completedActivities}\n                onToggleComplete={onToggleComplete}\n                onOpenSwapModal={onOpenSwapModal}\n                isLargeText={isLargeText}\n              />\n            ))}\n          </div>\n\n          {/* Cost Breakdown in INR */}\n          <CostBreakdownCard\n            costs={plan.estimated_costs}\n            totalDays={plan.trip_summary.total_days}\n            isLargeText={isLargeText}\n          />\n\n          {/* Researched Fun Facts & Trivia */}\n          <FunFactsSection\n            funFacts={plan.fun_facts}\n            destination={plan.trip_summary.destination}\n            isLargeText={isLargeText}\n          />\n        </div>\n      )}\n\n      {/* Tab 2: Hotels & Stays */}\n      {activeTab === \'hotels\' && (\n        <HotelSection\n          hotels={plan.hotel_recommendations}\n          destination={plan.trip_summary.destination}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 3: Food & Dining */}\n      {activeTab === \'restaurants\' && (\n        <RestaurantSection\n          restaurants={plan.restaurant_recommendations}\n          destination={plan.trip_summary.destination}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 4: Survival Phrases & Local Dialect */}\n      {activeTab === \'phrases\' && (\n        <SurvivalPhrasesSection\n          phrases={plan.local_phrases}\n          destination={plan.trip_summary.destination}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 5: Tips & Logistics */}\n      {activeTab === \'logistics\' && (\n        <LogisticsGuideCard\n          guide={plan.local_logistics_guide}\n          isLargeText={isLargeText}\n        />\n      )}\n    </div>\n  );\n};\n"
    }
