        }
        lines {
          text: "          title: \"There Are No \'Stop\' Signs in Paris\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"Paris has zero stop signs in the entire city. The rule is \'priorit\303\251 \303\240 droite\' (priority to the right) at all non-signalized intersections.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          tag: \"Trivia\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
