    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { Building2, Check, MapPin, HeartHandshake, ExternalLink, Navigation, Sparkles } from \'lucide-react\';\nimport { HotelRecommendation } from \'../types\';\nimport { getHotelPhoto } from \'../utils/imageService\';\nimport { formatPrice } from \'../utils/currencyUtils\';\nimport { generatePlaceGoogleMapsUrl } from \'../utils/mapExportUtils\';\n\ninterface HotelSectionProps {\n  hotels?: HotelRecommendation[];\n  destination: string;\n  currency?: string;\n  isLargeText: boolean;\n}\n\nexport const HotelSection: React.FC<HotelSectionProps> = ({\n  hotels,\n  destination,\n  currency = \'USD\',\n  isLargeText,\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n\n  const categories = useMemo(() => {\n    if (!hotels) return [];\n    const set = new Set<string>();\n    hotels.forEach((h) => {\n      if (h.category) set.add(h.category);\n    });\n    return Array.from(set);\n  }, [hotels]);\n\n  const filteredHotels = useMemo(() => {\n    if (!hotels) return [];\n    if (selectedCategory === \'all\') return hotels;\n    return hotels.filter((h) => h.category.toLowerCase().includes(selectedCategory.toLowerCase()));\n  }, [hotels, selectedCategory]);\n\n  if (!hotels || hotels.length === 0) {\n    return (\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-8 text-center shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <Building2 className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-black text-[#1A1A1A]\">Hotel Recommendations</h3>\n        <p className=\"mt-1 text-sm font-medium text-stone-500\">\n          No hotel recommendations were included in this itinerary generation.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-black\' : \'text-lg sm:text-xl font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  const googleHotelsSearchUrl = `https://www.google.com/travel/hotels/${encodeURIComponent(\n    destination\n  )}`;\n\n  return (\n    <div className=\"space-y-6\" id=\"hotel-recommendations-section\">\n      {/* Header Info Banner */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A] bg-[#FAF9F5]\">\n        <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#8B5CF6] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                <Building2 className=\"h-5 w-5\" />\n              </span>\n              <h2 className={`${titleSize} text-[#1A1A1A]`}>\n                Recommended Stays in {destination.split(\',\')[0]} ({hotels.length} Curated Options)\n              </h2>\n            </div>\n            <p className={`mt-1 font-medium text-[#4A5568] ${bodySize}`}>\n              Curated accommodations across Luxury, Boutique, Mid-Range, and Budget categories with accessibility notes and neighborhood proximity.\n            </p>\n          </div>\n\n          <a\n            href={googleHotelsSearchUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-2 self-start sm:self-auto rounded-xl border-2 border-[#1A1A1A] bg-[#8B5CF6] px-3.5 py-2 text-xs font-black text-white shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n          >\n            <span>Search Live Prices on Google Hotels</span>\n            <ExternalLink className=\"h-3.5 w-3.5\" />\n          </a>\n        </div>\n\n        {/* Category Filters */}\n        {categories.length > 0 && (\n          <div className=\"mt-4 pt-4 border-t-2 border-[#1A1A1A] flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-bold text-[#718096] uppercase tracking-wider mr-1\">Filter Tier:</span>\n            <button\n              onClick={() => setSelectedCategory(\'all\')}\n              className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all ${\n                selectedCategory === \'all\'\n                  ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#8B5CF6]\'\n                  : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n              }`}\n            >\n              All Tiers ({hotels.length})\n            </button>\n            {categories.map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all ${\n                  selectedCategory === cat\n                    ? \'bg-[#8B5CF6] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                    : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Hotel Cards Grid (Responsive 1, 2, or 3 columns) */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3\">\n        {filteredHotels.map((hotel, idx) => {\n          const photoUrl = getHotelPhoto(hotel.category, hotel.name);\n          const isLuxury = hotel.category.toLowerCase().includes(\'luxury\') || hotel.category.toLowerCase().includes(\'palace\') || hotel.category.toLowerCase().includes(\'5-star\');\n          const isBoutique = hotel.category.toLowerCase().includes(\'boutique\') || hotel.category.toLowerCase().includes(\'heritage\');\n          const isBudget = hotel.category.toLowerCase().includes(\'budget\') || hotel.category.toLowerCase().includes(\'hostel\');\n\n          const price = hotel.approx_price_per_night || (hotel as any).approx_price_inr_per_night || 0;\n          const hotelCurrency = hotel.currency || currency;\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[4px_4px_0px_0px_#1A1A1A] transition hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#1A1A1A]\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden border-b-2 border-[#1A1A1A] bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={hotel.name}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-block rounded-xl border-2 border-[#1A1A1A] px-2.5 py-1 text-xs font-black shadow-[2px_2px_0px_0px_#1A1A1A] ${\n                      isLuxury\n                        ? \'bg-[#FEF3C7] text-[#92400E]\'\n                        : isBoutique\n                        ? \'bg-[#E0E7FF] text-[#4338CA]\'\n                        : isBudget\n                        ? \'bg-[#DCFCE7] text-[#166534]\'\n                        : \'bg-white text-[#1A1A1A]\'\n                    }`}\n                  >\n                    {hotel.category}\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl border-2 border-[#1A1A1A] bg-[#1A1A1A] px-3 py-1 text-xs font-black text-white shadow-[2px_2px_0px_0px_#FFFFFF]\">\n                  ~{formatPrice(price, hotelCurrency)} / night\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <h3 className={`font-black text-[#1A1A1A] ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                    {hotel.name}\n                  </h3>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-[#1A1A1A]\" />\n                    <span>{hotel.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Best For Badge */}\n                <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FAF9F5] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <div className=\"flex items-start gap-2\">\n                    <HeartHandshake className=\"mt-0.5 h-4 w-4 shrink-0 text-[#8B5CF6]\" />\n                    <div>\n                      <p className=\"text-[10px] font-black text-[#718096] uppercase tracking-wide\">\n                        Best Suited For\n                      </p>\n                      <p className={`font-bold text-[#1A1A1A] ${isLargeText ? \'text-sm\' : \'text-xs\'}`}>\n                        {hotel.best_for}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Highlights List */}\n                <div className=\"flex-1 space-y-1.5\">\n                  <p className=\"text-xs font-black text-stone-500 uppercase tracking-wider\">\n                    Key Highlights\n                  </p>\n                  <ul className=\"space-y-1.5\">\n                    {hotel.key_highlights?.map((highlight, hIdx) => (\n                      <li key={hIdx} className={`flex items-start gap-2 ${bodySize} font-medium text-stone-700`}>\n                        <Check className=\"mt-0.5 h-4 w-4 shrink-0 text-[#10B981]\" />\n                        <span>{highlight}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n\n                {/* Actions Footer */}\n                <div className=\"pt-3 border-t border-[#E2E8F0] flex items-center justify-between\">\n                  <a\n                    href={generatePlaceGoogleMapsUrl(hotel.name, destination, hotel.neighborhood)}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"inline-flex items-center gap-1.5 text-xs font-black text-[#8B5CF6] hover:underline\"\n                  >\n                    <Navigation className=\"w-3.5 h-3.5\" />\n                    <span>View on Maps</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </a>\n\n                  <a\n                    href={`https://www.google.com/travel/hotels?q=${encodeURIComponent(`${hotel.name}, ${destination}`)}`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"px-2.5 py-1 text-xs font-black bg-[#FAF9F5] hover:bg-[#E2E8F0] text-[#1A1A1A] border border-[#1A1A1A] rounded-lg\"\n                  >\n                    Check Rates \342\206\227\n                  </a>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
