  file_change {
    absolute_path_uri: "file:///src/components/CostBreakdownCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Wallet, Info, Sparkles, AlertCircle } from \'lucide-react\';\nimport { EstimatedCosts } from \'../types\';\n\ninterface CostBreakdownCardProps {\n  costs: EstimatedCosts;\n  totalDays: number;\n  isLargeText: boolean;\n}\n\nexport const CostBreakdownCard: React.FC<CostBreakdownCardProps> = ({\n  costs,\n  totalDays,\n  isLargeText,\n}) => {\n  const dailyTotal = (costs.activities_per_day || 0) + (costs.food_per_day || 0);\n  const tripTotal = dailyTotal * totalDays;\n\n  const titleSize = isLargeText ? \'text-xl font-bold\' : \'text-lg font-bold\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"overflow-hidden rounded-3xl border border-stone-200 bg-white p-6 shadow-xs space-y-5\">\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800\">\n            <Wallet className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className={`${titleSize} text-stone-900`}>Estimated Expense Breakdown</h3>\n            <p className=\"text-xs text-stone-500\">Excludes long-distance flights/trains & hotel</p>\n          </div>\n        </div>\n        <span className=\"rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-bold text-emerald-800 border border-emerald-200\">\n          INR (\342\202\271)\n        </span>\n      </div>\n\n      {/* Figures Grid */}\n      <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-3\">\n        {/* Daily Food */}\n        <div className=\"rounded-2xl border border-stone-100 bg-stone-50/70 p-4\">\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-stone-400\">\n            Meals & Dining / Day\n          </span>\n          <p className=\"mt-1 text-xl font-bold text-stone-900\">\n            \342\202\271{(costs.food_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs text-stone-500\">Per person daily average</p>\n        </div>\n\n        {/* Daily Activities */}\n        <div className=\"rounded-2xl border border-stone-100 bg-stone-50/70 p-4\">\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-stone-400\">\n            Sightseeing & Admissions / Day\n          </span>\n          <p className=\"mt-1 text-xl font-bold text-stone-900\">\n            \342\202\271{(costs.activities_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs text-stone-500\">Monuments, passes & tickets</p>\n        </div>\n\n        {/* Total Estimate */}\n        <div className=\"rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4\">\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-emerald-800\">\n            Total {totalDays}-Day Estimate\n          </span>\n          <p className=\"mt-1 text-xl font-bold text-emerald-900\">\n            \342\202\271{tripTotal.toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs text-emerald-700\">Daily avg \342\202\271{dailyTotal.toLocaleString(\'en-IN\')}</p>\n        </div>\n      </div>\n\n      {/* Hidden fees advisory */}\n      {costs.hidden_fees_notes && (\n        <div className=\"rounded-2xl border border-amber-200 bg-amber-50/60 p-4\">\n          <div className=\"flex items-start gap-2.5\">\n            <Info className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" />\n            <div>\n              <p className=\"text-xs font-bold text-amber-900 uppercase tracking-wider\">\n                Passes, Taxes & Local Advisory\n              </p>\n              <p className={`mt-0.5 text-stone-700 ${bodySize}`}>\n                {costs.hidden_fees_notes}\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
