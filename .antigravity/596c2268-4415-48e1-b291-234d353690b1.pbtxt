    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Languages, Volume2, HelpCircle, Check, Copy } from \'lucide-react\';\nimport { SurvivalPhrase } from \'../types\';\n\ninterface SurvivalPhrasesSectionProps {\n  phrases?: SurvivalPhrase[];\n  destination: string;\n  isLargeText: boolean;\n}\n\nexport const SurvivalPhrasesSection: React.FC<SurvivalPhrasesSectionProps> = ({\n  phrases,\n  destination,\n  isLargeText,\n}) => {\n  const [copiedIdx, setCopiedIdx] = useState<number | null>(null);\n\n  if (!phrases || phrases.length === 0) {\n    return (\n      <div className=\"rounded-3xl border border-stone-200 bg-white p-8 text-center\">\n        <Languages className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-bold text-stone-800\">Local Language & Phrases</h3>\n        <p className=\"mt-1 text-sm text-stone-500\">\n          No local phrases were generated for this itinerary.\n        </p>\n      </div>\n    );\n  }\n\n  const handleCopy = (text: string, idx: number) => {\n    navigator.clipboard.writeText(text);\n    setCopiedIdx(idx);\n    setTimeout(() => setCopiedIdx(null), 2000);\n  };\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-bold\' : \'text-lg sm:text-xl font-bold\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-xs\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-8 w-8 items-center justify-center rounded-xl bg-amber-100 text-amber-800\">\n                <Languages className=\"h-4 w-4\" />\n              </span>\n              <h2 className={`${titleSize} text-stone-900`}>\n                Local Dialect & Survival Phrases for {destination.split(\',\')[0]}\n              </h2>\n            </div>\n            <p className={`mt-1 text-stone-600 ${bodySize}`}>\n              Essential daily phrases for asking for safe water, vegetarian food, directions, bargaining, and emergency help with easy phonetic English pronunciation.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Phrases Grid */}\n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n        {phrases.map((item, idx) => {\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-5 shadow-xs transition hover:border-amber-300 hover:shadow-sm\"\n            >\n              <div>\n                {/* Category Badge & Copy button */}\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"rounded-md bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-700\">\n                    {item.category}\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleCopy(`${item.english_phrase} - ${item.phonetic_pronunciation} (${item.local_script})`, idx)}\n                    className=\"inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-stone-500 hover:bg-stone-100 hover:text-stone-800\"\n                    title=\"Copy phrase\"\n                  >\n                    {copiedIdx === idx ? (\n                      <>\n                        <Check className=\"h-3.5 w-3.5 text-emerald-600\" />\n                        <span className=\"text-emerald-600 font-semibold\">Copied!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"h-3.5 w-3.5\" />\n                        <span>Copy</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n\n                {/* English Phrase */}\n                <div className=\"mt-3\">\n                  <p className=\"text-xs font-semibold text-stone-400 uppercase tracking-wide\">\n                    English Meaning\n                  </p>\n                  <h3 className={`font-bold text-stone-900 ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                    \"{item.english_phrase}\"\n                  </h3>\n                </div>\n\n                {/* Phonetic Pronunciation & Local Script */}\n                <div className=\"mt-3 rounded-xl border border-amber-200 bg-amber-50/80 p-3\">\n                  <div className=\"flex items-start gap-2\">\n                    <Volume2 className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" />\n                    <div>\n                      <p className=\"text-xs font-bold text-amber-900 uppercase tracking-wider\">\n                        How to Say It (Phonetic)\n                      </p>\n                      <p className={`font-extrabold text-amber-950 ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                        {item.phonetic_pronunciation}\n                      </p>\n                      <p className=\"mt-1 text-xs font-medium text-stone-600\">\n                        Script: <span className=\"font-semibold text-stone-800\">{item.local_script}</span>\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Usage Tip */}\n              <div className=\"mt-3 flex items-start gap-2 border-t border-stone-100 pt-3 text-xs text-stone-500\">\n                <HelpCircle className=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-stone-400\" />\n                <p className={`${isLargeText ? \'text-sm\' : \'text-xs\'}`}>{item.usage_tip}</p>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
