    instruction: "Update ItineraryView to Bento Grid layout and styling"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport {\n  ItineraryPlanResponse,\n  PlannerInputs,\n  ActivityItem,\n} from \'../types\';\nimport { TripSummaryHeader } from \'./TripSummaryHeader\';\nimport { CostBreakdownCard } from \'./CostBreakdownCard\';\nimport { DayScheduleCard } from \'./DayScheduleCard\';\nimport { LogisticsGuideCard } from \'./LogisticsGuideCard\';\nimport { Sparkles, CalendarDays, SlidersHorizontal } from \'lucide-react\';\n\ninterface ItineraryViewProps {\n  itineraryData: ItineraryPlanResponse;\n  inputs: PlannerInputs;\n  completedActivities: Record<string, boolean>;\n  onToggleActivity: (activityId: string) => void;\n  onSwapActivity: (\n    dayNumber: number,\n    activityIndex: number,\n    activity: ActivityItem\n  ) => void;\n  onOpenJsonModal: () => void;\n  onModifyInputs: () => void;\n}\n\nexport const ItineraryView: React.FC<ItineraryViewProps> = ({\n  itineraryData,\n  inputs,\n  completedActivities,\n  onToggleActivity,\n  onSwapActivity,\n  onOpenJsonModal,\n  onModifyInputs,\n}) => {\n  const handleExportMarkdown = () => {\n    let md = `# Smart Travel Itinerary: ${itineraryData.trip_summary.destination}\\n\\n`;\n    md += `**Duration:** ${itineraryData.trip_summary.total_days} Days\\n`;\n    md += `**Theme & Vibe:** ${itineraryData.trip_summary.theme_vibe}\\n`;\n    md += `**Budget Strategy:** ${itineraryData.trip_summary.budget_strategy}\\n\\n`;\n    md += `## Estimated Costs\\n`;\n    md += `- Currency: ${itineraryData.estimated_costs.currency}\\n`;\n    md += `- Activities / Day: ${itineraryData.estimated_costs.currency} ${itineraryData.estimated_costs.activities_per_day}\\n`;\n    md += `- Food / Day: ${itineraryData.estimated_costs.currency} ${itineraryData.estimated_costs.food_per_day}\\n`;\n    md += `- Hidden Fees Notes: ${itineraryData.estimated_costs.hidden_fees_notes}\\n\\n`;\n    md += `## Day-by-Day Schedule\\n\\n`;\n\n    itineraryData.itinerary.forEach((day) => {\n      md += `### Day ${day.day_number}: ${day.day_theme}\\n`;\n      md += `*Geographical Focus: ${day.geographical_focus}*\\n\\n`;\n      day.schedule.forEach((act) => {\n        md += `#### [${act.time_slot}] ${act.activity_name} (${act.cost_tier}, ~${act.estimated_duration_hours}h)\\n`;\n        md += `${act.description}\\n\\n`;\n        if (act.insider_tip) {\n          md += `> **Insider Tip:** ${act.insider_tip}\\n\\n`;\n        }\n      });\n      md += `---\\n\\n`;\n    });\n\n    md += `## Local Logistics Guide\\n\\n`;\n    md += `**Best Transit Method:** ${itineraryData.local_logistics_guide.best_transit_method}\\n\\n`;\n    md += `### Cultural Etiquette Alerts\\n`;\n    itineraryData.local_logistics_guide.cultural_etiquette_alerts.forEach((c) => {\n      md += `- ${c}\\n`;\n    });\n    md += `\\n### Packing Essentials\\n`;\n    itineraryData.local_logistics_guide.packing_essentials.forEach((p) => {\n      md += `- ${p}\\n`;\n    });\n\n    const blob = new Blob([md], { type: \'text/markdown\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `itinerary-${itineraryData.trip_summary.destination.toLowerCase().replace(/[^a-z0-9]+/g, \'-\')}.md`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  return (\n    <div className=\"mx-auto max-w-5xl space-y-8\">\n      {/* Top Banner with Quick Modify button */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-stone-200/80 pb-2\">\n        <div className=\"flex items-center gap-2 text-xs font-semibold text-stone-600\">\n          <CalendarDays className=\"h-4 w-4 text-amber-700\" />\n          <span>Travelers: {inputs.travelers}</span>\n          <span className=\"text-stone-300\">\342\200\242</span>\n          <span>Pace: {inputs.pace}</span>\n          <span className=\"text-stone-300\">\342\200\242</span>\n          <span>Budget: {inputs.budget.split(\'(\')[0].trim()}</span>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onModifyInputs}\n          className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold text-stone-700 shadow-2xs transition hover:bg-stone-100\"\n        >\n          <SlidersHorizontal className=\"h-3.5 w-3.5 text-stone-500\" />\n          <span>Edit Parameters</span>\n        </button>\n      </div>\n\n      {/* Trip Summary Header */}\n      <TripSummaryHeader\n        summary={itineraryData.trip_summary}\n        costs={itineraryData.estimated_costs}\n        onOpenJsonModal={onOpenJsonModal}\n        onExportMarkdown={handleExportMarkdown}\n      />\n\n      {/* Cost Breakdown Card */}\n      <CostBreakdownCard\n        costs={itineraryData.estimated_costs}\n        totalDays={itineraryData.trip_summary.total_days}\n      />\n\n      {/* Day by Day Schedule Section */}\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-xl font-extrabold tracking-tight text-stone-900\">\n              Day-by-Day Geographically Clustered Schedule\n            </h2>\n            <p className=\"text-xs text-stone-500\">\n              Grouped by neighborhood with built-in transit buffers & variety limits\n            </p>\n          </div>\n          <span className=\"rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900\">\n            {itineraryData.itinerary.length} Days Generated\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-6\">\n          {itineraryData.itinerary.map((day) => (\n            <DayScheduleCard\n              key={day.day_number}\n              day={day}\n              destination={itineraryData.trip_summary.destination}\n              completedActivities={completedActivities}\n              onToggleActivity={onToggleActivity}\n              onSwapActivity={(dNum, aIdx, act) => onSwapActivity(dNum, aIdx, act)}\n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Local Logistics Guide */}\n      <LogisticsGuideCard guide={itineraryData.local_logistics_guide} />\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  ItineraryPlanResponse,\n  PlannerInputs,\n  ActivityItem,\n} from \'../types\';\nimport { TripSummaryHeader } from \'./TripSummaryHeader\';\nimport { CostBreakdownCard } from \'./CostBreakdownCard\';\nimport { DayScheduleCard } from \'./DayScheduleCard\';\nimport { LogisticsGuideCard } from \'./LogisticsGuideCard\';\nimport { SlidersHorizontal } from \'lucide-react\';\n\ninterface ItineraryViewProps {\n  itineraryData: ItineraryPlanResponse;\n  inputs: PlannerInputs;\n  completedActivities: Record<string, boolean>;\n  onToggleActivity: (activityId: string) => void;\n  onSwapActivity: (\n    dayNumber: number,\n    activityIndex: number,\n    activity: ActivityItem\n  ) => void;\n  onOpenJsonModal: () => void;\n  onModifyInputs: () => void;\n}\n\nexport const ItineraryView: React.FC<ItineraryViewProps> = ({\n  itineraryData,\n  inputs,\n  completedActivities,\n  onToggleActivity,\n  onSwapActivity,\n  onOpenJsonModal,\n  onModifyInputs,\n}) => {\n  const [selectedDayFilter, setSelectedDayFilter] = useState<number | \'all\'>(\'all\');\n\n  const handleExportMarkdown = () => {\n    let md = `# Smart Travel Itinerary: ${itineraryData.trip_summary.destination}\\n\\n`;\n    md += `**Duration:** ${itineraryData.trip_summary.total_days} Days\\n`;\n    md += `**Theme & Vibe:** ${itineraryData.trip_summary.theme_vibe}\\n`;\n    md += `**Budget Strategy:** ${itineraryData.trip_summary.budget_strategy}\\n\\n`;\n    md += `## Estimated Costs\\n`;\n    md += `- Currency: ${itineraryData.estimated_costs.currency}\\n`;\n    md += `- Activities / Day: ${itineraryData.estimated_costs.currency} ${itineraryData.estimated_costs.activities_per_day}\\n`;\n    md += `- Food / Day: ${itineraryData.estimated_costs.currency} ${itineraryData.estimated_costs.food_per_day}\\n`;\n    md += `- Hidden Fees Notes: ${itineraryData.estimated_costs.hidden_fees_notes}\\n\\n`;\n    md += `## Day-by-Day Schedule\\n\\n`;\n\n    itineraryData.itinerary.forEach((day) => {\n      md += `### Day ${day.day_number}: ${day.day_theme}\\n`;\n      md += `*Geographical Focus: ${day.geographical_focus}*\\n\\n`;\n      day.schedule.forEach((act) => {\n        md += `#### [${act.time_slot}] ${act.activity_name} (${act.cost_tier}, ~${act.estimated_duration_hours}h)\\n`;\n        md += `${act.description}\\n\\n`;\n        if (act.insider_tip) {\n          md += `> **Insider Tip:** ${act.insider_tip}\\n\\n`;\n        }\n      });\n      md += `---\\n\\n`;\n    });\n\n    md += `## Local Logistics Guide\\n\\n`;\n    md += `**Best Transit Method:** ${itineraryData.local_logistics_guide.best_transit_method}\\n\\n`;\n    md += `### Cultural Etiquette Alerts\\n`;\n    itineraryData.local_logistics_guide.cultural_etiquette_alerts.forEach((c) => {\n      md += `- ${c}\\n`;\n    });\n    md += `\\n### Packing Essentials\\n`;\n    itineraryData.local_logistics_guide.packing_essentials.forEach((p) => {\n      md += `- ${p}\\n`;\n    });\n\n    const blob = new Blob([md], { type: \'text/markdown\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `itinerary-${itineraryData.trip_summary.destination.toLowerCase().replace(/[^a-z0-9]+/g, \'-\')}.md`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const displayedDays =\n    selectedDayFilter === \'all\'\n      ? itineraryData.itinerary\n      : itineraryData.itinerary.filter((d) => d.day_number === selectedDayFilter);\n\n  return (\n    <div className=\"mx-auto max-w-7xl space-y-6\">\n      {/* Bento Top Header */}\n      <header className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2\">\n        <div>\n          <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-black tracking-tighter leading-none uppercase italic text-[#1A1A1A]\">\n            {itineraryData.trip_summary.destination}\n          </h1>\n          <p className=\"text-sm sm:text-base font-bold opacity-60 tracking-tight mt-1.5 underline decoration-2 underline-offset-4 text-[#1A1A1A]\">\n            {itineraryData.trip_summary.total_days}-Day Smart Itinerary / {inputs.travelers} / {inputs.budget.split(\'(\')[0].trim()}\n          </p>\n        </div>\n\n        {/* Bento Metric Pills */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"border-2 border-[#1A1A1A] bg-white px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] text-[#1A1A1A]\">\n            <span className=\"text-[10px] font-black block opacity-50 uppercase tracking-wider\">Tempo</span>\n            <span className=\"text-sm sm:text-base font-black\">{inputs.pace}</span>\n          </div>\n\n          <div className=\"border-2 border-[#1A1A1A] bg-[#C5E876] px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] text-[#1A1A1A]\">\n            <span className=\"text-[10px] font-black block opacity-50 uppercase tracking-wider\">Status</span>\n            <span className=\"text-sm sm:text-base font-black italic\">Optimized</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onModifyInputs}\n            className=\"inline-flex items-center gap-1.5 border-2 border-[#1A1A1A] bg-white hover:bg-[#89CFF0] px-3.5 py-2.5 rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] text-xs font-black uppercase text-[#1A1A1A] transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0px_0px_#1A1A1A]\"\n          >\n            <SlidersHorizontal className=\"h-3.5 w-3.5\" />\n            <span>Edit Params</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main Bento Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Trip Summary Bento Card (Span 8) */}\n        <div className=\"lg:col-span-8\">\n          <TripSummaryHeader\n            summary={itineraryData.trip_summary}\n            costs={itineraryData.estimated_costs}\n            onOpenJsonModal={onOpenJsonModal}\n            onExportMarkdown={handleExportMarkdown}\n          />\n        </div>\n\n        {/* Estimated Costs Bento Card (Span 4) */}\n        <div className=\"lg:col-span-4\">\n          <CostBreakdownCard\n            costs={itineraryData.estimated_costs}\n            totalDays={itineraryData.trip_summary.total_days}\n          />\n        </div>\n\n        {/* Local Logistics Bento Card (Span 4) */}\n        <div className=\"lg:col-span-4 lg:row-start-2\">\n          <LogisticsGuideCard guide={itineraryData.local_logistics_guide} />\n        </div>\n\n        {/* Day-by-Day Schedule Section (Span 8) */}\n        <div className=\"lg:col-span-8 lg:row-start-2 space-y-4\">\n          {/* Day Selector Pill Tabs */}\n          <div className=\"flex items-center justify-between flex-wrap gap-2 bg-white border-2 border-[#1A1A1A] rounded-2xl p-2 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n            <span className=\"text-[11px] font-black uppercase tracking-wider px-2 text-[#1A1A1A]/70\">\n              Days View:\n            </span>\n            <div className=\"flex flex-wrap gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => setSelectedDayFilter(\'all\')}\n                className={`px-3 py-1 text-xs font-black uppercase rounded-xl border transition ${\n                  selectedDayFilter === \'all\'\n                    ? \'bg-[#1A1A1A] text-white border-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                    : \'bg-[#F3F4F1] text-[#1A1A1A] border-[#1A1A1A]/30 hover:bg-[#C5E876]\'\n                }`}\n              >\n                All ({itineraryData.itinerary.length}d)\n              </button>\n              {itineraryData.itinerary.map((d) => (\n                <button\n                  key={d.day_number}\n                  type=\"button\"\n                  onClick={() => setSelectedDayFilter(d.day_number)}\n                  className={`px-3 py-1 text-xs font-black uppercase rounded-xl border transition ${\n                    selectedDayFilter === d.day_number\n                      ? \'bg-[#1A1A1A] text-white border-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                      : \'bg-[#F3F4F1] text-[#1A1A1A] border-[#1A1A1A]/30 hover:bg-[#89CFF0]\'\n                  }`}\n                >\n                  Day {d.day_number}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Render Schedule Cards */}\n          <div className=\"space-y-6\">\n            {displayedDays.map((day) => (\n              <DayScheduleCard\n                key={day.day_number}\n                day={day}\n                destination={itineraryData.trip_summary.destination}\n                completedActivities={completedActivities}\n                onToggleActivity={onToggleActivity}\n                onSwapActivity={(dNum, aIdx, act) => onSwapActivity(dNum, aIdx, act)}\n              />\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
