    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Sparkles,\n  Printer,\n  Compass,\n  Wallet,\n} from \'lucide-react\';\nimport { TripSummary, EstimatedCosts } from \'../types\';\nimport { getDestinationPhoto } from \'../utils/imageService\';\n\ninterface TripSummaryHeaderProps {\n  summary: TripSummary;\n  estimatedCosts: EstimatedCosts;\n  onPrintPdf: () => void;\n  isLargeText: boolean;\n}\n\nexport const TripSummaryHeader: React.FC<TripSummaryHeaderProps> = ({\n  summary,\n  estimatedCosts,\n  onPrintPdf,\n  isLargeText,\n}) => {\n  const photoUrl = summary.destination_photo || getDestinationPhoto(summary.destination);\n\n  return (\n    <div className=\"overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm\">\n      {/* Hero Photo Banner */}\n      <div className=\"relative h-64 sm:h-80 w-full overflow-hidden bg-stone-900\">\n        <img\n          src={photoUrl}\n          alt={summary.destination}\n          referrerPolicy=\"no-referrer\"\n          className=\"h-full w-full object-cover opacity-85 transition duration-500 hover:scale-105\"\n        />\n        <div className=\"absolute inset-0 bg-linear-to-t from-stone-950/90 via-stone-950/40 to-transparent\" />\n\n        {/* Content Overlay */}\n        <div className=\"absolute inset-0 flex flex-col justify-between p-6 sm:p-8\">\n          {/* Top Badges & Actions */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"inline-flex items-center gap-1.5 rounded-full bg-black/60 px-3.5 py-1 text-xs font-semibold text-white backdrop-blur-md border border-white/20\">\n                <MapPin className=\"h-3.5 w-3.5 text-amber-400\" />\n                <span>{summary.destination}</span>\n              </span>\n              <span className=\"inline-flex items-center gap-1.5 rounded-full bg-amber-500 px-3.5 py-1 text-xs font-bold text-white shadow-xs\">\n                <Calendar className=\"h-3.5 w-3.5\" />\n                <span>{summary.total_days} Days Plan</span>\n              </span>\n            </div>\n\n            {/* Print / Save PDF Button */}\n            <div className=\"print:hidden\">\n              <button\n                type=\"button\"\n                onClick={onPrintPdf}\n                className=\"inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs sm:text-sm font-bold text-stone-900 shadow-md transition hover:bg-stone-100 active:scale-98\"\n                title=\"Print or save this complete itinerary as a PDF document\"\n              >\n                <Printer className=\"h-4 w-4 text-amber-600\" />\n                <span>Print / Save PDF</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Bottom Title & Theme */}\n          <div>\n            <h1 className=\"text-2xl sm:text-4xl font-extrabold text-white tracking-tight drop-shadow-sm\">\n              {summary.destination}\n            </h1>\n            <p className=\"mt-1.5 max-w-3xl text-sm sm:text-base font-medium text-stone-200 drop-shadow-xs line-clamp-2\">\n              \"{summary.theme_vibe}\"\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Summary Footer Meta in INR (\342\202\271) */}\n      <div className=\"grid grid-cols-1 divide-y sm:divide-y-0 sm:divide-x divide-stone-200 bg-stone-50/70 sm:grid-cols-3\">\n        {/* Total Days */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-stone-400\">\n            Trip Duration\n          </span>\n          <p className=\"mt-0.5 text-base sm:text-lg font-bold text-stone-900\">\n            {summary.total_days} Full Days Planned\n          </p>\n          <p className=\"text-xs text-stone-500\">Clustered by geographic proximity</p>\n        </div>\n\n        {/* Estimated Daily Budget in INR */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-stone-400\">\n            Estimated Daily Budget\n          </span>\n          <p className=\"mt-0.5 text-base sm:text-lg font-bold text-emerald-700\">\n            \342\202\271{((estimatedCosts.activities_per_day || 0) + (estimatedCosts.food_per_day || 0)).toLocaleString(\'en-IN\')} / day\n          </p>\n          <p className=\"text-xs text-stone-500\">\n            Food approx \342\202\271{(estimatedCosts.food_per_day || 0).toLocaleString(\'en-IN\')} + Activities \342\202\271{(estimatedCosts.activities_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n        </div>\n\n        {/* Budget Strategy */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-bold uppercase tracking-wider text-stone-400\">\n            Budget Strategy\n          </span>\n          <p className=\"mt-0.5 text-xs sm:text-sm font-medium text-stone-700 line-clamp-2\">\n            {summary.budget_strategy}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
