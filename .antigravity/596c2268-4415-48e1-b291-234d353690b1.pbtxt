        lines {
          text: "          title: \"Over 2,000 Temples and Shrines\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"Kyoto was Japan\'s imperial capital for over 1,000 years (794 to 1868) and is home to more than 1,600 Buddhist temples and 400 Shinto shrines.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          tag: \"History\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
