    replacement_chunks {
      target_content: "import React from \'react\';\nimport {\n  Sun,\n  Sunrise,\n  Moon,\n  Clock,\n  Lightbulb,\n  RefreshCw,\n  ExternalLink,\n  MapPin,\n  CheckCircle2,\n  Circle,\n} from \'lucide-react\';\nimport { DayItinerary, ActivityItem } from \'../types\';\n\ninterface DayScheduleCardProps {\n  day: DayItinerary;\n  destination: string;\n  completedActivities: Record<string, boolean>;\n  onToggleActivity: (activityId: string) => void;\n  onSwapActivity: (dayNumber: number, activityIndex: number, activity: ActivityItem) => void;\n}\n\nexport const DayScheduleCard: React.FC<DayScheduleCardProps> = ({\n  day,\n  destination,\n  completedActivities,\n  onToggleActivity,\n  onSwapActivity,\n}) => {\n  const getSlotIcon = (slot: string) => {\n    const s = slot.toLowerCase();\n    if (s.includes(\'morning\')) return <Sunrise className=\"h-4 w-4 text-amber-600\" />;\n    if (s.includes(\'afternoon\')) return <Sun className=\"h-4 w-4 text-orange-500\" />;\n    return <Moon className=\"h-4 w-4 text-indigo-500\" />;\n  };\n\n  const getCostBadgeClass = (tier: string) => {\n    const t = tier.toLowerCase();\n    if (t.includes(\'free\')) return \'bg-emerald-100 text-emerald-800 border-emerald-200\';\n    if (t.includes(\'$$$\')) return \'bg-purple-100 text-purple-800 border-purple-200\';\n    if (t.includes(\'$$\')) return \'bg-blue-100 text-blue-800 border-blue-200\';\n    return \'bg-amber-100 text-amber-800 border-amber-200\';\n  };\n\n  return (\n    <div className=\"rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:shadow-md md:p-6\">\n      {/* Day Header */}\n      <div className=\"flex flex-col gap-2 border-b border-stone-100 pb-4 sm:flex-row sm:items-center sm:justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-stone-900 font-extrabold text-stone-50 shadow-xs\">\n            D{day.day_number}\n          </div>\n          <div>\n            <h3 className=\"text-base font-bold text-stone-900 sm:text-lg\">\n              {day.day_theme}\n            </h3>\n            <div className=\"flex items-center gap-1 text-xs text-stone-500\">\n              <MapPin className=\"h-3.5 w-3.5 text-amber-700\" />\n              <span>Geographic Focus:</span>\n              <span className=\"font-semibold text-stone-700\">{day.geographical_focus}</span>\n            </div>\n          </div>\n        </div>\n\n        <span className=\"inline-block self-start rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600 sm:self-center\">\n          {day.schedule?.length || 0} Key Activities\n        </span>\n      </div>\n\n      {/* Schedule Items Timeline */}\n      <div className=\"mt-5 space-y-4\">\n        {day.schedule?.map((act, index) => {\n          const actId = `d${day.day_number}-act${index}`;\n          const isDone = Boolean(completedActivities[actId]);\n\n          return (\n            <div\n              key={index}\n              className={`relative rounded-xl border p-4 transition ${\n                isDone\n                  ? \'border-stone-200 bg-stone-50/70 opacity-75\'\n                  : \'border-stone-200/90 bg-stone-50/30 hover:border-amber-300 hover:bg-amber-50/10\'\n              }`}\n            >\n              <div className=\"flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between\">\n                {/* Time slot & Name */}\n                <div className=\"flex items-start gap-2.5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onToggleActivity(actId)}\n                    className=\"mt-0.5 text-stone-400 transition hover:text-amber-800\"\n                    title={isDone ? \'Mark as active\' : \'Mark as visited\'}\n                  >\n                    {isDone ? (\n                      <CheckCircle2 className=\"h-5 w-5 text-emerald-600\" />\n                    ) : (\n                      <Circle className=\"h-5 w-5\" />\n                    )}\n                  </button>\n\n                  <div>\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      <span className=\"inline-flex items-center gap-1 rounded-md bg-stone-200/80 px-2 py-0.5 text-xs font-semibold text-stone-800\">\n                        {getSlotIcon(act.time_slot)}\n                        <span>{act.time_slot}</span>\n                      </span>\n\n                      <span\n                        className={`rounded-md border px-2 py-0.5 text-[11px] font-bold ${getCostBadgeClass(\n                          act.cost_tier\n                        )}`}\n                      >\n                        {act.cost_tier}\n                      </span>\n\n                      <span className=\"inline-flex items-center gap-1 text-xs text-stone-500\">\n                        <Clock className=\"h-3 w-3\" />\n                        <span>~{act.estimated_duration_hours}h</span>\n                      </span>\n                    </div>\n\n                    <h4\n                      className={`mt-1 text-sm font-bold sm:text-base ${\n                        isDone ? \'text-stone-500 line-through\' : \'text-stone-900\'\n                      }`}\n                    >\n                      {act.activity_name}\n                    </h4>\n                  </div>\n                </div>\n\n                {/* Quick actions for this activity */}\n                <div className=\"flex items-center gap-1 self-end sm:self-start\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onSwapActivity(day.day_number, index, act)}\n                    className=\"inline-flex items-center gap-1 rounded-lg border border-stone-200 bg-white px-2 py-1 text-[11px] font-medium text-stone-700 shadow-2xs transition hover:border-amber-400 hover:bg-amber-50 hover:text-amber-900\"\n                    title=\"Ask AI engine for an alternative in this neighborhood\"\n                  >\n                    <RefreshCw className=\"h-3 w-3 text-stone-500\" />\n                    <span>Swap</span>\n                  </button>\n\n                  <a\n                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(\n                      `${act.activity_name} ${destination}`\n                    )}`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"inline-flex items-center gap-1 rounded-lg border border-stone-200 bg-white px-2 py-1 text-[11px] font-medium text-stone-700 shadow-2xs transition hover:bg-stone-100 hover:text-stone-900\"\n                    title=\"Search location on Google Maps\"\n                  >\n                    <ExternalLink className=\"h-3 w-3 text-stone-500\" />\n                    <span>Maps</span>\n                  </a>\n                </div>\n              </div>\n\n              {/* Description */}\n              <p className=\"mt-2.5 text-xs text-stone-600 leading-relaxed sm:text-sm pl-7.5\">\n                {act.description}\n              </p>\n\n              {/* Insider Tip Callout */}\n              {act.insider_tip && (\n                <div className=\"mt-3 ml-7.5 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50/60 p-2.5 text-xs text-amber-950\">\n                  <Lightbulb className=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-amber-700\" />\n                  <div>\n                    <span className=\"font-bold text-amber-900\">Insider Tip: </span>\n                    <span className=\"leading-relaxed\">{act.insider_tip}</span>\n                  </div>\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport {\n  RefreshCw,\n  ExternalLink,\n  MapPin,\n  CheckCircle2,\n  Circle,\n} from \'lucide-react\';\nimport { DayItinerary, ActivityItem } from \'../types\';\n\ninterface DayScheduleCardProps {\n  day: DayItinerary;\n  destination: string;\n  completedActivities: Record<string, boolean>;\n  onToggleActivity: (activityId: string) => void;\n  onSwapActivity: (dayNumber: number, activityIndex: number, activity: ActivityItem) => void;\n}\n\nconst ACCENT_BORDER_COLORS = [\n  \'border-[#C5E876]\',\n  \'border-[#89CFF0]\',\n  \'border-[#FFD4D4]\',\n  \'border-[#1A1A1A]\',\n  \'border-[#C5E876]\',\n  \'border-[#89CFF0]\',\n];\n\nexport const DayScheduleCard: React.FC<DayScheduleCardProps> = ({\n  day,\n  destination,\n  completedActivities,\n  onToggleActivity,\n  onSwapActivity,\n}) => {\n  return (\n    <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[6px_6px_0px_0px_#1A1A1A] sm:p-8 text-[#1A1A1A]\">\n      {/* Day Header */}\n      <div className=\"flex flex-col gap-3 border-b-2 border-[#1A1A1A] border-dashed pb-6 sm:flex-row sm:items-center sm:justify-between\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"h-2.5 w-2.5 rounded-full bg-[#1A1A1A]\" />\n            <span className=\"text-xs font-black uppercase tracking-widest text-[#1A1A1A]/60\">\n              Schedule Breakdown\n            </span>\n          </div>\n          <h2 className=\"text-2xl sm:text-4xl font-black italic uppercase tracking-tighter text-[#1A1A1A]\">\n            Day 0{day.day_number}: {day.day_theme}\n          </h2>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2 self-start sm:self-center\">\n          <span className=\"px-3.5 py-1 bg-[#1A1A1A] text-white rounded-full text-xs font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_#1A1A1A]\">\n            <MapPin className=\"inline h-3 w-3 mr-1 text-[#C5E876]\" />\n            {day.geographical_focus}\n          </span>\n          <span className=\"px-3 py-1 bg-[#F3F4F1] border border-[#1A1A1A] text-[#1A1A1A] rounded-full text-xs font-bold\">\n            {day.schedule?.length || 0} Slots\n          </span>\n        </div>\n      </div>\n\n      {/* Schedule Items Timeline */}\n      <div className=\"mt-6 space-y-6\">\n        {day.schedule?.map((act, index) => {\n          const actId = `d${day.day_number}-act${index}`;\n          const isDone = Boolean(completedActivities[actId]);\n          const borderColor = ACCENT_BORDER_COLORS[index % ACCENT_BORDER_COLORS.length];\n\n          return (\n            <div\n              key={index}\n              className={`flex flex-col sm:flex-row gap-4 sm:gap-6 items-start transition ${\n                isDone ? \'opacity-40 line-through\' : \'\'\n              }`}\n            >\n              {/* Left Column: Time slot + cost badge */}\n              <div className=\"w-full sm:w-24 shrink-0 flex sm:flex-col items-center sm:items-center justify-between sm:justify-start gap-1 text-center bg-[#F3F4F1] sm:bg-transparent p-2 sm:p-0 rounded-xl sm:rounded-none\">\n                <div className=\"flex items-center gap-2 sm:flex-col\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onToggleActivity(actId)}\n                    className=\"text-[#1A1A1A] hover:scale-110 transition shrink-0\"\n                    title={isDone ? \'Mark unvisited\' : \'Mark visited\'}\n                  >\n                    {isDone ? (\n                      <CheckCircle2 className=\"h-5 w-5 text-emerald-600\" />\n                    ) : (\n                      <Circle className=\"h-5 w-5\" />\n                    )}\n                  </button>\n                  <span className=\"text-xs font-black uppercase tracking-wider opacity-60\">\n                    {act.time_slot}\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-1.5 sm:mt-1\">\n                  <span className=\"text-xs font-black px-2 py-0.5 rounded border border-[#1A1A1A] bg-white\">\n                    {act.cost_tier}\n                  </span>\n                  <span className=\"text-[11px] font-bold opacity-60\">\n                    ~{act.estimated_duration_hours}h\n                  </span>\n                </div>\n              </div>\n\n              {/* Right Column: Activity Card with Left Accent Border */}\n              <div\n                className={`flex-grow w-full border-l-4 ${borderColor} pl-4 sm:pl-6 py-0.5`}\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <h3 className=\"text-lg sm:text-xl font-black tracking-tight text-[#1A1A1A]\">\n                    {act.activity_name}\n                  </h3>\n\n                  {/* Actions */}\n                  <div className=\"flex items-center gap-1.5 shrink-0\">\n                    <button\n                      type=\"button\"\n                      onClick={() => onSwapActivity(day.day_number, index, act)}\n                      className=\"inline-flex items-center gap-1 rounded-xl border border-[#1A1A1A] bg-white px-2.5 py-1 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#C5E876]\"\n                      title=\"Swap this activity with an AI alternative\"\n                    >\n                      <RefreshCw className=\"h-3 w-3\" />\n                      <span>Swap</span>\n                    </button>\n\n                    <a\n                      href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(\n                        `${act.activity_name} ${destination}`\n                      )}`}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"inline-flex items-center gap-1 rounded-xl border border-[#1A1A1A] bg-white px-2.5 py-1 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#89CFF0]\"\n                      title=\"Search on Google Maps\"\n                    >\n                      <ExternalLink className=\"h-3 w-3\" />\n                      <span>Maps</span>\n                    </a>\n                  </div>\n                </div>\n\n                <p className=\"mt-1.5 text-xs sm:text-sm font-medium opacity-70 leading-relaxed\">\n                  {act.description}\n                </p>\n\n                {/* Insider Tip Callout */}\n                {act.insider_tip && (\n                  <div className=\"mt-3 bg-[#F3F4F1] p-3 rounded-2xl border border-[#1A1A1A]/10 text-xs font-medium leading-relaxed\">\n                    <b className=\"uppercase text-[10px] font-black tracking-wider text-[#1A1A1A] block sm:inline mr-1\">\n                      Insider Tip:\n                    </b>\n                    <span>{act.insider_tip}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Transit Check Bar */}\n      <div className=\"mt-6 flex flex-wrap justify-between items-center bg-[#F3F4F1] px-4 py-2.5 rounded-2xl border border-[#1A1A1A]/10 text-xs font-bold\">\n        <span className=\"text-[10px] font-black uppercase tracking-wider text-[#1A1A1A]\">\n          Geographic Check:\n        </span>\n        <span className=\"text-[11px] text-[#1A1A1A]/80\">\n          Neighborhood focus in {day.geographical_focus} \342\200\242 30\342\200\22345 min transit buffers factored\n        </span>\n      </div>\n    </div>\n  );\n};\n"
