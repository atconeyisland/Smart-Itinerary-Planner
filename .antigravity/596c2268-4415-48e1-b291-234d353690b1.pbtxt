          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          title: \"Birthplace of Geiko & Matcha Culture\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"Uji, located just 20 minutes south of Kyoto, produces Japan\'s finest ceremonial green tea matcha, cultivated by monks since the 12th century.\","
