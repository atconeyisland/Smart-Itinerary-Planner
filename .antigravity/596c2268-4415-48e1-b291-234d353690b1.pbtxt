    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Building2, Check, MapPin, HeartHandshake } from \'lucide-react\';\nimport { HotelRecommendation } from \'../types\';\nimport { getHotelPhoto } from \'../utils/imageService\';\n\ninterface HotelSectionProps {\n  hotels?: HotelRecommendation[];\n  destination: string;\n  isLargeText: boolean;\n}\n\nexport const HotelSection: React.FC<HotelSectionProps> = ({ hotels, destination, isLargeText }) => {\n  if (!hotels || hotels.length === 0) {\n    return (\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-8 text-center shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <Building2 className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-black text-[#1A1A1A]\">Hotel Recommendations</h3>\n        <p className=\"mt-1 text-sm font-medium text-stone-500\">\n          No hotel recommendations were included in this itinerary generation.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-black\' : \'text-lg sm:text-xl font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A]\">\n                <Building2 className=\"h-5 w-5\" />\n              </span>\n              <h2 className={`${titleSize} text-[#1A1A1A]`}>\n                Recommended Stays in {destination.split(\',\')[0]}\n              </h2>\n            </div>\n            <p className={`mt-1 font-medium text-stone-600 ${bodySize}`}>\n              Curated accommodations across budget tiers, prioritizing comfort, elevator access, and neighborhood safety.\n            </p>\n          </div>\n          <span className=\"inline-flex self-start sm:self-auto rounded-full border border-[#1A1A1A] bg-[#C5E876] px-3 py-1 text-xs font-black text-[#1A1A1A]\">\n            Prices in INR (\342\202\271)\n          </span>\n        </div>\n      </div>\n\n      {/* Hotel Cards Grid */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-3\">\n        {hotels.map((hotel, idx) => {\n          const photoUrl = getHotelPhoto(hotel.category, hotel.name);\n          const isLuxury = hotel.category.toLowerCase().includes(\'luxury\') || hotel.category.toLowerCase().includes(\'heritage\');\n          const isBudget = hotel.category.toLowerCase().includes(\'budget\');\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[6px_6px_0px_0px_#1A1A1A] transition hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_#1A1A1A]\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden border-b-2 border-[#1A1A1A] bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={hotel.name}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-block rounded-full border border-[#1A1A1A] px-3 py-1 text-xs font-black shadow-xs ${\n                      isLuxury\n                        ? \'bg-[#FFD4D4] text-[#1A1A1A]\'\n                        : isBudget\n                        ? \'bg-[#C5E876] text-[#1A1A1A]\'\n                        : \'bg-white text-[#1A1A1A]\'\n                    }`}\n                  >\n                    {hotel.category}\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl border border-white bg-black/80 px-3 py-1 text-xs font-black text-white backdrop-blur-xs\">\n                  \342\202\271{hotel.approx_price_inr_per_night?.toLocaleString(\'en-IN\') || \'\342\200\224\'} / night\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <h3 className={`font-black text-[#1A1A1A] ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                    {hotel.name}\n                  </h3>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-[#1A1A1A]\" />\n                    <span>{hotel.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Best For Badge */}\n                <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <div className=\"flex items-start gap-2\">\n                    <HeartHandshake className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n                    <div>\n                      <p className=\"text-xs font-black text-[#1A1A1A] uppercase tracking-wide\">\n                        Best Suited For\n                      </p>\n                      <p className={`text-xs font-semibold text-stone-800 ${isLargeText ? \'text-sm\' : \'text-xs\'}`}>\n                        {hotel.best_for}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Highlights List */}\n                <div className=\"flex-1 space-y-1.5\">\n                  <p className=\"text-xs font-black text-stone-500 uppercase tracking-wider\">\n                    Key Highlights\n                  </p>\n                  <ul className=\"space-y-1.5\">\n                    {hotel.key_highlights?.map((highlight, hIdx) => (\n                      <li key={hIdx} className={`flex items-start gap-2 ${bodySize} font-medium text-stone-700`}>\n                        <Check className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n                        <span>{highlight}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
