  file_change {
    absolute_path_uri: "file:///src/components/RestaurantSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { UtensilsCrossed, Leaf, MapPin, Sparkles, Info, ExternalLink, Navigation, Coffee } from \'lucide-react\';\nimport { RestaurantRecommendation } from \'../types\';\nimport { getFoodPhoto } from \'../utils/imageService\';\nimport { formatPrice } from \'../utils/currencyUtils\';\nimport { generatePlaceGoogleMapsUrl } from \'../utils/mapExportUtils\';\n\ninterface RestaurantSectionProps {\n  restaurants?: RestaurantRecommendation[];\n  destination: string;\n  currency?: string;\n  isLargeText: boolean;\n}\n\nexport const RestaurantSection: React.FC<RestaurantSectionProps> = ({\n  restaurants,\n  destination,\n  currency = \'USD\',\n  isLargeText,\n}) => {\n  const [selectedVegFilter, setSelectedVegFilter] = useState<\'all\' | \'pure_veg\' | \'veg_friendly\'>(\'all\');\n  const [selectedCategoryTag, setSelectedCategoryTag] = useState<string>(\'all\');\n\n  const categoryTags = useMemo(() => {\n    if (!restaurants) return [];\n    const set = new Set<string>();\n    restaurants.forEach((r) => {\n      if (r.category_tag) set.add(r.category_tag);\n    });\n    return Array.from(set);\n  }, [restaurants]);\n\n  const filteredRestaurants = useMemo(() => {\n    if (!restaurants) return [];\n    return restaurants.filter((place) => {\n      const isPureVeg = place.veg_friendliness.toLowerCase().includes(\'pure veg\');\n      const isVegFriendly = place.veg_friendliness.toLowerCase().includes(\'excellent veg\') || isPureVeg;\n\n      if (selectedVegFilter === \'pure_veg\' && !isPureVeg) return false;\n      if (selectedVegFilter === \'veg_friendly\' && !isVegFriendly) return false;\n\n      if (selectedCategoryTag !== \'all\' && place.category_tag !== selectedCategoryTag) {\n        return false;\n      }\n\n      return true;\n    });\n  }, [restaurants, selectedVegFilter, selectedCategoryTag]);\n\n  if (!restaurants || restaurants.length === 0) {\n    return (\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-8 text-center shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <UtensilsCrossed className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-black text-[#1A1A1A]\">Food & Dining Guide</h3>\n        <p className=\"mt-1 text-sm font-medium text-stone-500\">\n          No dining recommendations were included in this plan.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-black\' : \'text-lg sm:text-xl font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  const googleFoodSearchUrl = `https://www.google.com/maps/search/restaurants+in+${encodeURIComponent(\n    destination\n  )}`;\n\n  return (\n    <div className=\"space-y-6\" id=\"restaurant-guide-section\">\n      {/* Header Info */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A] bg-[#FAF9F5]\">\n        <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#EF4444] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                <UtensilsCrossed className=\"h-5 w-5\" />\n              </span>\n              <h2 className={`${titleSize} text-[#1A1A1A]`}>\n                Local Food & Dining Guide in {destination.split(\',\')[0]} ({restaurants.length} Places)\n              </h2>\n            </div>\n            <p className={`mt-1 font-medium text-[#4A5568] ${bodySize}`}>\n              Authentic regional culinary highlights, pure-veg options, senior-friendly seating tips, and estimated costs for two.\n            </p>\n          </div>\n\n          <a\n            href={googleFoodSearchUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-2 self-start sm:self-auto rounded-xl border-2 border-[#1A1A1A] bg-[#EF4444] px-3.5 py-2 text-xs font-black text-white shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n          >\n            <span>Explore Restaurants on Google Maps</span>\n            <ExternalLink className=\"h-3.5 w-3.5\" />\n          </a>\n        </div>\n\n        {/* Dietary & Category Filters */}\n        <div className=\"mt-4 pt-4 border-t-2 border-[#1A1A1A] flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-bold text-[#718096] uppercase tracking-wider mr-1\">Dietary:</span>\n            <button\n              onClick={() => setSelectedVegFilter(\'all\')}\n              className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all ${\n                selectedVegFilter === \'all\'\n                  ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#EF4444]\'\n                  : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n              }`}\n            >\n              All Eateries ({restaurants.length})\n            </button>\n            <button\n              onClick={() => setSelectedVegFilter(\'pure_veg\')}\n              className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all flex items-center gap-1.5 ${\n                selectedVegFilter === \'pure_veg\'\n                  ? \'bg-[#166534] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                  : \'bg-[#FFFFFF] text-[#166534] hover:bg-[#DCFCE7]\'\n              }`}\n            >\n              <Leaf className=\"w-3 h-3 text-[#22C55E]\" />\n              <span>Pure Veg Only</span>\n            </button>\n            <button\n              onClick={() => setSelectedVegFilter(\'veg_friendly\')}\n              className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all ${\n                selectedVegFilter === \'veg_friendly\'\n                  ? \'bg-[#2563EB] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                  : \'bg-[#FFFFFF] text-[#2563EB] hover:bg-[#EFF6FF]\'\n              }`}\n            >\n              Veg & Vegan Friendly\n            </button>\n          </div>\n\n          {categoryTags.length > 0 && (\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"text-xs font-bold text-[#718096] uppercase tracking-wider\">Type:</span>\n              <select\n                value={selectedCategoryTag}\n                onChange={(e) => setSelectedCategoryTag(e.target.value)}\n                className=\"px-3 py-1 text-xs font-bold bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-xl\"\n              >\n                <option value=\"all\">All Types</option>\n                {categoryTags.map((tag) => (\n                  <option key={tag} value={tag}>\n                    {tag}\n                  </option>\n                ))}\n              </select>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Restaurant Cards Grid (Responsive 1, 2, or 3 columns) */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3\">\n        {filteredRestaurants.map((place, idx) => {\n          const photoUrl = getFoodPhoto(place.must_try_dish || place.cuisine_type);\n          const isPureVeg = place.veg_friendliness.toLowerCase().includes(\'pure veg\');\n          const isVegFriendly = place.veg_friendliness.toLowerCase().includes(\'excellent veg\') || isPureVeg;\n\n          const cost = place.approx_cost_for_two || (place as any).approx_cost_inr_for_two || 0;\n          const foodCurrency = place.currency || currency;\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[4px_4px_0px_0px_#1A1A1A] transition hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#1A1A1A]\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden border-b-2 border-[#1A1A1A] bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={place.must_try_dish}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-flex items-center gap-1 rounded-xl border-2 border-[#1A1A1A] px-2.5 py-1 text-xs font-black shadow-[2px_2px_0px_0px_#1A1A1A] ${\n                      isPureVeg\n                        ? \'bg-[#DCFCE7] text-[#166534]\'\n                        : isVegFriendly\n                        ? \'bg-[#E0E7FF] text-[#4338CA]\'\n                        : \'bg-white text-[#1A1A1A]\'\n                    }`}\n                  >\n                    {isVegFriendly && <Leaf className=\"h-3.5 w-3.5\" />}\n                    <span>{place.veg_friendliness}</span>\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl border-2 border-[#1A1A1A] bg-[#1A1A1A] px-3 py-1 text-xs font-black text-white shadow-[2px_2px_0px_0px_#FFFFFF]\">\n                  ~{formatPrice(cost, foodCurrency)} for two\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <div className=\"flex items-center justify-between\">\n                    <h3 className={`font-black text-[#1A1A1A] ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                      {place.name}\n                    </h3>\n                    {place.category_tag && (\n                      <span className=\"text-[10px] font-black uppercase px-2 py-0.5 bg-[#FAF9F5] border border-[#CBD5E0] rounded-md text-[#718096]\">\n                        {place.category_tag}\n                      </span>\n                    )}\n                  </div>\n                  <p className=\"text-xs font-bold text-stone-600 mt-0.5\">{place.cuisine_type}</p>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs font-bold text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-[#1A1A1A]\" />\n                    <span>{place.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Must Try Dish */}\n                <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FEF2F2] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <p className=\"text-[10px] font-black text-[#DC2626] uppercase tracking-wide flex items-center gap-1\">\n                    <Sparkles className=\"h-3 w-3 text-[#DC2626]\" />\n                    Must-Try Specialty\n                  </p>\n                  <p className={`mt-0.5 font-black text-[#1A1A1A] ${isLargeText ? \'text-base\' : \'text-sm\'}`}>\n                    {place.must_try_dish}\n                  </p>\n                </div>\n\n                {/* Senior & Family Tips */}\n                <div className=\"flex-1 rounded-2xl border-2 border-[#1A1A1A] bg-[#FAF9F5] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <p className=\"text-[10px] font-black text-stone-700 uppercase tracking-wide flex items-center gap-1\">\n                    <Info className=\"h-3 w-3 text-[#1A1A1A]\" />\n                    Dining & Comfort Tip\n                  </p>\n                  <p className={`mt-1 font-medium text-stone-700 ${bodySize}`}>\n                    {place.senior_and_family_tips}\n                  </p>\n                </div>\n\n                {/* Direct Google Maps link */}\n                <div className=\"pt-3 border-t border-[#E2E8F0] flex items-center justify-between\">\n                  <a\n                    href={generatePlaceGoogleMapsUrl(place.name, destination, place.neighborhood)}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"inline-flex items-center gap-1.5 text-xs font-black text-[#EF4444] hover:underline\"\n                  >\n                    <Navigation className=\"w-3.5 h-3.5\" />\n                    <span>View on Maps</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </a>\n\n                  <span className=\"text-[11px] font-bold text-[#718096]\">\n                    \360\237\223\215 {place.neighborhood.split(\',\')[0]}\n                  </span>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
