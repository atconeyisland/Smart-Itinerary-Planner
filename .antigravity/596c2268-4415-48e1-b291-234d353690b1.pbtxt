           </button>\n\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"rounded-lg p-1.5 text-stone-400 hover:bg-stone-100 hover:text-stone-700\"\n            >\n              <X className=\"h-5 w-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Modal Content */}\n        <div className=\"flex-1 overflow-auto bg-stone-950 p-4 font-mono text-xs text-stone-200\">\n          <pre className=\"select-text whitespace-pre-wrap break-words\">{jsonString}</pre>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"flex items-center justify-between border-t border-stone-200 bg-stone-50 px-6 py-3 text-xs text-stone-500\">\n          <span>Schema matches strict system prompt JSON specifications</span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-lg bg-stone-800 px-4 py-1.5 font-medium text-white transition hover:bg-stone-900\"\n          >\n            Close\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Copy, Check, Code2 } from \'lucide-react\';\nimport { ItineraryPlanResponse } from \'../types\';\n\ninterface JsonModalProps {\n  data: ItineraryPlanResponse;\n  onClose: () => void;\n}\n\nexport const JsonModal: React.FC<JsonModalProps> = ({ data, onClose }) => {\n  const [copied, setCopied] = useState(false);\n  const jsonString = JSON.stringify(data, null, 2);\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(jsonString);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-xs\">\n      <div className=\"flex max-h-[85vh] w-full max-w-4xl flex-col rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[8px_8px_0px_0px_#1A1A1A] overflow-hidden\">\n        {/* Modal Header */}\n        <div className=\"flex items-center justify-between border-b-2 border-[#1A1A1A] bg-[#F3F4F1] px-6 py-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-[#1A1A1A]\" />\n            <h3 className=\"text-sm font-black uppercase tracking-wider text-[#1A1A1A]\">\n              Raw JSON Schema Output\n            </h3>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={handleCopy}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] px-3 py-1.5 text-xs font-black text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5\"\n            >\n              {copied ? (\n                <>\n                  <Check className=\"h-3.5 w-3.5 text-emerald-800\" />\n                  <span>Copied!</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"h-3.5 w-3.5\" />\n                  <span>Copy JSON</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"rounded-xl border-2 border-[#1A1A1A] bg-white p-1.5 text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#FFD4D4]\"\n            >\n              <X className=\"h-4 w-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Modal Content */}\n        <div className=\"flex-1 overflow-auto bg-[#1A1A1A] p-5 font-mono text-xs text-[#C5E876] leading-relaxed\">\n          <pre className=\"select-text whitespace-pre-wrap break-words\">{jsonString}</pre>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"flex items-center justify-between border-t-2 border-[#1A1A1A] bg-[#F3F4F1] px-6 py-3 text-xs font-bold text-[#1A1A1A]/70\">\n          <span>Schema: TypeScript ItineraryPlanResponse compliant</span>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-xl border-2 border-[#1A1A1A] bg-white px-4 py-1.5 text-xs font-black uppercase text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#F3F4F1]\"\n          >\n            Close\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    instruction: "Update JsonModal to Bento Grid design theme"
  }
}
