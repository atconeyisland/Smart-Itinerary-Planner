    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport {\n  Bus,\n  ShieldCheck,\n  Luggage,\n  CheckSquare,\n  Square,\n} from \'lucide-react\';\nimport { LocalLogisticsGuide } from \'../types\';\n\ninterface LogisticsGuideCardProps {\n  guide: LocalLogisticsGuide;\n}\n\nexport const LogisticsGuideCard: React.FC<LogisticsGuideCardProps> = ({ guide }) => {\n  const [checkedItems, setCheckedItems] = useState<Record<number, boolean>>({});\n\n  const togglePackingItem = (idx: number) => {\n    setCheckedItems((prev) => ({ ...prev, [idx]: !prev[idx] }));\n  };\n\n  return (\n    <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-sm\">\n      <div className=\"border-b border-stone-100 pb-3\">\n        <h3 className=\"text-base font-bold text-stone-900 sm:text-lg\">\n          Local Logistics & Culture Guide\n        </h3>\n        <p className=\"text-xs text-stone-500\">\n          Geographic transit methods, behavioral norms, and itinerary-specific packing items\n        </p>\n      </div>\n\n      <div className=\"mt-5 grid grid-cols-1 gap-6 lg:grid-cols-3\">\n        {/* Transit Method */}\n        <div className=\"rounded-xl border border-stone-200/80 bg-stone-50/50 p-4\">\n          <div className=\"flex items-center gap-2 text-stone-900\">\n            <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-blue-100 text-blue-800\">\n              <Bus className=\"h-4 w-4\" />\n            </div>\n            <h4 className=\"text-sm font-bold\">Best Transit Strategy</h4>\n          </div>\n          <p className=\"mt-2.5 text-xs text-stone-700 leading-relaxed sm:text-sm\">\n            {guide.best_transit_method}\n          </p>\n        </div>\n\n        {/* Cultural Etiquette Alerts */}\n        <div className=\"rounded-xl border border-stone-200/80 bg-stone-50/50 p-4\">\n          <div className=\"flex items-center gap-2 text-stone-900\">\n            <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100 text-amber-800\">\n              <ShieldCheck className=\"h-4 w-4\" />\n            </div>\n            <h4 className=\"text-sm font-bold\">Cultural Etiquette Alerts</h4>\n          </div>\n          <ul className=\"mt-2.5 space-y-2 text-xs text-stone-700 leading-relaxed sm:text-sm\">\n            {guide.cultural_etiquette_alerts?.map((tip, idx) => (\n              <li key={idx} className=\"flex items-start gap-2\">\n                <span className=\"mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-700\" />\n                <span>{tip}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Packing Essentials */}\n        <div className=\"rounded-xl border border-stone-200/80 bg-stone-50/50 p-4\">\n          <div className=\"flex items-center gap-2 text-stone-900\">\n            <div className=\"flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-800\">\n              <Luggage className=\"h-4 w-4\" />\n            </div>\n            <h4 className=\"text-sm font-bold\">Packing Essentials Checklist</h4>\n          </div>\n          <ul className=\"mt-2.5 space-y-2 text-xs text-stone-700 leading-relaxed sm:text-sm\">\n            {guide.packing_essentials?.map((item, idx) => {\n              const isChecked = Boolean(checkedItems[idx]);\n              return (\n                <li\n                  key={idx}\n                  onClick={() => togglePackingItem(idx)}\n                  className=\"flex cursor-pointer items-start gap-2 select-none transition hover:text-stone-900\"\n                >\n                  <button\n                    type=\"button\"\n                    className=\"mt-0.5 text-stone-400 hover:text-emerald-700\"\n                  >\n                    {isChecked ? (\n                      <CheckSquare className=\"h-4 w-4 text-emerald-600\" />\n                    ) : (\n                      <Square className=\"h-4 w-4\" />\n                    )}\n                  </button>\n                  <span className={isChecked ? \'text-stone-400 line-through\' : \'text-stone-700\'}>\n                    {item}\n                  </span>\n                </li>\n              );\n            })}\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { LocalLogisticsGuide } from \'../types\';\n\ninterface LogisticsGuideCardProps {\n  guide: LocalLogisticsGuide;\n}\n\nexport const LogisticsGuideCard: React.FC<LogisticsGuideCardProps> = ({ guide }) => {\n  const [checkedItems, setCheckedItems] = useState<Record<number, boolean>>({});\n\n  const togglePackingItem = (idx: number) => {\n    setCheckedItems((prev) => ({ ...prev, [idx]: !prev[idx] }));\n  };\n\n  return (\n    <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-[#89CFF0] p-6 shadow-[6px_6px_0px_0px_#1A1A1A] text-[#1A1A1A]\">\n      <h2 className=\"text-xs font-black uppercase tracking-widest mb-4 flex items-center gap-2\">\n        <span className=\"w-2.5 h-2.5 bg-[#1A1A1A] rounded-full\" />\n        Local Logistics & Culture\n      </h2>\n\n      <div className=\"space-y-5\">\n        {/* Transit */}\n        <div>\n          <p className=\"text-[11px] font-black uppercase tracking-wider opacity-70 mb-1\">\n            Best Transit Strategy\n          </p>\n          <p className=\"text-sm sm:text-base font-bold leading-snug\">\n            {guide.best_transit_method}\n          </p>\n        </div>\n\n        {/* Etiquette */}\n        <div className=\"space-y-2 border-t-2 border-[#1A1A1A]/10 pt-3\">\n          <p className=\"text-[11px] font-black uppercase tracking-wider opacity-70 mb-1\">\n            Cultural Etiquette Alerts\n          </p>\n          <ul className=\"text-xs sm:text-sm space-y-1.5 font-medium\">\n            {guide.cultural_etiquette_alerts?.map((tip, idx) => (\n              <li key={idx} className=\"flex gap-2 items-start\">\n                <span className=\"font-black text-blue-900 text-sm leading-none mt-0.5\">\342\200\242</span>\n                <span className=\"leading-snug\">{tip}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Packing Essentials */}\n        <div className=\"pt-3 border-t-2 border-[#1A1A1A]/10\">\n          <p className=\"text-[11px] font-black uppercase tracking-wider opacity-70 mb-2\">\n            Packing Essentials (Click to Check)\n          </p>\n          <div className=\"flex flex-wrap gap-2\">\n            {guide.packing_essentials?.map((item, idx) => {\n              const isChecked = Boolean(checkedItems[idx]);\n              return (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => togglePackingItem(idx)}\n                  className={`px-2.5 py-1 text-[11px] font-black uppercase tracking-tight border-2 border-[#1A1A1A] rounded-xl transition ${\n                    isChecked\n                      ? \'bg-[#1A1A1A] text-white line-through opacity-70 shadow-none\'\n                      : \'bg-white text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] hover:bg-[#C5E876]\'\n                  }`}\n                >\n                  {item}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
