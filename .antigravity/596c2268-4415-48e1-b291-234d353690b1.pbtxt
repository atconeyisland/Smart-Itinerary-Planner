   onToggleComplete={handleToggleActivity}\n            onOpenSwapModal={handleOpenSwapModal}\n            onPrintPdf={handlePrint}\n            isLargeText={isLargeText}\n          />\n        )}\n      </main>\n\n      {/* Clean Bento Footer */}\n      <footer className=\"mt-16 border-t-2 border-[#1A1A1A] bg-white py-8 text-center text-xs text-stone-600 print:hidden\">\n        <div className=\"mx-auto max-w-7xl px-4 space-y-1\">\n          <p className=\"font-black text-[#1A1A1A]\">\n            Smart Travel Planner \342\200\242 All Pricing in Indian Rupees (INR / \342\202\271)\n          </p>\n          <p className=\"font-medium text-stone-500\">\n            Geographic neighborhood clustering, hotel recommendations, food guides & survival phrasebook.\n          </p>\n        </div>\n      </footer>"
