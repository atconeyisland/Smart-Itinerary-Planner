  file_change {
    absolute_path_uri: "file:///src/components/DayScheduleCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Clock,\n  MapPin,\n  RefreshCw,\n  CheckCircle2,\n  Circle,\n  Sunrise,\n  Sun,\n  Sunset,\n  Lightbulb,\n} from \'lucide-react\';\nimport { DayItinerary, ActivityItem } from \'../types\';\nimport { getActivityPhoto } from \'../utils/imageService\';\n\ninterface DayScheduleCardProps {\n  day: DayItinerary;\n  destination: string;\n  completedActivities: Record<string, boolean>;\n  onToggleComplete: (activityKey: string) => void;\n  onOpenSwapModal: (dayNumber: number, activity: ActivityItem, geoFocus: string) => void;\n  isLargeText: boolean;\n}\n\nexport const DayScheduleCard: React.FC<DayScheduleCardProps> = ({\n  day,\n  destination,\n  completedActivities,\n  onToggleComplete,\n  onOpenSwapModal,\n  isLargeText,\n}) => {\n  const getSlotIcon = (slot: string) => {\n    const s = slot.toLowerCase();\n    if (s.includes(\'morning\')) return <Sunrise className=\"h-4 w-4 text-[#1A1A1A]\" />;\n    if (s.includes(\'afternoon\')) return <Sun className=\"h-4 w-4 text-[#1A1A1A]\" />;\n    return <Sunset className=\"h-4 w-4 text-[#1A1A1A]\" />;\n  };\n\n  const titleSize = isLargeText ? \'text-lg sm:text-xl font-black\' : \'text-base sm:text-lg font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[6px_6px_0px_0px_#1A1A1A]\">\n      {/* Day Banner */}\n      <div className=\"border-b-2 border-[#1A1A1A] bg-[#F3F4F1] p-5 sm:px-6\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] font-black text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              D{day.day_number}\n            </span>\n            <div>\n              <h3 className={`font-black text-[#1A1A1A] ${titleSize}`}>\n                {day.day_theme}\n              </h3>\n              <div className=\"mt-0.5 flex items-center gap-1 text-xs font-bold text-stone-600\">\n                <MapPin className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n                <span>Geographic Cluster: {day.geographical_focus}</span>\n              </div>\n            </div>\n          </div>\n          <span className=\"self-start sm:self-auto rounded-full border border-[#1A1A1A] bg-white px-3 py-1 text-xs font-bold text-[#1A1A1A]\">\n            {day.schedule.length} Activities\n          </span>\n        </div>\n      </div>\n\n      {/* Schedule Activities */}\n      <div className=\"divide-y-2 divide-stone-100 p-4 sm:p-6 space-y-6 sm:space-y-0\">\n        {day.schedule.map((item, idx) => {\n          const activityKey = `day-${day.day_number}-act-${idx}`;\n          const isDone = Boolean(completedActivities[activityKey]);\n          const photoUrl = getActivityPhoto(item.activity_name, destination);\n\n          return (\n            <div\n              key={idx}\n              className={`py-5 first:pt-0 last:pb-0 transition ${\n                isDone ? \'opacity-60\' : \'opacity-100\'\n              }`}\n            >\n              <div className=\"flex flex-col gap-4 sm:flex-row sm:items-start\">\n                {/* Photo thumbnail */}\n                <div className=\"relative h-44 sm:h-36 sm:w-48 shrink-0 overflow-hidden rounded-2xl border-2 border-[#1A1A1A] bg-stone-100 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                  <img\n                    src={photoUrl}\n                    alt={item.activity_name}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                    loading=\"lazy\"\n                  />\n                  <div className=\"absolute top-2 left-2 rounded-lg border border-[#1A1A1A] bg-[#C5E876] px-2 py-0.5 text-[11px] font-black text-[#1A1A1A] shadow-xs flex items-center gap-1\">\n                    {getSlotIcon(item.time_slot)}\n                    <span>{item.time_slot}</span>\n                  </div>\n                </div>\n\n                {/* Details */}\n                <div className=\"flex-1 space-y-2\">\n                  <div className=\"flex flex-wrap items-start justify-between gap-2\">\n                    <div className=\"flex items-start gap-2.5\">\n                      <button\n                        type=\"button\"\n                        onClick={() => onToggleComplete(activityKey)}\n                        className=\"mt-0.5 text-stone-400 transition hover:text-[#1A1A1A] focus:outline-hidden\"\n                        title={isDone ? \'Mark as to-do\' : \'Mark as visited\'}\n                      >\n                        {isDone ? (\n                          <CheckCircle2 className=\"h-6 w-6 text-[#1A1A1A] fill-[#C5E876]\" />\n                        ) : (\n                          <Circle className=\"h-6 w-6 text-stone-400 hover:text-stone-700\" />\n                        )}\n                      </button>\n                      <div>\n                        <h4\n                          className={`font-black text-[#1A1A1A] ${\n                            isDone ? \'line-through text-stone-500\' : \'\'\n                          } ${isLargeText ? \'text-lg\' : \'text-base\'}`}\n                        >\n                          {item.activity_name}\n                        </h4>\n                        <div className=\"mt-1 flex flex-wrap items-center gap-2.5 text-xs\">\n                          <span className=\"flex items-center gap-1 font-bold text-stone-600\">\n                            <Clock className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n                            {item.estimated_duration_hours} hrs\n                          </span>\n                          <span className=\"rounded-md border border-[#1A1A1A] bg-[#F3F4F1] px-2 py-0.5 font-bold text-[#1A1A1A]\">\n                            {item.cost_tier}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Swap button */}\n                    <button\n                      type=\"button\"\n                      onClick={() => onOpenSwapModal(day.day_number, item, day.geographical_focus)}\n                      className=\"print:hidden inline-flex items-center gap-1 rounded-xl border-2 border-[#1A1A1A] bg-white px-3 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#C5E876] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none\"\n                      title=\"Replace with an alternative nearby attraction\"\n                    >\n                      <RefreshCw className=\"h-3 w-3\" />\n                      <span>Swap</span>\n                    </button>\n                  </div>\n\n                  {/* Description */}\n                  <p className={`font-medium text-stone-700 leading-relaxed ${bodySize}`}>\n                    {item.description}\n                  </p>\n\n                  {/* Practical Insider Tip */}\n                  {item.insider_tip && (\n                    <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-3 shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                      <div className=\"flex items-start gap-2\">\n                        <Lightbulb className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n                        <p className={`text-xs sm:text-sm text-[#1A1A1A] font-semibold ${isLargeText ? \'text-base\' : \'\'}`}>\n                          <strong className=\"font-black\">Local Tip: </strong>\n                          {item.insider_tip}\n                        </p>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
