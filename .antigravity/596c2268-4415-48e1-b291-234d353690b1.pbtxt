  file_change {
    absolute_path_uri: "file:///src/utils/mapExportUtils.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DayItinerary, ActivityItem, ItineraryPlanResponse } from \'../types\';\n\n/**\n * Generates a Google Maps directions URL with multiple waypoints for a day\'s schedule.\n */\nexport function generateDayGoogleMapsUrl(day: DayItinerary, destination: string): string {\n  if (!day.schedule || day.schedule.length === 0) {\n    return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(destination)}`;\n  }\n\n  const cleanDest = destination.split(\',\')[0].trim();\n  const places = day.schedule.map((item) => `${item.activity_name}, ${cleanDest}`);\n\n  if (places.length === 1) {\n    return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(places[0])}`;\n  }\n\n  const origin = encodeURIComponent(places[0]);\n  const finalDest = encodeURIComponent(places[places.length - 1]);\n  const waypoints = places\n    .slice(1, -1)\n    .map((p) => encodeURIComponent(p))\n    .join(\'|\');\n\n  let url = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${finalDest}&travelmode=transit`;\n  if (waypoints) {\n    url += `&waypoints=${waypoints}`;\n  }\n  return url;\n}\n\n/**\n * Generates a direct Google Maps search link for a single activity/hotel/restaurant.\n */\nexport function generatePlaceGoogleMapsUrl(placeName: string, destination: string, neighborhood?: string): string {\n  const query = `${placeName}${neighborhood ? `, ${neighborhood}` : \'\'}, ${destination.split(\',\')[0].trim()}`;\n  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;\n}\n\n/**\n * Exports itinerary data as a KML file for Google My Maps import.\n */\nexport function downloadKmlForGoogleMyMaps(plan: ItineraryPlanResponse): void {\n  const destName = plan.trip_summary.destination;\n  let kmlContent = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n  <Document>\n    <name>${destName} - Smart Itinerary</name>\n    <description>${plan.trip_summary.total_days}-Day Trip to ${destName} | ${plan.trip_summary.theme_vibe}</description>\n`;\n\n  plan.itinerary.forEach((day) => {\n    kmlContent += `    <Folder>\n      <name>Day ${day.day_number}: ${day.day_theme}</name>\n`;\n    day.schedule.forEach((item) => {\n      const lat = item.coordinates?.lat || plan.trip_summary.destination_coords?.lat || 0;\n      const lng = item.coordinates?.lng || plan.trip_summary.destination_coords?.lng || 0;\n      kmlContent += `      <Placemark>\n        <name>[${item.time_slot}] ${escapeXml(item.activity_name)}</name>\n        <description>${escapeXml(item.description)}&#10;&#10;Insider Tip: ${escapeXml(item.insider_tip)}&#10;Cost: ${escapeXml(item.cost_tier)}</description>\n        <Point>\n          <coordinates>${lng},${lat},0</coordinates>\n        </Point>\n      </Placemark>\n`;\n    });\n    kmlContent += `    </Folder>\\n`;\n  });\n\n  // Add hotels if available\n  if (plan.hotel_recommendations && plan.hotel_recommendations.length > 0) {\n    kmlContent += `    <Folder>\n      <name>Recommended Hotels</name>\n`;\n    plan.hotel_recommendations.forEach((hotel) => {\n      const lat = hotel.coordinates?.lat || plan.trip_summary.destination_coords?.lat || 0;\n      const lng = hotel.coordinates?.lng || plan.trip_summary.destination_coords?.lng || 0;\n      kmlContent += `      <Placemark>\n        <name>[Hotel] ${escapeXml(hotel.name)} (${escapeXml(hotel.category)})</name>\n        <description>${escapeXml(hotel.neighborhood)}&#10;Best For: ${escapeXml(hotel.best_for)}&#10;Highlights: ${escapeXml(hotel.key_highlights.join(\', \'))}</description>\n        <Point>\n          <coordinates>${lng},${lat},0</coordinates>\n        </Point>\n      </Placemark>\n`;\n    });\n    kmlContent += `    </Folder>\\n`;\n  }\n\n  // Add restaurants if available\n  if (plan.restaurant_recommendations && plan.restaurant_recommendations.length > 0) {\n    kmlContent += `    <Folder>\n      <name>Recommended Dining</name>\n`;\n    plan.restaurant_recommendations.forEach((rest) => {\n      const lat = rest.coordinates?.lat || plan.trip_summary.destination_coords?.lat || 0;\n      const lng = rest.coordinates?.lng || plan.trip_summary.destination_coords?.lng || 0;\n      kmlContent += `      <Placemark>\n        <name>[Food] ${escapeXml(rest.name)} (${escapeXml(rest.cuisine_type)})</name>\n        <description>Must Try: ${escapeXml(rest.must_try_dish)}&#10;Neighborhood: ${escapeXml(rest.neighborhood)}&#10;Tips: ${escapeXml(rest.senior_and_family_tips)}</description>\n        <Point>\n          <coordinates>${lng},${lat},0</coordinates>\n        </Point>\n      </Placemark>\n`;\n    });\n    kmlContent += `    </Folder>\\n`;\n  }\n\n  kmlContent += `  </Document>\n</kml>`;\n\n  downloadFile(kmlContent, `${slugify(destName)}_itinerary_google_mymaps.kml`, \'application/vnd.google-earth.kml+xml\');\n}\n\n/**\n * Exports itinerary as an iCalendar (.ics) file so users can add the trip to Google Calendar or Apple Calendar.\n */\nexport function downloadIcsCalendar(plan: ItineraryPlanResponse): void {\n  const destName = plan.trip_summary.destination;\n  const now = new Date();\n  \n  let icsContent = `BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Smart Travel Planner//EN\nCALSCALE:GREGORIAN\nMETHOD:PUBLISH\nX-WR-CALNAME:${destName} Trip Schedule\n`;\n\n  plan.itinerary.forEach((day, dayIndex) => {\n    // Schedule for day index + 1 starting tomorrow or chosen date\n    const dayDate = new Date(now.getTime() + (dayIndex + 1) * 24 * 60 * 60 * 1000);\n    const year = dayDate.getFullYear();\n    const month = String(dayDate.getMonth() + 1).padStart(2, \'0\');\n    const dateStr = String(dayDate.getDate()).padStart(2, \'0\');\n\n    day.schedule.forEach((item, slotIndex) => {\n      const startHour = item.time_slot.toLowerCase().includes(\'morning\') ? 9 : item.time_slot.toLowerCase().includes(\'afternoon\') ? 14 : 18;\n      const duration = Math.max(1, Math.round(item.estimated_duration_hours || 2));\n      const endHour = startHour + duration;\n\n      const dtStart = `${year}${month}${dateStr}T${String(startHour).padStart(2, \'0\')}0000`;\n      const dtEnd = `${year}${month}${dateStr}T${String(endHour).padStart(2, \'0\')}0000`;\n      const uid = `trip-${plan.id || \'plan\'}-d${day.day_number}-s${slotIndex}-${Date.now()}@smarttravel.app`;\n\n      icsContent += `BEGIN:VEVENT\nUID:${uid}\nDTSTAMP:${year}${month}${dateStr}T000000Z\nDTSTART:${dtStart}\nDTEND:${dtEnd}\nSUMMARY:[Day ${day.day_number}] ${escapeIcs(item.activity_name)}\nLOCATION:${escapeIcs(item.activity_name)}, ${escapeIcs(destName)}\nDESCRIPTION:${escapeIcs(item.description)}\\\\n\\\\n\360\237\222\241 Insider Tip: ${escapeIcs(item.insider_tip)}\\\\n\360\237\222\260 Cost: ${escapeIcs(item.cost_tier)}\nSTATUS:CONFIRMED\nEND:VEVENT\n`;\n    });\n  });\n\n  icsContent += `END:VCALENDAR`;\n\n  downloadFile(icsContent, `${slugify(destName)}_schedule.ics`, \'text/calendar;charset=utf-8\');\n}\n\nfunction escapeXml(str: string): string {\n  return (str || \'\')\n    .replace(/&/g, \'&amp;\')\n    .replace(/</g, \'&lt;\')\n    .replace(/>/g, \'&gt;\')\n    .replace(/\"/g, \'&quot;\')\n    .replace(/\'/g, \'&apos;\');\n}\n\nfunction escapeIcs(str: string): string {\n  return (str || \'\')\n    .replace(/\\\\/g, \'\\\\\\\\\')\n    .replace(/;/g, \'\\\\;\')\n    .replace(/,/g, \'\\\\,\')\n    .replace(/\\n/g, \'\\\\n\');\n}\n\nfunction slugify(text: string): string {\n  return (text || \'trip\')\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \'_\')\n    .replace(/^_+|_+$/g, \'\');\n}\n\nfunction downloadFile(content: string, fileName: string, mimeType: string): void {\n  const blob = new Blob([content], { type: mimeType });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\'a\');\n  a.href = url;\n  a.download = fileName;\n  document.body.appendChild(a);\n  a.click();\n  document.body.removeChild(a);\n  URL.revokeObjectURL(url);\n}\n"
    }
