    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Compass, RotateCcw, Printer, Type } from \'lucide-react\';\n\ninterface NavbarProps {\n  onReset: () => void;\n  hasItinerary: boolean;\n  onPrint?: () => void;\n  isLargeText: boolean;\n  onToggleLargeText: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  onReset,\n  hasItinerary,\n  onPrint,\n  isLargeText,\n  onToggleLargeText,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b-2 border-[#1A1A1A] bg-[#F3F4F1]/95 backdrop-blur-md print:hidden\">\n      <div className=\"mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6\">\n        {/* Brand */}\n        <div\n          onClick={hasItinerary ? onReset : undefined}\n          className={`flex items-center gap-3 ${hasItinerary ? \'cursor-pointer\' : \'\'}`}\n        >\n          <div className=\"flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n            <Compass className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-lg font-black tracking-tight text-[#1A1A1A] sm:text-xl\">\n                Travel Planner\n              </h1>\n              <span className=\"hidden sm:inline-flex items-center rounded-full border border-[#1A1A1A] bg-[#C5E876] px-2.5 py-0.5 text-xs font-bold text-[#1A1A1A]\">\n                INR (\342\202\271)\n              </span>\n            </div>\n            <p className=\"text-xs font-medium text-stone-600 hidden sm:block\">\n              Accessible, geographically-clustered travel itineraries\n            </p>\n          </div>\n        </div>\n\n        {/* Actions */}\n        <div className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Senior & Accessibility friendly font size toggle */}\n          <button\n            type=\"button\"\n            onClick={onToggleLargeText}\n            className={`inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] px-3 py-1.5 text-xs font-bold shadow-[2px_2px_0px_0px_#1A1A1A] transition active:translate-x-[1px] active:translate-y-[1px] active:shadow-none ${\n              isLargeText\n                ? \'bg-[#C5E876] text-[#1A1A1A]\'\n                : \'bg-white text-[#1A1A1A] hover:bg-stone-50\'\n            }`}\n            title=\"Toggle larger font size for easier reading\"\n          >\n            <Type className=\"h-4 w-4\" />\n            <span className=\"hidden xs:inline\">{isLargeText ? \'Standard Font\' : \'Larger Font (A+)\'}</span>\n          </button>\n\n          {hasItinerary && onPrint && (\n            <button\n              type=\"button\"\n              onClick={onPrint}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-white px-3.5 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-stone-50 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none\"\n            >\n              <Printer className=\"h-4 w-4\" />\n              <span>Print / PDF</span>\n            </button>\n          )}\n\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] px-4 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#b8dd67] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none\"\n            >\n              <RotateCcw className=\"h-4 w-4\" />\n              <span>New Trip</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
