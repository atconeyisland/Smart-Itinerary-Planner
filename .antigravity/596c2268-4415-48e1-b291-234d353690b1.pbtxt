    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Sparkles,\n  Printer,\n  Compass,\n  Wallet,\n} from \'lucide-react\';\nimport { TripSummary, EstimatedCosts } from \'../types\';\nimport { getDestinationPhoto } from \'../utils/imageService\';\n\ninterface TripSummaryHeaderProps {\n  summary: TripSummary;\n  estimatedCosts: EstimatedCosts;\n  onPrintPdf: () => void;\n  isLargeText: boolean;\n}\n\nexport const TripSummaryHeader: React.FC<TripSummaryHeaderProps> = ({\n  summary,\n  estimatedCosts,\n  onPrintPdf,\n  isLargeText,\n}) => {\n  const photoUrl = summary.destination_photo || getDestinationPhoto(summary.destination);\n\n  return (\n    <div className=\"overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white shadow-[6px_6px_0px_0px_#1A1A1A]\">\n      {/* Hero Photo Banner */}\n      <div className=\"relative h-64 sm:h-80 w-full overflow-hidden bg-stone-900\">\n        <img\n          src={photoUrl}\n          alt={summary.destination}\n          referrerPolicy=\"no-referrer\"\n          className=\"h-full w-full object-cover opacity-90 transition duration-500 hover:scale-105\"\n        />\n        <div className=\"absolute inset-0 bg-linear-to-t from-stone-950/90 via-stone-950/40 to-transparent\" />\n\n        {/* Content Overlay */}\n        <div className=\"absolute inset-0 flex flex-col justify-between p-6 sm:p-8\">\n          {/* Top Badges & Actions */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"inline-flex items-center gap-1.5 rounded-full border-2 border-white/80 bg-black/70 px-3.5 py-1 text-xs font-bold text-white backdrop-blur-md\">\n                <MapPin className=\"h-3.5 w-3.5 text-[#C5E876]\" />\n                <span>{summary.destination}</span>\n              </span>\n              <span className=\"inline-flex items-center gap-1.5 rounded-full border-2 border-[#1A1A1A] bg-[#C5E876] px-3.5 py-1 text-xs font-black text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                <Calendar className=\"h-3.5 w-3.5\" />\n                <span>{summary.total_days} Days Plan</span>\n              </span>\n            </div>\n\n            {/* Print / Save PDF Button */}\n            <div className=\"print:hidden\">\n              <button\n                type=\"button\"\n                onClick={onPrintPdf}\n                className=\"inline-flex items-center gap-2 rounded-xl border-2 border-[#1A1A1A] bg-white px-4 py-2 text-xs sm:text-sm font-black text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-stone-50 active:translate-x-[1px] active:translate-y-[1px] active:shadow-none\"\n                title=\"Print or save this complete itinerary as a PDF document\"\n              >\n                <Printer className=\"h-4 w-4 text-[#1A1A1A]\" />\n                <span>Print / Save PDF</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Bottom Title & Theme */}\n          <div>\n            <h1 className=\"text-2xl sm:text-4xl font-black text-white tracking-tight drop-shadow-sm\">\n              {summary.destination}\n            </h1>\n            <p className=\"mt-1.5 max-w-3xl text-sm sm:text-base font-semibold text-stone-200 drop-shadow-xs line-clamp-2\">\n              \"{summary.theme_vibe}\"\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Summary Footer Meta in INR (\342\202\271) */}\n      <div className=\"grid grid-cols-1 divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-[#1A1A1A] bg-[#F3F4F1] sm:grid-cols-3\">\n        {/* Total Days */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n            Trip Duration\n          </span>\n          <p className=\"mt-0.5 text-base sm:text-lg font-black text-[#1A1A1A]\">\n            {summary.total_days} Full Days Planned\n          </p>\n          <p className=\"text-xs font-medium text-stone-600\">Clustered by geographic proximity</p>\n        </div>\n\n        {/* Estimated Daily Budget in INR */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n            Estimated Daily Budget\n          </span>\n          <p className=\"mt-0.5 text-base sm:text-lg font-black text-[#1A1A1A]\">\n            \342\202\271{((estimatedCosts.activities_per_day || 0) + (estimatedCosts.food_per_day || 0)).toLocaleString(\'en-IN\')} / day\n          </p>\n          <p className=\"text-xs font-medium text-stone-600\">\n            Food approx \342\202\271{(estimatedCosts.food_per_day || 0).toLocaleString(\'en-IN\')} + Activities \342\202\271{(estimatedCosts.activities_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n        </div>\n\n        {/* Budget Strategy */}\n        <div className=\"p-4 sm:p-5\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n            Budget Strategy\n          </span>\n          <p className=\"mt-0.5 text-xs sm:text-sm font-semibold text-stone-700 line-clamp-2\">\n            {summary.budget_strategy}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
