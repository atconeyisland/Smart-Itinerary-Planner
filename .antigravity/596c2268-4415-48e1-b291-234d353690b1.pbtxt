    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  Bus,\n  Luggage,\n  HeartHandshake,\n  Check,\n  AlertTriangle,\n  Accessibility,\n} from \'lucide-react\';\nimport { LocalLogisticsGuide } from \'../types\';\n\ninterface LogisticsGuideCardProps {\n  guide: LocalLogisticsGuide;\n  isLargeText: boolean;\n}\n\nexport const LogisticsGuideCard: React.FC<LogisticsGuideCardProps> = ({ guide, isLargeText }) => {\n  const titleSize = isLargeText ? \'text-lg sm:text-xl font-black\' : \'text-base sm:text-lg font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Transit Advice */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#89CFF0] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n            <Bus className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className={`${titleSize} text-[#1A1A1A]`}>Recommended Local Transit Method</h3>\n            <p className=\"text-xs font-semibold text-stone-500\">Fastest and most comfortable ways to get around</p>\n          </div>\n        </div>\n        <p className={`mt-4 font-semibold text-stone-800 ${bodySize}`}>\n          {guide.best_transit_method}\n        </p>\n      </div>\n\n      {/* Senior & Accessibility Notes */}\n      {guide.senior_and_accessibility_notes && (\n        <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-[#C5E876] p-6 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-white text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <Accessibility className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h3 className={`${titleSize} text-[#1A1A1A]`}>\n                Accessibility & Senior Comfort Notes\n              </h3>\n              <p className=\"text-xs font-bold text-stone-800\">Special assistance, elevators & walking ease</p>\n            </div>\n          </div>\n          <p className={`mt-3 font-semibold text-[#1A1A1A] ${bodySize}`}>\n            {guide.senior_and_accessibility_notes}\n          </p>\n        </div>\n      )}\n\n      {/* Grid: Etiquette & Packing */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2\">\n        {/* Cultural Etiquette */}\n        <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A] space-y-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <HeartHandshake className=\"h-5 w-5\" />\n            </div>\n            <h3 className={`${titleSize} text-[#1A1A1A]`}>Local Etiquette & Customs</h3>\n          </div>\n          <ul className=\"space-y-2.5\">\n            {guide.cultural_etiquette_alerts.map((item, idx) => (\n              <li key={idx} className={`flex items-start gap-2.5 ${bodySize} font-medium text-stone-800`}>\n                <AlertTriangle className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n                <span>{item}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Packing Essentials */}\n        <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[4px_4px_0px_0px_#1A1A1A] space-y-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <Luggage className=\"h-5 w-5\" />\n            </div>\n            <h3 className={`${titleSize} text-[#1A1A1A]`}>Packing Essentials</h3>\n          </div>\n          <ul className=\"space-y-2.5\">\n            {guide.packing_essentials.map((item, idx) => (\n              <li key={idx} className={`flex items-start gap-2.5 ${bodySize} font-medium text-stone-800`}>\n                <Check className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n                <span>{item}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
