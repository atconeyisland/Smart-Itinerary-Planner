  file_change {
    absolute_path_uri: "file:///src/components/PlannerForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Users,\n  Wallet,\n  Zap,\n  Heart,\n  ShieldCheck,\n  Sparkles,\n  ArrowRight,\n  BookmarkCheck,\n  Check,\n  Info,\n} from \'lucide-react\';\nimport { PlannerInputs } from \'../types\';\nimport { SAMPLE_PRESETS } from \'../sampleData\';\n\ninterface PlannerFormProps {\n  inputs: PlannerInputs;\n  onChange: (inputs: PlannerInputs) => void;\n  onSubmit: (e: React.FormEvent) => void;\n  isLoading: boolean;\n  onSelectPreset: (presetIndex: number) => void;\n  isLargeText: boolean;\n}\n\nconst COMMON_INTERESTS = [\n  \'Historic Forts & Palaces\',\n  \'Temples & Sacred Sites\',\n  \'Authentic Local Food & Thalis\',\n  \'Peaceful Gardens & Nature\',\n  \'Local Bazaars & Shopping\',\n  \'Museums & Cultural Art\',\n  \'Scenic Views & Sunset Points\',\n  \'Folk Dance & Music Shows\',\n  \'Tea / Coffee Tasting\',\n  \'Lakes & Boat Rides\',\n];\n\nconst ACCESSIBILITY_OPTIONS = [\n  \'Senior citizen friendly (easy walking & elevators)\',\n  \'Pure vegetarian food options\',\n  \'Wheelchair / battery vehicle accessible\',\n  \'Minimal stairs & frequent rest stops\',\n  \'Early riser morning schedule\',\n  \'AC private cab transit preferred\',\n  \'Jain food friendly\',\n  \'Family with young kids friendly\',\n];\n\nconst DESTINATION_SUGGESTIONS = [\n  \'Jaipur, Rajasthan, India\',\n  \'Varanasi, Uttar Pradesh, India\',\n  \'Kerala (Munnar & Alleppey), India\',\n  \'Udaipur, Rajasthan, India\',\n  \'Goa, India\',\n  \'Kyoto, Japan\',\n  \'Paris, France\',\n  \'Rome, Italy\',\n  \'Singapore\',\n  \'Dubai, UAE\',\n  \'Bangkok, Thailand\',\n];\n\nconst BUDGET_OPTIONS = [\n  {\n    id: \'Pocket-Friendly (\342\202\2711,500 - \342\202\2713,500/day)\',\n    title: \'Pocket-Friendly\',\n    range: \'\342\202\2711,500 \342\200\223 \342\202\2713,500 per day\',\n    desc: \'Comfortable budget hotels, local transport, street food & popular eateries\',\n  },\n  {\n    id: \'Comfort & Moderate (\342\202\2714,000 - \342\202\2719,000/day)\',\n    title: \'Comfort / Standard\',\n    range: \'\342\202\2714,000 \342\200\223 \342\202\2719,000 per day\',\n    desc: \'3-4 star heritage hotels, AC cabs, quality dining & guided monument visits\',\n  },\n  {\n    id: \'Luxury & Heritage (\342\202\27110,000 - \342\202\27125,000+/day)\',\n    title: \'Premium / Luxury\',\n    range: \'\342\202\27110,000 \342\200\223 \342\202\27125,000+ per day\',\n    desc: \'5-star royal palaces, private chauffeured car, fine dining & VIP experiences\',\n  },\n];\n\nconst PACE_OPTIONS = [\n  {\n    id: \'Relaxed (Senior & Family Friendly)\',\n    title: \'Relaxed & Comfortable\',\n    desc: \'Ample rest stops, gentle pacing, minimal rush (ideal for seniors & families)\',\n  },\n  {\n    id: \'Balanced\',\n    title: \'Balanced\',\n    desc: \'2\342\200\2233 pleasant spots per day with relaxed meal breaks and afternoon rest\',\n  },\n  {\n    id: \'Active Sightseeing\',\n    title: \'Active Sightseeing\',\n    desc: \'Cover maximum key attractions and viewpoints throughout the day\',\n  },\n];\n\nconst TRAVELER_OPTIONS = [\n  \'Family with Senior Citizens & Kids\',\n  \'Senior Couple / Retired Travelers\',\n  \'Couple / Honeymoon\',\n  \'Solo Traveler\',\n  \'Family with Teenagers\',\n  \'Group of Friends\',\n];\n\nexport const PlannerForm: React.FC<PlannerFormProps> = ({\n  inputs,\n  onChange,\n  onSubmit,\n  isLoading,\n  onSelectPreset,\n  isLargeText,\n}) => {\n  const [customInterest, setCustomInterest] = useState(\'\');\n  const [customConstraint, setCustomConstraint] = useState(\'\');\n\n  const currentInterestsList = inputs.interests\n    ? inputs.interests.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const currentConstraintsList = inputs.constraints\n    ? inputs.constraints.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const toggleInterest = (interest: string) => {\n    let updated: string[];\n    if (currentInterestsList.includes(interest)) {\n      updated = currentInterestsList.filter((i) => i !== interest);\n    } else {\n      updated = [...currentInterestsList, interest];\n    }\n    onChange({ ...inputs, interests: updated.join(\', \') });\n  };\n\n  const addCustomInterest = () => {\n    if (customInterest.trim() && !currentInterestsList.includes(customInterest.trim())) {\n      const updated = [...currentInterestsList, customInterest.trim()];\n      onChange({ ...inputs, interests: updated.join(\', \') });\n      setCustomInterest(\'\');\n    }\n  };\n\n  const toggleConstraint = (constraint: string) => {\n    let updated: string[];\n    if (currentConstraintsList.includes(constraint)) {\n      updated = currentConstraintsList.filter((c) => c !== constraint);\n    } else {\n      updated = [...currentConstraintsList, constraint];\n    }\n    onChange({ ...inputs, constraints: updated.join(\', \') });\n  };\n\n  const addCustomConstraint = () => {\n    if (customConstraint.trim() && !currentConstraintsList.includes(customConstraint.trim())) {\n      const updated = [...currentConstraintsList, customConstraint.trim()];\n      onChange({ ...inputs, constraints: updated.join(\', \') });\n      setCustomConstraint(\'\');\n    }\n  };\n\n  const textSize = isLargeText ? \'text-base sm:text-lg\' : \'text-sm sm:text-base\';\n  const labelSize = isLargeText ? \'text-base font-bold\' : \'text-sm font-semibold\';\n\n  return (\n    <div className=\"mx-auto max-w-4xl space-y-8\">\n      {/* Sample Ready-Made Trips Banner */}\n      <div className=\"rounded-2xl border border-amber-200 bg-amber-50/70 p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\">\n          <div className=\"flex items-start gap-3.5\">\n            <div className=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-500 text-white shadow-xs\">\n              <BookmarkCheck className=\"h-6 w-6\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-stone-900 sm:text-lg\">\n                Ready-Made Sample Itineraries\n              </h2>\n              <p className=\"text-xs sm:text-sm text-stone-600\">\n                Click to explore complete itineraries with stays, food, and survival phrases in INR (\342\202\271)\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2\">\n            {SAMPLE_PRESETS.map((preset, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => onSelectPreset(idx)}\n                className=\"inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-white px-4 py-2 text-xs sm:text-sm font-semibold text-stone-800 shadow-xs transition hover:bg-amber-100 hover:border-amber-400\"\n              >\n                <span>{preset.label.split(\' \')[0]}</span>\n                <span className=\"rounded-md bg-amber-100 px-1.5 py-0.5 text-[11px] font-bold text-amber-900\">\n                  {preset.inputs.duration} Days\n                </span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Main Planning Form */}\n      <form onSubmit={onSubmit} className=\"rounded-3xl border border-stone-200 bg-white p-6 sm:p-10 shadow-sm space-y-8\">\n        <div>\n          <h2 className=\"text-xl font-bold tracking-tight text-stone-900 sm:text-2xl\">\n            Where would you like to travel?\n          </h2>\n          <p className=\"mt-1 text-sm text-stone-500\">\n            Fill in your details below and our engine will craft a comfortable, geographically-organized travel plan with pricing in Indian Rupees (\342\202\271).\n          </p>\n        </div>\n\n        {/* Section 1: Destination & Duration */}\n        <div className=\"grid grid-cols-1 gap-6 sm:grid-cols-12\">\n          {/* Destination */}\n          <div className=\"sm:col-span-8\">\n            <label className={`block ${labelSize} text-stone-800 mb-2`}>\n              <span className=\"flex items-center gap-2\">\n                <MapPin className=\"h-4 w-4 text-amber-600\" />\n                Destination City / Region\n              </span>\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={inputs.destination}\n              onChange={(e) => onChange({ ...inputs, destination: e.target.value })}\n              placeholder=\"e.g. Jaipur, Rajasthan, India or Kyoto, Japan\"\n              className={`w-full rounded-xl border border-stone-300 bg-stone-50/50 px-4 py-3.5 ${textSize} text-stone-900 placeholder:text-stone-400 focus:border-amber-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500/20`}\n            />\n\n            {/* Quick Suggestions */}\n            <div className=\"mt-2.5 flex flex-wrap items-center gap-1.5\">\n              <span className=\"text-xs font-medium text-stone-400\">Popular:</span>\n              {DESTINATION_SUGGESTIONS.slice(0, 6).map((dest) => (\n                <button\n                  key={dest}\n                  type=\"button\"\n                  onClick={() => onChange({ ...inputs, destination: dest })}\n                  className=\"rounded-lg bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600 transition hover:bg-amber-100 hover:text-amber-900\"\n                >\n                  {dest.split(\',\')[0]}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Duration */}\n          <div className=\"sm:col-span-4\">\n            <label className={`block ${labelSize} text-stone-800 mb-2`}>\n              <span className=\"flex items-center gap-2\">\n                <Calendar className=\"h-4 w-4 text-amber-600\" />\n                Trip Duration (Days)\n              </span>\n            </label>\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"number\"\n                min={1}\n                max={14}\n                required\n                value={inputs.duration}\n                onChange={(e) => onChange({ ...inputs, duration: Math.max(1, Math.min(14, parseInt(e.target.value) || 1)) })}\n                className={`w-full rounded-xl border border-stone-300 bg-stone-50/50 px-4 py-3.5 text-center font-bold ${textSize} text-stone-900 focus:border-amber-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500/20`}\n              />\n              <span className=\"text-sm font-semibold text-stone-600 shrink-0\">Days</span>\n            </div>\n            <div className=\"mt-2 flex justify-between gap-1\">\n              {[2, 3, 4, 5, 7].map((days) => (\n                <button\n                  key={days}\n                  type=\"button\"\n                  onClick={() => onChange({ ...inputs, duration: days })}\n                  className={`flex-1 rounded-lg py-1 text-xs font-semibold transition ${\n                    inputs.duration === days\n                      ? \'bg-amber-500 text-white\'\n                      : \'bg-stone-100 text-stone-600 hover:bg-stone-200\'\n                  }`}\n                >\n                  {days}d\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Section 2: Travelers & Pace */}\n        <div className=\"grid grid-cols-1 gap-6 sm:grid-cols-2\">\n          {/* Travelers */}\n          <div>\n            <label className={`block ${labelSize} text-stone-800 mb-2`}>\n              <span className=\"flex items-center gap-2\">\n                <Users className=\"h-4 w-4 text-amber-600\" />\n                Who is Traveling?\n              </span>\n            </label>\n            <select\n              value={inputs.travelers}\n              onChange={(e) => onChange({ ...inputs, travelers: e.target.value })}\n              className={`w-full rounded-xl border border-stone-300 bg-stone-50/50 px-4 py-3.5 ${textSize} text-stone-900 focus:border-amber-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500/20`}\n            >\n              {TRAVELER_OPTIONS.map((opt) => (\n                <option key={opt} value={opt}>\n                  {opt}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Travel Pace */}\n          <div>\n            <label className={`block ${labelSize} text-stone-800 mb-2`}>\n              <span className=\"flex items-center gap-2\">\n                <Zap className=\"h-4 w-4 text-amber-600\" />\n                Travel Pace\n              </span>\n            </label>\n            <select\n              value={inputs.pace}\n              onChange={(e) => onChange({ ...inputs, pace: e.target.value })}\n              className={`w-full rounded-xl border border-stone-300 bg-stone-50/50 px-4 py-3.5 ${textSize} text-stone-900 focus:border-amber-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-amber-500/20`}\n            >\n              {PACE_OPTIONS.map((p) => (\n                <option key={p.id} value={p.id}>\n                  {p.title} - {p.desc}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Section 3: Budget in INR (\342\202\271) */}\n        <div>\n          <label className={`block ${labelSize} text-stone-800 mb-3`}>\n            <span className=\"flex items-center gap-2\">\n              <Wallet className=\"h-4 w-4 text-amber-600\" />\n              Budget Preference in Indian Rupees (INR / \342\202\271)\n            </span>\n          </label>\n          <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-3\">\n            {BUDGET_OPTIONS.map((b) => {\n              const isSelected = inputs.budget.includes(b.title) || inputs.budget === b.id;\n              return (\n                <button\n                  key={b.id}\n                  type=\"button\"\n                  onClick={() => onChange({ ...inputs, budget: b.id })}\n                  className={`flex flex-col items-start rounded-2xl border p-4 text-left transition ${\n                    isSelected\n                      ? \'border-amber-500 bg-amber-50/60 ring-2 ring-amber-500/30\'\n                      : \'border-stone-200 bg-stone-50/50 hover:bg-stone-100/70\'\n                  }`}\n                >\n                  <div className=\"flex w-full items-center justify-between\">\n                    <span className=\"font-bold text-stone-900 text-sm sm:text-base\">{b.title}</span>\n                    {isSelected && (\n                      <span className=\"flex h-5 w-5 items-center justify-center rounded-full bg-amber-500 text-white\">\n                        <Check className=\"h-3.5 w-3.5\" />\n                      </span>\n                    )}\n                  </div>\n                  <span className=\"mt-1 font-bold text-emerald-700 text-xs sm:text-sm\">{b.range}</span>\n                  <span className=\"mt-1 text-xs text-stone-500 leading-relaxed\">{b.desc}</span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Section 4: What interests you? */}\n        <div>\n          <label className={`block ${labelSize} text-stone-800 mb-2`}>\n            <span className=\"flex items-center gap-2\">\n              <Heart className=\"h-4 w-4 text-amber-600\" />\n              What would you love to experience? (Select any)\n            </span>\n          </label>\n          <div className=\"flex flex-wrap gap-2 pt-1\">\n            {COMMON_INTERESTS.map((interest) => {\n              const isSelected = currentInterestsList.includes(interest);\n              return (\n                <button\n                  key={interest}\n                  type=\"button\"\n                  onClick={() => toggleInterest(interest)}\n                  className={`inline-flex items-center gap-1.5 rounded-xl border px-3.5 py-2 text-xs sm:text-sm font-medium transition ${\n                    isSelected\n                      ? \'border-amber-500 bg-amber-500 text-white shadow-xs\'\n                      : \'border-stone-200 bg-stone-50 text-stone-700 hover:bg-stone-100\'\n                  }`}\n                >\n                  {isSelected && <Check className=\"h-3.5 w-3.5\" />}\n                  <span>{interest}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"mt-3 flex items-center gap-2\">\n            <input\n              type=\"text\"\n              value={customInterest}\n              onChange={(e) => setCustomInterest(e.target.value)}\n              onKeyDown={(e) => {\n                if (e.key === \'Enter\') {\n                  e.preventDefault();\n                  addCustomInterest();\n                }\n              }}\n              placeholder=\"Type other interests (e.g. Photography, Ayurveda, Shopping)...\"\n              className=\"flex-1 rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-2.5 text-xs sm:text-sm text-stone-900 focus:border-amber-500 focus:bg-white focus:outline-hidden\"\n            />\n            <button\n              type=\"button\"\n              onClick={addCustomInterest}\n              className=\"rounded-xl bg-stone-800 px-4 py-2.5 text-xs sm:text-sm font-semibold text-white transition hover:bg-stone-900\"\n            >\n              Add\n            </button>\n          </div>\n        </div>\n\n        {/* Section 5: Accessibility & Dietary Preferences */}\n        <div>\n          <label className={`block ${labelSize} text-stone-800 mb-2`}>\n            <span className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"h-4 w-4 text-emerald-600\" />\n              Special Care, Accessibility & Dietary Needs\n            </span>\n          </label>\n          <div className=\"flex flex-wrap gap-2 pt-1\">\n            {ACCESSIBILITY_OPTIONS.map((item) => {\n              const isSelected = currentConstraintsList.includes(item);\n              return (\n                <button\n                  key={item}\n                  type=\"button\"\n                  onClick={() => toggleConstraint(item)}\n                  className={`inline-flex items-center gap-1.5 rounded-xl border px-3.5 py-2 text-xs sm:text-sm font-medium transition ${\n                    isSelected\n                      ? \'border-emerald-600 bg-emerald-600 text-white shadow-xs\'\n                      : \'border-stone-200 bg-stone-50 text-stone-700 hover:bg-stone-100\'\n                  }`}\n                >\n                  {isSelected && <Check className=\"h-3.5 w-3.5\" />}\n                  <span>{item}</span>\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"mt-3 flex items-center gap-2\">\n            <input\n              type=\"text\"\n              value={customConstraint}\n              onChange={(e) => setCustomConstraint(e.target.value)}\n              onKeyDown={(e) => {\n                if (e.key === \'Enter\') {\n                  e.preventDefault();\n                  addCustomConstraint();\n                }\n              }}\n              placeholder=\"Any other special preferences or health needs (e.g. Ground floor room, No spicy food)...\"\n              className=\"flex-1 rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-2.5 text-xs sm:text-sm text-stone-900 focus:border-emerald-600 focus:bg-white focus:outline-hidden\"\n            />\n            <button\n              type=\"button\"\n              onClick={addCustomConstraint}\n              className=\"rounded-xl bg-stone-800 px-4 py-2.5 text-xs sm:text-sm font-semibold text-white transition hover:bg-stone-900\"\n            >\n              Add\n            </button>\n          </div>\n        </div>\n\n        {/* Submit Action */}\n        <div className=\"pt-4\">\n          <button\n            type=\"submit\"\n            disabled={isLoading}\n            className=\"flex w-full items-center justify-center gap-2 rounded-2xl bg-amber-500 py-4 px-6 text-base sm:text-lg font-bold text-white shadow-md transition hover:bg-amber-600 active:scale-98 disabled:opacity-50\"\n          >\n            {isLoading ? (\n              <>\n                <div className=\"h-5 w-5 animate-spin rounded-full border-2 border-white border-t-transparent\" />\n                <span>Designing Your Personalized Plan...</span>\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"h-5 w-5\" />\n                <span>Generate My Travel Itinerary (in \342\202\271)</span>\n                <ArrowRight className=\"h-5 w-5\" />\n              </>\n            )}\n          </button>\n          <p className=\"mt-2 text-center text-xs text-stone-400\">\n            Calculates geographic neighborhood clustering, meal breaks & pricing in INR\n          </p>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
    }
