    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Wallet, Info } from \'lucide-react\';\nimport { EstimatedCosts } from \'../types\';\n\ninterface CostBreakdownCardProps {\n  costs: EstimatedCosts;\n  totalDays: number;\n  isLargeText: boolean;\n}\n\nexport const CostBreakdownCard: React.FC<CostBreakdownCardProps> = ({\n  costs,\n  totalDays,\n  isLargeText,\n}) => {\n  const dailyTotal = (costs.activities_per_day || 0) + (costs.food_per_day || 0);\n  const tripTotal = dailyTotal * totalDays;\n\n  const titleSize = isLargeText ? \'text-xl font-black\' : \'text-lg font-black\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[6px_6px_0px_0px_#1A1A1A] space-y-5\">\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2.5\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n            <Wallet className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className={`${titleSize} text-[#1A1A1A]`}>Estimated Expense Breakdown</h3>\n            <p className=\"text-xs font-semibold text-stone-500\">Excludes long-distance flights/trains & accommodation</p>\n          </div>\n        </div>\n        <span className=\"rounded-full border border-[#1A1A1A] bg-[#C5E876] px-2.5 py-0.5 text-xs font-black text-[#1A1A1A]\">\n          INR (\342\202\271)\n        </span>\n      </div>\n\n      {/* Figures Grid */}\n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-3\">\n        {/* Daily Food */}\n        <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] p-4 shadow-[3px_3px_0px_0px_#1A1A1A]\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n            Meals & Dining / Day\n          </span>\n          <p className=\"mt-1 text-2xl font-black text-[#1A1A1A]\">\n            \342\202\271{(costs.food_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs font-medium text-stone-600\">Per person daily average</p>\n        </div>\n\n        {/* Daily Activities */}\n        <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] p-4 shadow-[3px_3px_0px_0px_#1A1A1A]\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n            Sightseeing & Admissions / Day\n          </span>\n          <p className=\"mt-1 text-2xl font-black text-[#1A1A1A]\">\n            \342\202\271{(costs.activities_per_day || 0).toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs font-medium text-stone-600\">Monuments, passes & tickets</p>\n        </div>\n\n        {/* Total Estimate */}\n        <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] p-4 shadow-[3px_3px_0px_0px_#1A1A1A]\">\n          <span className=\"text-xs font-black uppercase tracking-wider text-[#1A1A1A]\">\n            Total {totalDays}-Day Estimate\n          </span>\n          <p className=\"mt-1 text-2xl font-black text-[#1A1A1A]\">\n            \342\202\271{tripTotal.toLocaleString(\'en-IN\')}\n          </p>\n          <p className=\"text-xs font-bold text-[#1A1A1A]\">Daily avg \342\202\271{dailyTotal.toLocaleString(\'en-IN\')}</p>\n        </div>\n      </div>\n\n      {/* Hidden fees advisory */}\n      {costs.hidden_fees_notes && (\n        <div className=\"rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-4 shadow-[3px_3px_0px_0px_#1A1A1A]\">\n          <div className=\"flex items-start gap-2.5\">\n            <Info className=\"mt-0.5 h-4 w-4 shrink-0 text-[#1A1A1A]\" />\n            <div>\n              <p className=\"text-xs font-black text-[#1A1A1A] uppercase tracking-wider\">\n                Passes, Taxes & Local Advisory\n              </p>\n              <p className={`mt-0.5 font-semibold text-stone-900 ${bodySize}`}>\n                {costs.hidden_fees_notes}\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
