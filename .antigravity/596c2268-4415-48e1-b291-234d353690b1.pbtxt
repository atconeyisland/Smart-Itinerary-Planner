<Lightbulb className=\"h-3 w-3 text-amber-700\" />\n                  {fact.tag}\n                </span>\n                <span className=\"text-xs font-bold text-stone-300\">#{idx + 1}</span>\n              </div>\n              <h3 className={`mt-2.5 font-bold text-stone-900 ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                {fact.title}\n              </h3>\n              <p className={`mt-2 text-stone-600 leading-relaxed ${bodySize}`}>\n                {fact.fact}\n              </p>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
