      replacement_content: "import React, { useState } from \'react\';\nimport { Plane, Navigation, ExternalLink, Clock, ShieldCheck, DollarSign, ArrowRight, Luggage, MapPin, Compass } from \'lucide-react\';\nimport { ItineraryPlanResponse } from \'../types\';\nimport { getCurrencySymbol } from \'../utils/currencyUtils\';\n\ninterface FlightFinderSectionProps {\n  plan: ItineraryPlanResponse;\n  initialOrigin?: string;\n}\n\nconst GLOBAL_AIRPORT_HUBS = [\n  { code: \'NYC\', name: \'New York (JFK/EWR)\', country: \'USA\' },\n  { code: \'LON\', name: \'London (LHR/LGW)\', country: \'UK\' },\n  { code: \'DEL\', name: \'New Delhi (DEL)\', country: \'India\' },\n  { code: \'BOM\', name: \'Mumbai (BOM)\', country: \'India\' },\n  { code: \'DXB\', name: \'Dubai (DXB)\', country: \'UAE\' },\n  { code: \'SIN\', name: \'Singapore (SIN)\', country: \'Singapore\' },\n  { code: \'TYO\', name: \'Tokyo (HND/NRT)\', country: \'Japan\' },\n  { code: \'PAR\', name: \'Paris (CDG/ORY)\', country: \'France\' },\n  { code: \'FRA\', name: \'Frankfurt (FRA)\', country: \'Germany\' },\n  { code: \'SYD\', name: \'Sydney (SYD)\', country: \'Australia\' },\n  { code: \'SFO\', name: \'San Francisco (SFO)\', country: \'USA\' },\n  { code: \'LAX\', name: \'Los Angeles (LAX)\', country: \'USA\' },\n  { code: \'YYZ\', name: \'Toronto (YYZ)\', country: \'Canada\' },\n];\n\nexport const FlightFinderSection: React.FC<FlightFinderSectionProps> = ({ plan, initialOrigin = \'New York (JFK)\' }) => {\n  const [selectedOrigin, setSelectedOrigin] = useState<string>(initialOrigin);\n  const [customOriginInput, setCustomOriginInput] = useState<string>(\'\');\n\n  const destCity = plan.trip_summary.destination.split(\',\')[0].trim();\n  const destCountry = plan.trip_summary.country || plan.trip_summary.destination.split(\',\').pop()?.trim() || \'\';\n  const currencySymbol = getCurrencySymbol(plan.estimated_costs.currency);\n\n  const flightInfo = plan.flight_analysis;\n  const destinationAirports = flightInfo?.destination_airports || [\n    {\n      code: \'DEST\',\n      name: `${destCity} International Airport`,\n      city: destCity,\n      distance_from_center_km: 25,\n    },\n  ];\n\n  // Active origin name for links\n  const activeOrigin = customOriginInput.trim() || selectedOrigin;\n\n  // External flight search generators\n  const googleFlightsUrl = `https://www.google.com/travel/flights?q=Flights%20to%20${encodeURIComponent(\n    destCity\n  )}%20from%20${encodeURIComponent(activeOrigin)}`;\n\n  const skyscannerUrl = `https://www.skyscanner.com/transport/flights?query=${encodeURIComponent(\n    `${activeOrigin} to ${destCity}`\n  )}`;\n\n  const kayakUrl = `https://www.kayak.com/flights/${encodeURIComponent(activeOrigin)}-${encodeURIComponent(\n    destCity\n  )}`;\n\n  return (\n    <div id=\"flight-finder-section\" className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-6 bg-[#FAF9F5]\">\n        <div className=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-3 bg-[#3B82F6] text-white border-2 border-[#1A1A1A] rounded-2xl shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <Plane className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <h2 className=\"text-2xl font-black text-[#1A1A1A] tracking-tight\">\n                Flights & Airport Transit Guide\n              </h2>\n              <p className=\"text-sm font-medium text-[#4A5568]\">\n                Find the best airline routes, duration estimates, airport transfer guides, and direct Google Flights search for{\' \'}\n                <span className=\"font-bold text-[#1A1A1A]\">{plan.trip_summary.destination}</span>.\n              </p>\n            </div>\n          </div>\n\n          {/* Direct Search Actions */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <a\n              href={googleFlightsUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              id=\"btn-google-flights\"\n              className=\"flex items-center gap-2 px-4 py-2.5 bg-[#3B82F6] hover:bg-[#2563EB] text-white text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n            >\n              <Plane className=\"w-4 h-4\" />\n              <span>Search on Google Flights</span>\n              <ExternalLink className=\"w-3.5 h-3.5 opacity-80\" />\n            </a>\n\n            <a\n              href={skyscannerUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center gap-2 px-3.5 py-2.5 bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n            >\n              <span>Skyscanner</span>\n              <ExternalLink className=\"w-3.5 h-3.5 text-[#718096]\" />\n            </a>\n          </div>\n        </div>\n\n        {/* Departure Origin Selector */}\n        <div className=\"mt-6 pt-6 border-t-2 border-[#1A1A1A]\">\n          <label className=\"block text-xs font-black uppercase tracking-wider text-[#1A1A1A] mb-2\">\n            Select Your Departure City / Hub:\n          </label>\n          <div className=\"flex flex-wrap items-center gap-2 mb-3\">\n            {GLOBAL_AIRPORT_HUBS.map((hub) => {\n              const isSelected = selectedOrigin.includes(hub.code) || selectedOrigin.includes(hub.name);\n              return (\n                <button\n                  key={hub.code}\n                  onClick={() => {\n                    setSelectedOrigin(`${hub.name}`);\n                    setCustomOriginInput(\'\');\n                  }}\n                  className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-xl transition-all ${\n                    isSelected && !customOriginInput\n                      ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#3B82F6]\'\n                      : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n                  }`}\n                >\n                  <span className=\"font-extrabold text-[#3B82F6] mr-1\">{hub.code}</span> {hub.name.split(\'(\')[0]}\n                </button>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-2 max-w-md\">\n            <input\n              type=\"text\"\n              placeholder=\"Or type any city (e.g. Manchester, Chicago, Bengaluru)...\"\n              value={customOriginInput}\n              onChange={(e) => setCustomOriginInput(e.target.value)}\n              className=\"flex-1 px-3 py-2 text-xs font-semibold bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#3B82F6]\"\n            />\n            {customOriginInput && (\n              <button\n                onClick={() => setCustomOriginInput(\'\')}\n                className=\"px-2 py-1 text-xs font-bold text-[#718096] hover:text-[#1A1A1A]\"\n              >\n                Clear\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Flight Route Overview Card */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Destination Airports */}\n        <div className=\"bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-5\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <span className=\"p-2 bg-[#E0E7FF] border-2 border-[#1A1A1A] rounded-xl\">\n              <Compass className=\"w-4 h-4 text-[#4338CA]\" />\n            </span>\n            <h3 className=\"font-black text-lg text-[#1A1A1A]\">Destination Airports</h3>\n          </div>\n\n          <div className=\"space-y-3\">\n            {destinationAirports.map((airport, i) => (\n              <div\n                key={`airport_${i}`}\n                className=\"p-3 bg-[#FAF9F5] border-2 border-[#1A1A1A] rounded-xl\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"px-2 py-0.5 bg-[#3B82F6] text-white text-xs font-black rounded-md border border-[#1A1A1A]\">\n                    {airport.code}\n                  </span>\n                  {airport.distance_from_center_km && (\n                    <span className=\"text-xs font-bold text-[#718096]\">\n                      \360\237\223\215 ~{airport.distance_from_center_km} km to center\n                    </span>\n                  )}\n                </div>\n                <div className=\"font-black text-sm text-[#1A1A1A] mt-1.5\">{airport.name}</div>\n                <div className=\"text-xs text-[#718096]\">{airport.city}</div>\n              </div>\n            ))}\n          </div>\n\n          {/* Quick flight search buttons */}\n          <div className=\"mt-4 pt-4 border-t border-[#E2E8F0] space-y-2\">\n            <a\n              href={googleFlightsUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full flex items-center justify-center gap-2 py-2 bg-[#3B82F6] hover:bg-[#2563EB] text-white text-xs font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A]\"\n            >\n              <span>View live flights on Google Flights</span>\n              <ExternalLink className=\"w-3 h-3\" />\n            </a>\n            <a\n              href={kayakUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full flex items-center justify-center gap-2 py-2 bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] text-xs font-bold border-2 border-[#1A1A1A] rounded-xl\"\n            >\n              <span>Compare prices on Kayak</span>\n              <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n        </div>\n\n        {/* Popular Route Estimates & Airlines */}\n        <div className=\"lg:col-span-2 bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-5\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <span className=\"p-2 bg-[#FEF3C7] border-2 border-[#1A1A1A] rounded-xl\">\n              <Clock className=\"w-4 h-4 text-[#D97706]\" />\n            </span>\n            <h3 className=\"font-black text-lg text-[#1A1A1A]\">\n              Flight Durations & Typical Fares from Major Hubs\n            </h3>\n          </div>\n\n          <div className=\"space-y-3\">\n            {(flightInfo?.popular_routes && flightInfo.popular_routes.length > 0\n              ? flightInfo.popular_routes\n              : [\n                  {\n                    origin_city: \'New York (JFK/EWR)\',\n                    origin_code: \'NYC\',\n                    avg_duration_hours: \'7h - 14h (depends on region)\',\n                    typical_airlines: [\'Delta\', \'United\', \'Emirates\', \'Air France\', \'ANA\'],\n                    is_direct_available: true,\n                    est_economy_fare: \'$650 - $1,100\',\n                    est_business_fare: \'$2,800 - $4,500\',\n                  },\n                  {\n                    origin_city: \'London (LHR)\',\n                    origin_code: \'LON\',\n                    avg_duration_hours: \'2h - 11h\',\n                    typical_airlines: [\'British Airways\', \'Virgin Atlantic\', \'Emirates\', \'Qatar Airways\'],\n                    is_direct_available: true,\n                    est_economy_fare: \'\302\243450 - \302\243850\',\n                    est_business_fare: \'\302\2432,200 - \302\2433,800\',\n                  },\n                  {\n                    origin_city: \'New Delhi (DEL)\',\n                    origin_code: \'DEL\',\n                    avg_duration_hours: \'4h - 9h\',\n                    typical_airlines: [\'Air India\', \'IndiGo\', \'Emirates\', \'Singapore Airlines\'],\n                    is_direct_available: true,\n                    est_economy_fare: \'\342\202\27125,000 - \342\202\27155,000\',\n                    est_business_fare: \'\342\202\27185,000 - \342\202\2711,60,000\',\n                  },\n                ]\n            ).map((route, idx) => (\n              <div\n                key={`route_${idx}`}\n                className=\"p-3.5 bg-[#FAF9F5] border-2 border-[#1A1A1A] rounded-xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\"\n              >\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-black text-sm text-[#1A1A1A]\">{route.origin_city}</span>\n                    <ArrowRight className=\"w-3.5 h-3.5 text-[#718096]\" />\n                    <span className=\"font-black text-sm text-[#3B82F6]\">{destCity}</span>\n                    {route.is_direct_available && (\n                      <span className=\"px-2 py-0.5 bg-[#DCFCE7] text-[#166534] text-[10px] font-black rounded border border-[#86EFAC]\">\n                        Direct Flights Available\n                      </span>\n                    )}\n                  </div>\n\n                  <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#4A5568] mt-1.5\">\n                    <span className=\"flex items-center gap-1 font-medium\">\n                      \342\217\261\357\270\217 <strong>Duration:</strong> {route.avg_duration_hours}\n                    </span>\n                    <span className=\"flex items-center gap-1 font-medium\">\n                      \342\234\210\357\270\217 <strong>Airlines:</strong> {route.typical_airlines.join(\', \')}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"sm:text-right flex-shrink-0\">\n                  <div className=\"text-xs font-black text-[#10B981]\">\n                    Econ: {route.est_economy_fare}\n                  </div>\n                  {route.est_business_fare && (\n                    <div className=\"text-[11px] text-[#718096] font-medium\">\n                      Biz: {route.est_business_fare}\n                    </div>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Airport Ground Transfer & Visa Guidance */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Airport Transfer Guide */}\n        <div className=\"bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-5\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <span className=\"p-2 bg-[#DCFCE7] border-2 border-[#1A1A1A] rounded-xl\">\n              <Navigation className=\"w-4 h-4 text-[#166534]\" />\n            </span>\n            <h3 className=\"font-black text-base text-[#1A1A1A]\">Airport Ground Transfers</h3>\n          </div>\n          <p className=\"text-xs sm:text-sm text-[#4A5568] leading-relaxed\">\n            {flightInfo?.airport_transfer_guide ||\n              `Upon arrival at ${destCity}, official airport express trains/metro, pre-paid taxi booths, and app-based rideshares (Uber/local apps) are available directly outside baggage claim.`}\n          </p>\n\n          <div className=\"mt-4 p-3 bg-[#EFF6FF] border-2 border-[#3B82F6] rounded-xl text-xs text-[#1E40AF] font-medium\">\n            \360\237\222\241 <strong>Senior & Accessibility Tip:</strong> Request pre-arranged airport wheelchair assistance through your airline 48 hours before departure.\n          </div>\n        </div>\n\n        {/* Booking Window & Visa/Transit Notes */}\n        <div className=\"bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-5\">\n          <div className=\"flex items-center gap-2 mb-3\">\n            <span className=\"p-2 bg-[#FEE2E2] border-2 border-[#1A1A1A] rounded-xl\">\n              <ShieldCheck className=\"w-4 h-4 text-[#DC2626]\" />\n            </span>\n            <h3 className=\"font-black text-base text-[#1A1A1A]\">Booking Strategy & Entry Requirements</h3>\n          </div>\n\n          <div className=\"space-y-3 text-xs sm:text-sm text-[#4A5568]\">\n            <p>\n              <strong>Best Time to Book:</strong>{\' \'}\n              {flightInfo?.booking_lead_time_tips ||\n                \'Book international flights 8\342\200\22312 weeks in advance for regular seasons, and 4\342\200\2235 months in advance for peak festival holidays.\'}\n            </p>\n            {flightInfo?.visa_and_transit_notes && (\n              <p>\n                <strong>Visa & Entry:</strong> {flightInfo.visa_and_transit_notes}\n              </p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
