k text-[#1A1A1A]\">\n                  <Lightbulb className=\"h-3 w-3 text-[#1A1A1A]\" />\n                  {fact.tag}\n                </span>\n                <span className=\"text-xs font-black text-stone-400\">#{idx + 1}</span>\n              </div>\n              <h3 className={`mt-2.5 font-black text-[#1A1A1A] ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                {fact.title}\n              </h3>\n              <p className={`mt-2 font-medium text-stone-700 leading-relaxed ${bodySize}`}>\n                {fact.fact}\n              </p>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
