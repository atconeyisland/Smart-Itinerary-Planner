    instruction: "Update App.tsx to harmonize with Bento Grid theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-stone-100/70 text-stone-900 selection:bg-amber-200\">\n      {/* Navigation bar */}\n      <Navbar\n        onReset={handleResetToForm}\n        onOpenJsonModal={() => setIsJsonModalOpen(true)}\n        hasItinerary={Boolean(itineraryData)}\n      />\n\n      {/* Main Container */}\n      <main className=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\">\n        {/* Error notification banner */}\n        {errorMessage && (\n          <div className=\"mb-6 mx-auto max-w-4xl flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 shadow-xs\">\n            <AlertCircle className=\"mt-0.5 h-5 w-5 shrink-0 text-red-600\" />\n            <div className=\"flex-1\">\n              <p className=\"font-semibold\">Generation Notice</p>\n              <p className=\"text-xs text-red-700\">{errorMessage}</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setErrorMessage(null)}\n              className=\"text-xs font-bold text-red-800 underline hover:no-underline\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {/* View switching */}\n        {viewMode === \'form\' || !itineraryData ? (\n          <PlannerForm\n            inputs={inputs}\n            onChange={setInputs}\n            onSubmit={handleGenerateItinerary}\n            isLoading={isLoading}\n            onSelectPreset={handleSelectPreset}\n          />\n        ) : (\n          <ItineraryView\n            itineraryData={itineraryData}\n            inputs={inputs}\n            completedActivities={completedActivities}\n            onToggleActivity={handleToggleActivity}\n            onSwapActivity={handleOpenSwapModal}\n            onOpenJsonModal={() => setIsJsonModalOpen(true)}\n            onModifyInputs={() => setViewMode(\'form\')}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"mt-16 border-t border-stone-200 bg-stone-50 py-8 text-center text-xs text-stone-500\">\n        <div className=\"mx-auto max-w-7xl px-4\">\n          <p className=\"font-medium text-stone-700\">\n            Smart Itinerary Planner Engine \342\200\242 Powered by Gemini AI\n          </p>\n          <p className=\"mt-1 text-stone-400\">\n            Enforcing geographic realism, buffer timing integrity, variety thresholds & neighborhood clustering.\n          </p>\n        </div>\n      </footer>\n\n      {/* Modals */}\n      <JsonModal\n        isOpen={isJsonModalOpen}\n        onClose={() => setIsJsonModalOpen(false)}\n        data={itineraryData}\n      />\n\n      <ActivitySwapModal\n        isOpen={swapModalState.isOpen}\n        onClose={() => setSwapModalState((prev) => ({ ...prev, isOpen: false }))}\n        dayNumber={swapModalState.dayNumber}\n        dayTheme={swapModalState.dayTheme}\n        geographicalFocus={swapModalState.geographicalFocus}\n        activityIndex={swapModalState.activityIndex}\n        currentActivity={swapModalState.currentActivity}\n        destination={inputs.destination}\n        budget={inputs.budget}\n        onActivitySwapped={handleActivitySwapped}\n      />\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"min-h-screen bg-[#F3F4F1] text-[#1A1A1A] selection:bg-[#C5E876]\">\n      {/* Navigation bar */}\n      <Navbar\n        onReset={handleResetToForm}\n        onOpenJsonModal={() => setIsJsonModalOpen(true)}\n        hasItinerary={Boolean(itineraryData)}\n      />\n\n      {/* Main Container */}\n      <main className=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\">\n        {/* Error notification banner */}\n        {errorMessage && (\n          <div className=\"mb-6 mx-auto max-w-4xl flex items-start gap-3 rounded-2xl border-2 border-[#1A1A1A] bg-[#FFD4D4] p-4 text-xs font-bold text-[#1A1A1A] shadow-[4px_4px_0px_0px_#1A1A1A]\">\n            <AlertCircle className=\"mt-0.5 h-4 w-4 shrink-0\" />\n            <div className=\"flex-1\">\n              <p className=\"uppercase tracking-wider font-black\">Generation Notice</p>\n              <p className=\"mt-0.5 font-medium\">{errorMessage}</p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setErrorMessage(null)}\n              className=\"px-2 py-1 bg-white rounded-lg border border-[#1A1A1A] uppercase tracking-wider text-[10px] font-black hover:bg-[#F3F4F1]\"\n            >\n              Dismiss\n            </button>\n          </div>\n        )}\n\n        {/* View switching */}\n        {viewMode === \'form\' || !itineraryData ? (\n          <PlannerForm\n            inputs={inputs}\n            onChange={setInputs}\n            onSubmit={handleGenerateItinerary}\n            isLoading={isLoading}\n            onSelectPreset={handleSelectPreset}\n          />\n        ) : (\n          <ItineraryView\n            itineraryData={itineraryData}\n            inputs={inputs}\n            completedActivities={completedActivities}\n            onToggleActivity={handleToggleActivity}\n            onSwapActivity={handleOpenSwapModal}\n            onOpenJsonModal={() => setIsJsonModalOpen(true)}\n            onModifyInputs={() => setViewMode(\'form\')}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"mt-16 border-t-2 border-[#1A1A1A] bg-white py-8 text-center text-xs text-[#1A1A1A]\">\n        <div className=\"mx-auto max-w-7xl px-4\">\n          <p className=\"font-black uppercase tracking-wider\">\n            Smart Itinerary Planner Engine \342\200\242 Bento Architecture\n          </p>\n          <p className=\"mt-1 font-medium opacity-60\">\n            Geographic realism, buffer timing integrity, variety thresholds & neighborhood clustering.\n          </p>\n        </div>\n      </footer>\n\n      {/* Modals */}\n      <JsonModal\n        isOpen={isJsonModalOpen}\n        onClose={() => setIsJsonModalOpen(false)}\n        data={itineraryData}\n      />\n\n      <ActivitySwapModal\n        isOpen={swapModalState.isOpen}\n        onClose={() => setSwapModalState((prev) => ({ ...prev, isOpen: false }))}\n        dayNumber={swapModalState.dayNumber}\n        dayTheme={swapModalState.dayTheme}\n        geographicalFocus={swapModalState.geographicalFocus}\n        activityIndex={swapModalState.activityIndex}\n        currentActivity={swapModalState.currentActivity}\n        destination={inputs.destination}\n        budget={inputs.budget}\n        onActivitySwapped={handleActivitySwapped}\n      />\n    </div>\n  );"
      }
