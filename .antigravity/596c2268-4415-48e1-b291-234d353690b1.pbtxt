        lines {
          text: "          title: \"Paris Has Over 400 Parks and Gardens\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"From the Renaissance Tuileries to the modern Parc des Buttes-Chaumont, Paris is one of Europe\'s greenest capital cities.\","
