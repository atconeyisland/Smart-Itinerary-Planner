        }
        lines {
          text: "              description: \"View the illuminated Water Palace floating in Man Sagar Lake at twilight, followed by an elaborate multi-course Dal Baati Churma feast at a heritage restaurant.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              cost_tier: \"\342\202\271\342\202\271 (\342\202\271800)\","
