div>\n                    <span className=\"text-[10px] font-bold text-stone-500 shrink-0\">\n                      {marker.category === \'activity\' ? `D${marker.dayNumber}` : marker.category}\n                    </span>\n                  </button>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
