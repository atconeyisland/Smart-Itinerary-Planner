    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { UtensilsCrossed, Leaf, MapPin, Sparkles, Heart, Info, DollarSign } from \'lucide-react\';\nimport { RestaurantRecommendation } from \'../types\';\nimport { getFoodPhoto } from \'../utils/imageService\';\n\ninterface RestaurantSectionProps {\n  restaurants?: RestaurantRecommendation[];\n  destination: string;\n  isLargeText: boolean;\n}\n\nexport const RestaurantSection: React.FC<RestaurantSectionProps> = ({\n  restaurants,\n  destination,\n  isLargeText,\n}) => {\n  if (!restaurants || restaurants.length === 0) {\n    return (\n      <div className=\"rounded-3xl border border-stone-200 bg-white p-8 text-center\">\n        <UtensilsCrossed className=\"mx-auto h-12 w-12 text-stone-400\" />\n        <h3 className=\"mt-3 text-lg font-bold text-stone-800\">Food & Dining Guide</h3>\n        <p className=\"mt-1 text-sm text-stone-500\">\n          No dining recommendations were included in this plan.\n        </p>\n      </div>\n    );\n  }\n\n  const titleSize = isLargeText ? \'text-xl sm:text-2xl font-bold\' : \'text-lg sm:text-xl font-bold\';\n  const bodySize = isLargeText ? \'text-base\' : \'text-sm\';\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-xs\">\n        <div className=\"flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"flex h-8 w-8 items-center justify-center rounded-xl bg-amber-100 text-amber-800\">\n                <UtensilsCrossed className=\"h-4 w-4\" />\n              </span>\n              <h2 className={`${titleSize} text-stone-900`}>\n                Top Food & Restaurant Guide in {destination.split(\',\')[0]}\n              </h2>\n            </div>\n            <p className={`mt-1 text-stone-600 ${bodySize}`}>\n              Iconic local dishes, vegetarian-friendly eateries, and comfortable dining spaces with estimated prices in \342\202\271 for two.\n            </p>\n          </div>\n          <span className=\"inline-flex self-start sm:self-auto rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800 border border-emerald-200\">\n            Prices in INR (\342\202\271) for Two\n          </span>\n        </div>\n      </div>\n\n      {/* Restaurant Cards Grid */}\n      <div className=\"grid grid-cols-1 gap-6 md:grid-cols-3\">\n        {restaurants.map((place, idx) => {\n          const photoUrl = getFoodPhoto(place.must_try_dish || place.cuisine_type);\n          const isPureVeg = place.veg_friendliness.toLowerCase().includes(\'pure veg\');\n          const isVegFriendly = place.veg_friendliness.toLowerCase().includes(\'excellent veg\') || isPureVeg;\n\n          return (\n            <div\n              key={idx}\n              className=\"flex flex-col overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md\"\n            >\n              {/* Photo Banner */}\n              <div className=\"relative h-48 w-full overflow-hidden bg-stone-100\">\n                <img\n                  src={photoUrl}\n                  alt={place.must_try_dish}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"h-full w-full object-cover transition duration-300 hover:scale-105\"\n                  loading=\"lazy\"\n                />\n                <div className=\"absolute top-3 left-3\">\n                  <span\n                    className={`inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold shadow-xs ${\n                      isPureVeg\n                        ? \'bg-emerald-600 text-white\'\n                        : isVegFriendly\n                        ? \'bg-emerald-700 text-white\'\n                        : \'bg-stone-900 text-white\'\n                    }`}\n                  >\n                    {isVegFriendly && <Leaf className=\"h-3 w-3\" />}\n                    <span>{place.veg_friendliness}</span>\n                  </span>\n                </div>\n                <div className=\"absolute bottom-3 right-3 rounded-xl bg-black/75 px-3 py-1 text-xs font-bold text-white backdrop-blur-xs\">\n                  Approx \342\202\271{place.approx_cost_inr_for_two?.toLocaleString(\'en-IN\') || \'\342\200\224\'} for two\n                </div>\n              </div>\n\n              {/* Card Body */}\n              <div className=\"flex flex-1 flex-col p-5 space-y-4\">\n                <div>\n                  <div className=\"flex items-center justify-between\">\n                    <h3 className={`font-bold text-stone-900 ${isLargeText ? \'text-lg\' : \'text-base\'}`}>\n                      {place.name}\n                    </h3>\n                  </div>\n                  <p className=\"text-xs font-medium text-amber-700\">{place.cuisine_type}</p>\n                  <div className=\"mt-1 flex items-center gap-1.5 text-xs text-stone-500\">\n                    <MapPin className=\"h-3.5 w-3.5 shrink-0 text-amber-600\" />\n                    <span>{place.neighborhood}</span>\n                  </div>\n                </div>\n\n                {/* Must Try Dish */}\n                <div className=\"rounded-xl border border-amber-200 bg-amber-50/80 p-3\">\n                  <p className=\"text-xs font-bold text-amber-900 uppercase tracking-wide flex items-center gap-1\">\n                    <Sparkles className=\"h-3 w-3 text-amber-600\" />\n                    Must-Try Specialty\n                  </p>\n                  <p className={`mt-0.5 font-semibold text-stone-900 ${isLargeText ? \'text-base\' : \'text-sm\'}`}>\n                    {place.must_try_dish}\n                  </p>\n                </div>\n\n                {/* Senior & Family Tips */}\n                <div className=\"flex-1 rounded-xl bg-stone-50 p-3 border border-stone-200\">\n                  <p className=\"text-xs font-bold text-stone-600 uppercase tracking-wide flex items-center gap-1\">\n                    <Info className=\"h-3 w-3 text-stone-500\" />\n                    Dining & Comfort Tip\n                  </p>\n                  <p className={`mt-1 text-stone-600 ${bodySize}`}>\n                    {place.senior_and_family_tips}\n                  </p>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
