  file_change {
    absolute_path_uri: "file:///src/components/SavedTripsModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { BookmarkCheck, Trash2, Calendar, MapPin, ExternalLink, ArrowRight, X } from \'lucide-react\';\nimport { getSavedTripsFromStorage, removeTripFromStorage, SavedTripRecord } from \'../utils/storageUtils\';\nimport { ItineraryPlanResponse } from \'../types\';\n\ninterface SavedTripsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSelectTrip: (plan: ItineraryPlanResponse) => void;\n}\n\nexport const SavedTripsModal: React.FC<SavedTripsModalProps> = ({ isOpen, onClose, onSelectTrip }) => {\n  const [savedTrips, setSavedTrips] = React.useState<SavedTripRecord[]>([]);\n\n  React.useEffect(() => {\n    if (isOpen) {\n      setSavedTrips(getSavedTripsFromStorage());\n    }\n  }, [isOpen]);\n\n  if (!isOpen) return null;\n\n  const handleDelete = (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    removeTripFromStorage(id);\n    setSavedTrips(getSavedTripsFromStorage());\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"relative w-full max-w-2xl bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-3xl shadow-[8px_8px_0px_0px_#1A1A1A] p-6 sm:p-8 max-h-[85vh] flex flex-col\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b-2 border-[#1A1A1A]\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"p-2.5 bg-[#C5E876] border-2 border-[#1A1A1A] rounded-2xl shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <BookmarkCheck className=\"w-5 h-5 text-[#1A1A1A]\" />\n            </span>\n            <div>\n              <h2 className=\"text-xl font-black text-[#1A1A1A]\">Your Saved Trips</h2>\n              <p className=\"text-xs text-[#718096] font-semibold\">\n                Trips stored in your local browser storage for quick access\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-[#718096] hover:text-[#1A1A1A] hover:bg-[#F3F4F1] border-2 border-transparent hover:border-[#1A1A1A] rounded-xl font-black text-lg transition-all\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content List */}\n        <div className=\"flex-1 overflow-y-auto py-4 space-y-3\">\n          {savedTrips.length === 0 ? (\n            <div className=\"text-center py-12 px-4\">\n              <div className=\"w-12 h-12 mx-auto bg-[#F3F4F1] border-2 border-[#1A1A1A] rounded-2xl flex items-center justify-center mb-3\">\n                <BookmarkCheck className=\"w-6 h-6 text-[#718096]\" />\n              </div>\n              <p className=\"font-black text-base text-[#1A1A1A]\">No Saved Trips Yet</p>\n              <p className=\"text-xs text-[#718096] mt-1 max-w-sm mx-auto\">\n                Generate any itinerary and click \"Save This Trip\" in the toolbar to keep it permanently saved in your browser.\n              </p>\n            </div>\n          ) : (\n            savedTrips.map((trip) => (\n              <div\n                key={trip.id}\n                onClick={() => {\n                  onSelectTrip(trip.plan);\n                  onClose();\n                }}\n                className=\"group p-4 bg-[#FAF9F5] hover:bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[3px_3px_0px_0px_#1A1A1A] hover:shadow-[5px_5px_0px_0px_#1A1A1A] cursor-pointer transition-all hover:translate-y-[-1px] flex items-center justify-between gap-4\"\n              >\n                <div className=\"flex-1 min-w-0\">\n                  <div className=\"flex items-center gap-2 flex-wrap\">\n                    <span className=\"font-black text-base text-[#1A1A1A] truncate\">\n                      {trip.destination}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-[#C5E876] text-[#1A1A1A] text-xs font-black rounded-lg border border-[#1A1A1A]\">\n                      {trip.totalDays} Days\n                    </span>\n                    <span className=\"text-xs font-bold text-[#718096]\">\n                      Saved {new Date(trip.savedAt).toLocaleDateString()}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#4A5568] mt-1 line-clamp-1\">\n                    {trip.plan.trip_summary.theme_vibe}\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2 flex-shrink-0\">\n                  <button\n                    onClick={(e) => handleDelete(trip.id, e)}\n                    className=\"p-2 text-[#EF4444] hover:bg-[#FEE2E2] border-2 border-transparent hover:border-[#EF4444] rounded-xl transition-all\"\n                    title=\"Delete saved trip\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                  <span className=\"p-2 bg-[#1A1A1A] text-white rounded-xl group-hover:bg-[#3B82F6] transition-colors\">\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </span>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"pt-4 border-t-2 border-[#1A1A1A] flex items-center justify-between text-xs text-[#718096] font-bold\">\n          <span>{savedTrips.length} saved itinerary{savedTrips.length === 1 ? \'\' : \'ies\'}</span>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-[#1A1A1A] text-white font-black rounded-xl hover:bg-[#3B82F6] transition-all\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
