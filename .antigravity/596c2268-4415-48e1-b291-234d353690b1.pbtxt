    instruction: "Update TripSummaryHeader to Bento Grid design theme"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Sparkles,\n  Share2,\n  Copy,\n  Check,\n  FileText,\n  Printer,\n  Code2,\n} from \'lucide-react\';\nimport { TripSummary, EstimatedCosts } from \'../types\';\n\ninterface TripSummaryHeaderProps {\n  summary: TripSummary;\n  costs: EstimatedCosts;\n  onOpenJsonModal: () => void;\n  onExportMarkdown: () => void;\n}\n\nexport const TripSummaryHeader: React.FC<TripSummaryHeaderProps> = ({\n  summary,\n  costs,\n  onOpenJsonModal,\n  onExportMarkdown,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  const handleCopySummary = () => {\n    const text = `${summary.destination} (${summary.total_days} Days)\\nVibe: ${summary.theme_vibe}\\nBudget Strategy: ${summary.budget_strategy}\\nEst. Costs: ${costs.currency} ~${costs.activities_per_day + costs.food_per_day}/day`;\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-sm md:p-8\">\n      <div className=\"flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between\">\n        <div className=\"space-y-2\">\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"inline-flex items-center gap-1 rounded-md bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-800\">\n              <Calendar className=\"h-3.5 w-3.5\" />\n              {summary.total_days} {summary.total_days === 1 ? \'Day Trip\' : \'Days Trip\'}\n            </span>\n            <span className=\"inline-flex items-center gap-1 rounded-md bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-700\">\n              <MapPin className=\"h-3.5 w-3.5 text-stone-500\" />\n              {summary.destination}\n            </span>\n          </div>\n\n          <h2 className=\"text-2xl font-extrabold tracking-tight text-stone-900 md:text-3xl\">\n            {summary.destination}\n          </h2>\n\n          <p className=\"max-w-3xl text-sm italic leading-relaxed text-amber-900/90 font-medium\">\n            \"{summary.theme_vibe}\"\n          </p>\n        </div>\n\n        {/* Action Controls */}\n        <div className=\"flex flex-wrap items-center gap-2 pt-2 lg:pt-0\">\n          <button\n            type=\"button\"\n            onClick={handleCopySummary}\n            className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 text-xs font-medium text-stone-700 transition hover:bg-stone-100\"\n            title=\"Copy trip overview\"\n          >\n            {copied ? (\n              <>\n                <Check className=\"h-3.5 w-3.5 text-emerald-600\" />\n                <span className=\"text-emerald-700\">Copied!</span>\n              </>\n            ) : (\n              <>\n                <Copy className=\"h-3.5 w-3.5 text-stone-500\" />\n                <span>Copy Summary</span>\n              </>\n            )}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onExportMarkdown}\n            className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 text-xs font-medium text-stone-700 transition hover:bg-stone-100\"\n            title=\"Download formatted markdown notes\"\n          >\n            <FileText className=\"h-3.5 w-3.5 text-stone-500\" />\n            <span>Export MD</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handlePrint}\n            className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 text-xs font-medium text-stone-700 transition hover:bg-stone-100\"\n            title=\"Print or Save as PDF\"\n          >\n            <Printer className=\"h-3.5 w-3.5 text-stone-500\" />\n            <span>Print / PDF</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onOpenJsonModal}\n            className=\"inline-flex items-center gap-1.5 rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-900 transition hover:bg-amber-100\"\n            title=\"View exact JSON output matching engine schema\"\n          >\n            <Code2 className=\"h-3.5 w-3.5 text-amber-700\" />\n            <span>JSON Output</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Budget Strategy Callout */}\n      <div className=\"mt-5 rounded-xl border border-stone-200/80 bg-stone-50/80 p-3.5\">\n        <div className=\"flex items-start gap-2.5\">\n          <Sparkles className=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" />\n          <div>\n            <span className=\"text-xs font-bold uppercase tracking-wider text-stone-600\">\n              Budget Strategy & Allocation:\n            </span>\n            <p className=\"mt-0.5 text-xs text-stone-700 leading-relaxed\">\n              {summary.budget_strategy}\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  Calendar,\n  Sparkles,\n  Copy,\n  Check,\n  FileText,\n  Printer,\n  Code2,\n} from \'lucide-react\';\nimport { TripSummary, EstimatedCosts } from \'../types\';\n\ninterface TripSummaryHeaderProps {\n  summary: TripSummary;\n  costs: EstimatedCosts;\n  onOpenJsonModal: () => void;\n  onExportMarkdown: () => void;\n}\n\nexport const TripSummaryHeader: React.FC<TripSummaryHeaderProps> = ({\n  summary,\n  costs,\n  onOpenJsonModal,\n  onExportMarkdown,\n}) => {\n  const [copied, setCopied] = useState(false);\n\n  const handleCopySummary = () => {\n    const text = `${summary.destination} (${summary.total_days} Days)\\nVibe: ${summary.theme_vibe}\\nBudget Strategy: ${summary.budget_strategy}\\nEst. Costs: ${costs.currency} ~${costs.activities_per_day + costs.food_per_day}/day`;\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"relative overflow-hidden rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[6px_6px_0px_0px_#1A1A1A] sm:p-8\">\n      {/* Subtle Bento Watermark */}\n      <div className=\"pointer-events-none absolute -top-4 right-4 text-7xl sm:text-8xl font-black uppercase tracking-tighter text-[#1A1A1A]/5 select-none\">\n        Vibe\n      </div>\n\n      <div className=\"relative z-10 flex flex-col gap-5\">\n        {/* Section Pill Marker & Actions */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#1A1A1A] border-dashed pb-4\">\n          <h2 className=\"flex items-center gap-2 text-xs font-black uppercase tracking-widest text-[#1A1A1A]\">\n            <span className=\"h-2.5 w-2.5 rounded-full bg-[#1A1A1A]\" />\n            Trip Summary & Strategy\n          </h2>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={handleCopySummary}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5 hover:bg-[#C5E876]\"\n              title=\"Copy trip overview\"\n            >\n              {copied ? (\n                <>\n                  <Check className=\"h-3.5 w-3.5 text-emerald-600\" />\n                  <span className=\"text-emerald-800\">Copied!</span>\n                </>\n              ) : (\n                <>\n                  <Copy className=\"h-3.5 w-3.5\" />\n                  <span>Copy Summary</span>\n                </>\n              )}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onExportMarkdown}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5 hover:bg-[#89CFF0]\"\n              title=\"Download formatted markdown notes\"\n            >\n              <FileText className=\"h-3.5 w-3.5\" />\n              <span>Export MD</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handlePrint}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5 hover:bg-[#FFD4D4]\"\n              title=\"Print or Save as PDF\"\n            >\n              <Printer className=\"h-3.5 w-3.5\" />\n              <span>Print / PDF</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onOpenJsonModal}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] px-3 py-1.5 text-xs font-black text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5\"\n              title=\"View exact JSON output matching engine schema\"\n            >\n              <Code2 className=\"h-3.5 w-3.5\" />\n              <span>JSON Schema</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Big Vibe Headline */}\n        <div>\n          <p className=\"text-2xl sm:text-3xl font-bold tracking-tight leading-snug text-[#1A1A1A]\">\n            \"{summary.theme_vibe}\"\n          </p>\n        </div>\n\n        {/* Strategy callout */}\n        <div className=\"rounded-2xl border-2 border-[#1A1A1A]/10 bg-[#F3F4F1] p-4 text-xs sm:text-sm font-medium leading-relaxed text-[#1A1A1A]/80 italic\">\n          <span className=\"font-black not-italic uppercase tracking-wide text-[#1A1A1A] block mb-1\">\n            Execution Strategy:\n          </span>\n          {summary.budget_strategy}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
