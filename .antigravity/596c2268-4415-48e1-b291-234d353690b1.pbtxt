  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Compass, Code2, RotateCcw, Sparkles } from \'lucide-react\';\n\ninterface NavbarProps {\n  onReset: () => void;\n  onOpenJsonModal: () => void;\n  hasItinerary: boolean;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onReset, onOpenJsonModal, hasItinerary }) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b border-stone-200 bg-stone-50/90 backdrop-blur-md\">\n      <div className=\"mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-amber-700 text-stone-50 shadow-sm\">\n            <Compass className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-lg font-bold tracking-tight text-stone-900 sm:text-xl\">\n                Smart Itinerary Planner\n              </h1>\n              <span className=\"inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800\">\n                <Sparkles className=\"h-3 w-3\" />\n                AI Engine\n              </span>\n            </div>\n            <p className=\"text-xs text-stone-500\">\n              Hyper-personalized, geographically logical day-by-day travel schedules\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onOpenJsonModal}\n              className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-xs font-medium text-stone-700 shadow-sm transition hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-amber-500\"\n              title=\"Inspect JSON engine output matching schema\"\n            >\n              <Code2 className=\"h-3.5 w-3.5 text-stone-500\" />\n              <span>JSON Schema</span>\n            </button>\n          )}\n\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-xs font-medium text-stone-700 shadow-sm transition hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-amber-500\"\n            >\n              <RotateCcw className=\"h-3.5 w-3.5 text-stone-500\" />\n              <span className=\"hidden sm:inline\">New Itinerary</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Compass, Code2, RotateCcw, Sparkles } from \'lucide-react\';\n\ninterface NavbarProps {\n  onReset: () => void;\n  onOpenJsonModal: () => void;\n  hasItinerary: boolean;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onReset, onOpenJsonModal, hasItinerary }) => {\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b-2 border-[#1A1A1A] bg-[#F3F4F1]/95 backdrop-blur-md\">\n      <div className=\"mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6\">\n        {/* Brand */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#1A1A1A] text-[#C5E876] shadow-[3px_3px_0px_0px_#1A1A1A]\">\n            <Compass className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-base font-black tracking-tight uppercase italic text-[#1A1A1A] sm:text-lg\">\n                Smart Itinerary Planner\n              </h1>\n              <span className=\"inline-flex items-center gap-1 rounded-md border border-[#1A1A1A] bg-[#C5E876] px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\">\n                <Sparkles className=\"h-2.5 w-2.5\" />\n                AI Bento Engine\n              </span>\n            </div>\n            <p className=\"text-[11px] font-medium text-[#1A1A1A]/70 hidden sm:block\">\n              Geographic clustering \342\200\242 Realistic buffer timing \342\200\242 Variety thresholds\n            </p>\n          </div>\n        </div>\n\n        {/* Actions */}\n        <div className=\"flex items-center gap-2.5\">\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onOpenJsonModal}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-white px-3 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-[#89CFF0] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0px_0px_#1A1A1A]\"\n              title=\"Inspect JSON engine output matching schema\"\n            >\n              <Code2 className=\"h-3.5 w-3.5\" />\n              <span>JSON Schema</span>\n            </button>\n          )}\n\n          {hasItinerary && (\n            <button\n              type=\"button\"\n              onClick={onReset}\n              className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] px-3.5 py-1.5 text-xs font-black uppercase tracking-tight text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] transition hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5 active:shadow-[1px_1px_0px_0px_#1A1A1A]\"\n            >\n              <RotateCcw className=\"h-3.5 w-3.5\" />\n              <span>New Plan</span>\n            </button>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
