        }
        lines {
          text: "        {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          title: \"Saved from WWII Destruction\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fact: \"Kyoto was removed from the target list in 1945 by the US Secretary of War because he had honeymooned there and appreciated its immense cultural treasures.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          tag: \"Heritage\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
