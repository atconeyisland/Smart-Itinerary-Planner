  file_change {
    absolute_path_uri: "file:///src/components/InteractiveMapWidget.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef, useState, useMemo } from \'react\';\nimport { MapPin, Navigation, ExternalLink, Download, Calendar, Layers, Sparkles, Hotel, Utensils } from \'lucide-react\';\nimport L from \'leaflet\';\nimport { ItineraryPlanResponse, DayItinerary } from \'../types\';\nimport { getActivityPhoto, getHotelPhoto, getFoodPhoto } from \'../utils/imageService\';\nimport { generateDayGoogleMapsUrl, generatePlaceGoogleMapsUrl, downloadKmlForGoogleMyMaps, downloadIcsCalendar } from \'../utils/mapExportUtils\';\n\ninterface InteractiveMapWidgetProps {\n  plan: ItineraryPlanResponse;\n  selectedDay?: number;\n  onSelectDay?: (dayNum: number) => void;\n}\n\ninterface MapMarkerData {\n  id: string;\n  name: string;\n  category: \'activity\' | \'hotel\' | \'restaurant\';\n  dayNumber?: number;\n  timeSlot?: string;\n  duration?: number;\n  cost?: string;\n  description: string;\n  tip?: string;\n  lat: number;\n  lng: number;\n  photoUrl: string;\n  neighborhood?: string;\n}\n\nconst DAY_COLORS = [\'#3B82F6\', \'#10B981\', \'#F59E0B\', \'#8B5CF6\', \'#EC4899\', \'#06B6D4\', \'#F97316\'];\n\nexport const InteractiveMapWidget: React.FC<InteractiveMapWidgetProps> = ({\n  plan,\n  selectedDay: initialSelectedDay,\n  onSelectDay,\n}) => {\n  const mapContainerRef = useRef<HTMLDivElement | null>(null);\n  const mapInstanceRef = useRef<L.Map | null>(null);\n  const markersLayerGroupRef = useRef<L.LayerGroup | null>(null);\n  const linesLayerGroupRef = useRef<L.LayerGroup | null>(null);\n\n  const [activeDayFilter, setActiveDayFilter] = useState<number | \'all\'>(\n    initialSelectedDay !== undefined ? initialSelectedDay : \'all\'\n  );\n  const [activeCategoryFilter, setActiveCategoryFilter] = useState<\'all\' | \'activities\' | \'hotels\' | \'restaurants\'>(\'all\');\n  const [selectedMarker, setSelectedMarker] = useState<MapMarkerData | null>(null);\n\n  // Sync prop changes\n  useEffect(() => {\n    if (initialSelectedDay !== undefined) {\n      setActiveDayFilter(initialSelectedDay);\n    }\n  }, [initialSelectedDay]);\n\n  // Compute destination base coords\n  const baseLat = plan.trip_summary.destination_coords?.lat || 35.0116;\n  const baseLng = plan.trip_summary.destination_coords?.lng || 135.7681;\n\n  // Flatten all markers with accurate or clustered coordinates\n  const allMarkers: MapMarkerData[] = useMemo(() => {\n    const list: MapMarkerData[] = [];\n\n    // 1. Activities from days\n    plan.itinerary.forEach((day) => {\n      day.schedule.forEach((item, itemIdx) => {\n        // Fallback offset if coordinates not present\n        const lat = item.coordinates?.lat || baseLat + (Math.sin(day.day_number * 2 + itemIdx) * 0.02);\n        const lng = item.coordinates?.lng || baseLng + (Math.cos(day.day_number * 2 + itemIdx) * 0.02);\n\n        list.push({\n          id: `act_${day.day_number}_${itemIdx}`,\n          name: item.activity_name,\n          category: \'activity\',\n          dayNumber: day.day_number,\n          timeSlot: item.time_slot,\n          duration: item.estimated_duration_hours,\n          cost: item.cost_tier,\n          description: item.description,\n          tip: item.insider_tip,\n          lat,\n          lng,\n          photoUrl: getActivityPhoto(item.activity_name, plan.trip_summary.destination),\n        });\n      });\n    });\n\n    // 2. Hotels\n    if (plan.hotel_recommendations) {\n      plan.hotel_recommendations.forEach((hotel, idx) => {\n        const lat = hotel.coordinates?.lat || baseLat - 0.015 + (idx * 0.008);\n        const lng = hotel.coordinates?.lng || baseLng - 0.015 + (idx * 0.008);\n\n        list.push({\n          id: `hotel_${idx}`,\n          name: hotel.name,\n          category: \'hotel\',\n          description: `${hotel.category} \342\200\242 ${hotel.neighborhood} \342\200\242 Best for: ${hotel.best_for}`,\n          tip: hotel.key_highlights.join(\' \342\200\242 \'),\n          lat,\n          lng,\n          neighborhood: hotel.neighborhood,\n          photoUrl: getHotelPhoto(hotel.category, hotel.name),\n        });\n      });\n    }\n\n    // 3. Restaurants\n    if (plan.restaurant_recommendations) {\n      plan.restaurant_recommendations.forEach((rest, idx) => {\n        const lat = rest.coordinates?.lat || baseLat + 0.012 + (idx * 0.007);\n        const lng = rest.coordinates?.lng || baseLng - 0.010 - (idx * 0.006);\n\n        list.push({\n          id: `rest_${idx}`,\n          name: rest.name,\n          category: \'restaurant\',\n          description: `${rest.cuisine_type} \342\200\242 Must Try: ${rest.must_try_dish} (${rest.veg_friendliness})`,\n          tip: rest.senior_and_family_tips,\n          lat,\n          lng,\n          neighborhood: rest.neighborhood,\n          photoUrl: getFoodPhoto(rest.must_try_dish || rest.cuisine_type),\n        });\n      });\n    }\n\n    return list;\n  }, [plan, baseLat, baseLng]);\n\n  // Filtered markers\n  const filteredMarkers = useMemo(() => {\n    return allMarkers.filter((m) => {\n      // Day filter\n      if (activeDayFilter !== \'all\') {\n        if (m.category === \'activity\' && m.dayNumber !== activeDayFilter) return false;\n      }\n      // Category filter\n      if (activeCategoryFilter === \'activities\' && m.category !== \'activity\') return false;\n      if (activeCategoryFilter === \'hotels\' && m.category !== \'hotel\') return false;\n      if (activeCategoryFilter === \'restaurants\' && m.category !== \'restaurant\') return false;\n      return true;\n    });\n  }, [allMarkers, activeDayFilter, activeCategoryFilter]);\n\n  // Initialize Leaflet Map\n  useEffect(() => {\n    if (!mapContainerRef.current) return;\n\n    if (!mapInstanceRef.current) {\n      const map = L.map(mapContainerRef.current, {\n        center: [baseLat, baseLng],\n        zoom: 13,\n        zoomControl: false,\n        attributionControl: false,\n      });\n\n      L.control.zoom({ position: \'bottomright\' }).addTo(map);\n\n      // Clean OpenStreetMap tile layer with high contrast\n      L.tileLayer(\'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png\', {\n        maxZoom: 19,\n        attribution: \'&copy; OpenStreetMap contributors\',\n      }).addTo(map);\n\n      markersLayerGroupRef.current = L.layerGroup().addTo(map);\n      linesLayerGroupRef.current = L.layerGroup().addTo(map);\n      mapInstanceRef.current = map;\n    }\n\n    return () => {\n      // Keep map clean\n    };\n  }, [baseLat, baseLng]);\n\n  // Update markers & polylines whenever filteredMarkers or activeDayFilter changes\n  useEffect(() => {\n    const map = mapInstanceRef.current;\n    const markersGroup = markersLayerGroupRef.current;\n    const linesGroup = linesLayerGroupRef.current;\n\n    if (!map || !markersGroup || !linesGroup) return;\n\n    markersGroup.clearLayers();\n    linesGroup.clearLayers();\n\n    if (filteredMarkers.length === 0) return;\n\n    const bounds = L.latLngBounds([]);\n\n    // Add Markers\n    filteredMarkers.forEach((item, index) => {\n      const color =\n        item.category === \'hotel\'\n          ? \'#8B5CF6\'\n          : item.category === \'restaurant\'\n          ? \'#EF4444\'\n          : DAY_COLORS[((item.dayNumber || 1) - 1) % DAY_COLORS.length];\n\n      const iconLabel =\n        item.category === \'hotel\'\n          ? \'\360\237\217\250\'\n          : item.category === \'restaurant\'\n          ? \'\360\237\215\275\357\270\217\'\n          : `D${item.dayNumber || 1}`;\n\n      const customIcon = L.divIcon({\n        className: \'custom-map-pin\',\n        html: `\n          <div style=\"\n            background-color: ${color};\n            color: #FFFFFF;\n            font-weight: 800;\n            font-size: 11px;\n            padding: 4px 8px;\n            border-radius: 9999px;\n            border: 2px solid #1A1A1A;\n            box-shadow: 3px 3px 0px 0px #1A1A1A;\n            display: flex;\n            align-items: center;\n            gap: 4px;\n            white-space: nowrap;\n            cursor: pointer;\n            transform: translate(-50%, -50%);\n            transition: transform 0.15s ease;\n          \">\n            <span>${iconLabel}</span>\n            <span style=\"max-width: 90px; overflow: hidden; text-overflow: ellipsis;\">${item.name}</span>\n          </div>\n        `,\n        iconSize: [120, 30],\n        iconAnchor: [60, 15],\n      });\n\n      const marker = L.marker([item.lat, item.lng], { icon: customIcon });\n\n      marker.on(\'click\', () => {\n        setSelectedMarker(item);\n        map.panTo([item.lat, item.lng]);\n      });\n\n      markersGroup.addLayer(marker);\n      bounds.extend([item.lat, item.lng]);\n    });\n\n    // Draw route polylines between sequential activities\n    if (activeDayFilter === \'all\') {\n      plan.itinerary.forEach((day) => {\n        const dayActivities = filteredMarkers.filter(\n          (m) => m.category === \'activity\' && m.dayNumber === day.day_number\n        );\n        if (dayActivities.length >= 2) {\n          const latlngs = dayActivities.map((m) => [m.lat, m.lng] as [number, number]);\n          const polyline = L.polyline(latlngs, {\n            color: DAY_COLORS[(day.day_number - 1) % DAY_COLORS.length],\n            weight: 4,\n            opacity: 0.8,\n            dashArray: \'8, 8\',\n          });\n          linesGroup.addLayer(polyline);\n        }\n      });\n    } else {\n      const dayActivities = filteredMarkers.filter(\n        (m) => m.category === \'activity\' && m.dayNumber === activeDayFilter\n      );\n      if (dayActivities.length >= 2) {\n        const latlngs = dayActivities.map((m) => [m.lat, m.lng] as [number, number]);\n        const polyline = L.polyline(latlngs, {\n          color: DAY_COLORS[(Number(activeDayFilter) - 1) % DAY_COLORS.length],\n          weight: 5,\n          opacity: 0.9,\n        });\n        linesGroup.addLayer(polyline);\n      }\n    }\n\n    if (bounds.isValid()) {\n      map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });\n    }\n  }, [filteredMarkers, activeDayFilter, plan]);\n\n  // Handle center reset\n  const handleResetBounds = () => {\n    if (!mapInstanceRef.current || filteredMarkers.length === 0) return;\n    const bounds = L.latLngBounds(filteredMarkers.map((m) => [m.lat, m.lng]));\n    if (bounds.isValid()) {\n      mapInstanceRef.current.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });\n    }\n  };\n\n  // Google Maps Full Route URL\n  const googleMapsFullTripUrl = useMemo(() => {\n    if (activeDayFilter !== \'all\') {\n      const dayObj = plan.itinerary.find((d) => d.day_number === activeDayFilter);\n      if (dayObj) return generateDayGoogleMapsUrl(dayObj, plan.trip_summary.destination);\n    }\n    const firstDay = plan.itinerary[0];\n    return firstDay ? generateDayGoogleMapsUrl(firstDay, plan.trip_summary.destination) : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(plan.trip_summary.destination)}`;\n  }, [plan, activeDayFilter]);\n\n  return (\n    <div id=\"interactive-map-widget\" className=\"bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] overflow-hidden\">\n      {/* Top Header & Google Maps Actions */}\n      <div className=\"p-4 sm:p-6 border-b-2 border-[#1A1A1A] bg-[#FAF9F5] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"p-2 bg-[#E2E8F0] border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <MapPin className=\"w-5 h-5 text-[#1A1A1A]\" />\n            </span>\n            <div>\n              <h2 className=\"text-xl sm:text-2xl font-black text-[#1A1A1A] tracking-tight\">\n                Interactive Trip Map & Google Maps Navigation\n              </h2>\n              <p className=\"text-xs sm:text-sm font-medium text-[#4A5568]\">\n                Geographically optimized route paths, landmark pins, and direct one-click Google Maps integration.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2 sm:gap-3\">\n          <a\n            href={googleMapsFullTripUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            id=\"btn-open-google-maps-route\"\n            className=\"flex items-center gap-2 px-3.5 py-2 bg-[#10B981] hover:bg-[#059669] text-white text-xs sm:text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n          >\n            <Navigation className=\"w-4 h-4\" />\n            <span>Open Route in Google Maps</span>\n            <ExternalLink className=\"w-3.5 h-3.5 opacity-80\" />\n          </a>\n\n          <button\n            onClick={() => downloadKmlForGoogleMyMaps(plan)}\n            id=\"btn-export-kml-mymaps\"\n            className=\"flex items-center gap-2 px-3.5 py-2 bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] text-xs sm:text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n            title=\"Export .KML file for Google My Maps import\"\n          >\n            <Download className=\"w-4 h-4 text-[#3B82F6]\" />\n            <span>Export to Google My Maps</span>\n          </button>\n\n          <button\n            onClick={() => downloadIcsCalendar(plan)}\n            id=\"btn-export-calendar-ics\"\n            className=\"flex items-center gap-2 px-3.5 py-2 bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] text-xs sm:text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px]\"\n            title=\"Download .ICS file to add itinerary to Google Calendar\"\n          >\n            <Calendar className=\"w-4 h-4 text-[#8B5CF6]\" />\n            <span>Add to Calendar (.ics)</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Tabs Bar */}\n      <div className=\"p-3 sm:px-6 bg-[#FFFFFF] border-b-2 border-[#1A1A1A] flex flex-wrap items-center justify-between gap-3\">\n        {/* Day Filter Chips */}\n        <div className=\"flex flex-wrap items-center gap-1.5 sm:gap-2\">\n          <span className=\"text-xs font-bold text-[#718096] uppercase tracking-wider mr-1\">Day:</span>\n          <button\n            onClick={() => {\n              setActiveDayFilter(\'all\');\n              if (onSelectDay) onSelectDay(0);\n            }}\n            className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-lg transition-all ${\n              activeDayFilter === \'all\'\n                ? \'bg-[#1A1A1A] text-[#FFFFFF] shadow-[2px_2px_0px_0px_#718096]\'\n                : \'bg-[#F3F4F1] text-[#1A1A1A] hover:bg-[#E2E8F0]\'\n            }`}\n          >\n            All Days ({allMarkers.filter((m) => m.category === \'activity\').length} stops)\n          </button>\n\n          {plan.itinerary.map((day) => (\n            <button\n              key={`day_filter_${day.day_number}`}\n              onClick={() => {\n                setActiveDayFilter(day.day_number);\n                if (onSelectDay) onSelectDay(day.day_number);\n              }}\n              className={`px-3 py-1.5 text-xs font-black border-2 border-[#1A1A1A] rounded-lg transition-all flex items-center gap-1.5 ${\n                activeDayFilter === day.day_number\n                  ? \'bg-[#3B82F6] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                  : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n              }`}\n            >\n              <span\n                className=\"w-2 h-2 rounded-full border border-[#1A1A1A]\"\n                style={{ backgroundColor: DAY_COLORS[(day.day_number - 1) % DAY_COLORS.length] }}\n              />\n              <span>Day {day.day_number}</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Category Filters & Recenter */}\n        <div className=\"flex items-center gap-2\">\n          <div className=\"flex items-center bg-[#F3F4F1] p-1 border-2 border-[#1A1A1A] rounded-xl text-xs font-bold\">\n            <button\n              onClick={() => setActiveCategoryFilter(\'all\')}\n              className={`px-2.5 py-1 rounded-lg transition-all ${\n                activeCategoryFilter === \'all\' ? \'bg-[#FFFFFF] text-[#1A1A1A] shadow-sm\' : \'text-[#4A5568]\'\n              }`}\n            >\n              All\n            </button>\n            <button\n              onClick={() => setActiveCategoryFilter(\'activities\')}\n              className={`px-2.5 py-1 rounded-lg transition-all flex items-center gap-1 ${\n                activeCategoryFilter === \'activities\' ? \'bg-[#FFFFFF] text-[#1A1A1A] shadow-sm\' : \'text-[#4A5568]\'\n              }`}\n            >\n              <Sparkles className=\"w-3 h-3 text-[#3B82F6]\" />\n              <span>Activities</span>\n            </button>\n            <button\n              onClick={() => setActiveCategoryFilter(\'hotels\')}\n              className={`px-2.5 py-1 rounded-lg transition-all flex items-center gap-1 ${\n                activeCategoryFilter === \'hotels\' ? \'bg-[#FFFFFF] text-[#1A1A1A] shadow-sm\' : \'text-[#4A5568]\'\n              }`}\n            >\n              <Hotel className=\"w-3 h-3 text-[#8B5CF6]\" />\n              <span>Hotels</span>\n            </button>\n            <button\n              onClick={() => setActiveCategoryFilter(\'restaurants\')}\n              className={`px-2.5 py-1 rounded-lg transition-all flex items-center gap-1 ${\n                activeCategoryFilter === \'restaurants\' ? \'bg-[#FFFFFF] text-[#1A1A1A] shadow-sm\' : \'text-[#4A5568]\'\n              }`}\n            >\n              <Utensils className=\"w-3 h-3 text-[#EF4444]\" />\n              <span>Food</span>\n            </button>\n          </div>\n\n          <button\n            onClick={handleResetBounds}\n            className=\"p-1.5 bg-[#FFFFFF] hover:bg-[#F3F4F1] border-2 border-[#1A1A1A] rounded-xl text-xs font-bold shadow-[2px_2px_0px_0px_#1A1A1A]\"\n            title=\"Reset Map Zoom\"\n          >\n            <Layers className=\"w-4 h-4 text-[#1A1A1A]\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Main Map Container + Selected Marker Info Overlay */}\n      <div className=\"relative\">\n        <div\n          ref={mapContainerRef}\n          className=\"w-full h-[400px] sm:h-[480px] bg-[#E2E8F0] z-0\"\n          style={{ minHeight: \'400px\' }}\n        />\n\n        {/* Selected Marker Detail Card (Floats over map) */}\n        {selectedMarker && (\n          <div className=\"absolute bottom-4 left-4 right-4 sm:left-auto sm:right-4 sm:w-96 bg-[#FFFFFF] border-2 border-[#1A1A1A] rounded-2xl shadow-[4px_4px_0px_0px_#1A1A1A] p-4 z-[1000] animate-in fade-in slide-in-from-bottom-3 duration-200\">\n            <div className=\"flex items-start justify-between gap-3 mb-2\">\n              <div className=\"flex items-center gap-2\">\n                <span\n                  className={`px-2.5 py-0.5 text-xs font-black border-2 border-[#1A1A1A] rounded-lg ${\n                    selectedMarker.category === \'hotel\'\n                      ? \'bg-[#8B5CF6] text-white\'\n                      : selectedMarker.category === \'restaurant\'\n                      ? \'bg-[#EF4444] text-white\'\n                      : \'bg-[#3B82F6] text-white\'\n                  }`}\n                >\n                  {selectedMarker.category === \'hotel\'\n                    ? \'\360\237\217\250 Hotel\'\n                    : selectedMarker.category === \'restaurant\'\n                    ? \'\360\237\215\275\357\270\217 Restaurant\'\n                    : `Day ${selectedMarker.dayNumber} \342\200\242 ${selectedMarker.timeSlot}`}\n                </span>\n                {selectedMarker.cost && (\n                  <span className=\"text-xs font-bold text-[#4A5568] bg-[#F3F4F1] px-2 py-0.5 rounded border border-[#CBD5E0]\">\n                    {selectedMarker.cost}\n                  </span>\n                )}\n              </div>\n              <button\n                onClick={() => setSelectedMarker(null)}\n                className=\"text-[#718096] hover:text-[#1A1A1A] font-black text-lg leading-none\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"flex gap-3\">\n              <img\n                src={selectedMarker.photoUrl}\n                alt={selectedMarker.name}\n                className=\"w-20 h-20 rounded-xl object-cover border-2 border-[#1A1A1A] flex-shrink-0\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <h4 className=\"font-black text-base text-[#1A1A1A] leading-snug truncate\">\n                  {selectedMarker.name}\n                </h4>\n                <p className=\"text-xs text-[#4A5568] line-clamp-2 mt-1 leading-relaxed\">\n                  {selectedMarker.description}\n                </p>\n                {selectedMarker.tip && (\n                  <p className=\"text-[11px] text-[#2B6CB0] font-medium mt-1 truncate\">\n                    \360\237\222\241 {selectedMarker.tip}\n                  </p>\n                )}\n              </div>\n            </div>\n\n            <div className=\"mt-3 pt-3 border-t border-[#E2E8F0] flex items-center justify-between\">\n              <a\n                href={generatePlaceGoogleMapsUrl(\n                  selectedMarker.name,\n                  plan.trip_summary.destination,\n                  selectedMarker.neighborhood\n                )}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-1.5 text-xs font-black text-[#10B981] hover:underline\"\n              >\n                <Navigation className=\"w-3.5 h-3.5\" />\n                <span>View on Google Maps</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </a>\n\n              {selectedMarker.duration && (\n                <span className=\"text-[11px] font-bold text-[#718096]\">\n                  \342\217\261\357\270\217 ~{selectedMarker.duration} hrs\n                </span>\n              )}\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Bottom Horizontal Quick-Select Carousel */}\n      <div className=\"p-3 sm:p-4 bg-[#FAF9F5] border-t-2 border-[#1A1A1A]\">\n        <div className=\"text-xs font-bold text-[#718096] uppercase tracking-wider mb-2 flex items-center justify-between\">\n          <span>Stops on Current View ({filteredMarkers.length})</span>\n          <span className=\"text-[11px] text-[#4A5568] lowercase\">click any stop to center on map</span>\n        </div>\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin\">\n          {filteredMarkers.map((marker) => (\n            <button\n              key={marker.id}\n              onClick={() => {\n                setSelectedMarker(marker);\n                if (mapInstanceRef.current) {\n                  mapInstanceRef.current.panTo([marker.lat, marker.lng]);\n                }\n              }}\n              className={`flex-shrink-0 flex items-center gap-2 px-3 py-2 bg-[#FFFFFF] border-2 rounded-xl text-left transition-all ${\n                selectedMarker?.id === marker.id\n                  ? \'border-[#3B82F6] bg-[#EFF6FF] shadow-[2px_2px_0px_0px_#3B82F6]\'\n                  : \'border-[#1A1A1A] hover:bg-[#F3F4F1] shadow-[2px_2px_0px_0px_#1A1A1A]\'\n              }`}\n            >\n              <img\n                src={marker.photoUrl}\n                alt={marker.name}\n                className=\"w-7 h-7 rounded-lg object-cover border border-[#1A1A1A]\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"max-w-[130px]\">\n                <div className=\"text-[11px] font-black text-[#1A1A1A] truncate\">{marker.name}</div>\n                <div className=\"text-[10px] text-[#718096] truncate\">\n                  {marker.category === \'activity\' ? `Day ${marker.dayNumber}` : marker.category}\n                </div>\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
