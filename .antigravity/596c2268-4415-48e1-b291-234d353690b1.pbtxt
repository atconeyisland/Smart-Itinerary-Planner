  file_change {
    absolute_path_uri: "file:///src/components/ItineraryView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Calendar,\n  Building2,\n  UtensilsCrossed,\n  Languages,\n  Compass,\n  Sparkles,\n  MapPin,\n  Plane,\n  Navigation,\n  ExternalLink,\n  Download,\n  BookmarkPlus,\n  BookmarkCheck,\n} from \'lucide-react\';\nimport { ItineraryPlanResponse, ActivityItem } from \'../types\';\nimport { TripSummaryHeader } from \'./TripSummaryHeader\';\nimport { DayScheduleCard } from \'./DayScheduleCard\';\nimport { CostBreakdownCard } from \'./CostBreakdownCard\';\nimport { LogisticsGuideCard } from \'./LogisticsGuideCard\';\nimport { HotelSection } from \'./HotelSection\';\nimport { RestaurantSection } from \'./RestaurantSection\';\nimport { SurvivalPhrasesSection } from \'./SurvivalPhrasesSection\';\nimport { FunFactsSection } from \'./FunFactsSection\';\nimport { InteractiveMapWidget } from \'./InteractiveMapWidget\';\nimport { FlightFinderSection } from \'./FlightFinderSection\';\nimport { saveTripToStorage, isTripSaved } from \'../utils/storageUtils\';\nimport { downloadKmlForGoogleMyMaps, downloadIcsCalendar } from \'../utils/mapExportUtils\';\n\ninterface ItineraryViewProps {\n  plan: ItineraryPlanResponse;\n  originCity?: string;\n  completedActivities: Record<string, boolean>;\n  onToggleComplete: (activityKey: string) => void;\n  onOpenSwapModal: (dayNumber: number, activity: ActivityItem, geoFocus: string) => void;\n  onPrintPdf: () => void;\n  isLargeText: boolean;\n}\n\ntype TabType = \'schedule\' | \'map\' | \'flights\' | \'hotels\' | \'restaurants\' | \'phrases\' | \'logistics\';\n\nexport const ItineraryView: React.FC<ItineraryViewProps> = ({\n  plan,\n  originCity = \'\',\n  completedActivities,\n  onToggleComplete,\n  onOpenSwapModal,\n  onPrintPdf,\n  isLargeText,\n}) => {\n  const [activeTab, setActiveTab] = useState<TabType>(\'schedule\');\n  const [selectedDayFilter, setSelectedDayFilter] = useState<number | \'all\'>(\'all\');\n  const [isSaved, setIsSaved] = useState<boolean>(() => isTripSaved(plan));\n  const [saveToast, setSaveToast] = useState<string | null>(null);\n\n  const filteredDays =\n    selectedDayFilter === \'all\'\n      ? plan.itinerary\n      : plan.itinerary.filter((d) => d.day_number === selectedDayFilter);\n\n  const handleSaveTrip = () => {\n    saveTripToStorage(plan);\n    setIsSaved(true);\n    setSaveToast(\'Trip successfully saved to your browser storage!\');\n    setTimeout(() => setSaveToast(null), 3500);\n  };\n\n  const tabs = [\n    {\n      id: \'schedule\' as TabType,\n      label: \'Day-by-Day Plan\',\n      icon: Calendar,\n      count: plan.itinerary.length ? `${plan.itinerary.length} Days` : undefined,\n    },\n    {\n      id: \'map\' as TabType,\n      label: \'Interactive Map & Routes\',\n      icon: MapPin,\n      badge: \'Google Maps\',\n    },\n    {\n      id: \'flights\' as TabType,\n      label: \'Flights & Transit\',\n      icon: Plane,\n      count: plan.flight_analysis ? \'Airlines\' : undefined,\n    },\n    {\n      id: \'hotels\' as TabType,\n      label: \'Hotels & Stays\',\n      icon: Building2,\n      count: plan.hotel_recommendations?.length ? `${plan.hotel_recommendations.length}` : undefined,\n    },\n    {\n      id: \'restaurants\' as TabType,\n      label: \'Food & Dining\',\n      icon: UtensilsCrossed,\n      count: plan.restaurant_recommendations?.length ? `${plan.restaurant_recommendations.length}` : undefined,\n    },\n    {\n      id: \'phrases\' as TabType,\n      label: \'Phrasebook & Dialect\',\n      icon: Languages,\n      count: plan.local_phrases?.length ? `${plan.local_phrases.length}` : undefined,\n    },\n    {\n      id: \'logistics\' as TabType,\n      label: \'Tips & Logistics\',\n      icon: Compass,\n    },\n  ];\n\n  return (\n    <div className=\"space-y-8\" id=\"itinerary-main-view\">\n      {/* Toast Notification */}\n      {saveToast && (\n        <div className=\"fixed top-20 right-6 z-50 bg-[#1A1A1A] text-white px-4 py-3 rounded-2xl border-2 border-white shadow-[4px_4px_0px_0px_#10B981] animate-in fade-in slide-in-from-top-4 text-xs sm:text-sm font-black flex items-center gap-2\">\n          <span>\342\234\205</span>\n          <span>{saveToast}</span>\n        </div>\n      )}\n\n      {/* Hero Header */}\n      <TripSummaryHeader\n        summary={plan.trip_summary}\n        estimatedCosts={plan.estimated_costs}\n        onPrintPdf={onPrintPdf}\n        isLargeText={isLargeText}\n      />\n\n      {/* Action Toolbar: Save Trip, Add to Google Maps, Calendar */}\n      <div className=\"print:hidden rounded-2xl border-2 border-[#1A1A1A] bg-[#FAF9F5] p-3 sm:p-4 shadow-[4px_4px_0px_0px_#1A1A1A] flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={handleSaveTrip}\n            id=\"btn-save-trip-storage\"\n            className={`flex items-center gap-1.5 px-3.5 py-2 text-xs sm:text-sm font-black border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A] transition-all hover:translate-y-[-1px] ${\n              isSaved ? \'bg-[#DCFCE7] text-[#166534]\' : \'bg-[#FFFFFF] text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n            }`}\n          >\n            {isSaved ? (\n              <>\n                <BookmarkCheck className=\"w-4 h-4 text-[#166534]\" />\n                <span>Saved to Browser</span>\n              </>\n            ) : (\n              <>\n                <BookmarkPlus className=\"w-4 h-4 text-[#3B82F6]\" />\n                <span>Save This Trip</span>\n              </>\n            )}\n          </button>\n\n          <button\n            onClick={() => downloadKmlForGoogleMyMaps(plan)}\n            id=\"btn-quick-kml\"\n            className=\"hidden sm:flex items-center gap-1.5 px-3 py-2 text-xs font-black bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A]\"\n            title=\"Export KML for Google My Maps\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[#3B82F6]\" />\n            <span>Google My Maps (.kml)</span>\n          </button>\n\n          <button\n            onClick={() => downloadIcsCalendar(plan)}\n            id=\"btn-quick-ics\"\n            className=\"hidden sm:flex items-center gap-1.5 px-3 py-2 text-xs font-black bg-[#FFFFFF] hover:bg-[#F3F4F1] text-[#1A1A1A] border-2 border-[#1A1A1A] rounded-xl shadow-[2px_2px_0px_0px_#1A1A1A]\"\n            title=\"Download Calendar .ics file\"\n          >\n            <Calendar className=\"w-3.5 h-3.5 text-[#8B5CF6]\" />\n            <span>Calendar (.ics)</span>\n          </button>\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs font-bold text-[#718096]\">\n          <span>\360\237\223\215 {plan.trip_summary.destination}</span>\n          <span>\342\200\242</span>\n          <span>{plan.itinerary.length} Days</span>\n          <span>\342\200\242</span>\n          <span className=\"font-extrabold text-[#1A1A1A]\">\n            {plan.estimated_costs.currency_symbol || \'$\'}\n            {plan.estimated_costs.currency}\n          </span>\n        </div>\n      </div>\n\n      {/* Bento Main Tab Navigation Bar */}\n      <div className=\"print:hidden rounded-2xl border-2 border-[#1A1A1A] bg-white p-2 shadow-[4px_4px_0px_0px_#1A1A1A]\">\n        <nav className=\"flex flex-wrap items-center gap-2\" aria-label=\"Tabs\">\n          {tabs.map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                type=\"button\"\n                id={`tab-btn-${tab.id}`}\n                onClick={() => setActiveTab(tab.id)}\n                className={`flex items-center gap-2 rounded-xl px-3.5 sm:px-4 py-2.5 text-xs sm:text-sm font-black transition ${\n                  isActive\n                    ? \'border-2 border-[#1A1A1A] bg-[#C5E876] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                    : \'border-2 border-transparent text-stone-700 hover:border-[#1A1A1A] hover:bg-stone-50\'\n                }`}\n              >\n                <Icon className=\"h-4 w-4 shrink-0\" />\n                <span>{tab.label}</span>\n                {tab.count && (\n                  <span\n                    className={`rounded-md border border-[#1A1A1A] px-1.5 py-0.5 text-[11px] font-black ${\n                      isActive\n                        ? \'bg-white text-[#1A1A1A]\'\n                        : \'bg-stone-100 text-stone-800\'\n                    }`}\n                  >\n                    {tab.count}\n                  </span>\n                )}\n                {tab.badge && (\n                  <span className=\"hidden md:inline-block rounded-md border border-[#1A1A1A] bg-[#3B82F6] text-white px-1.5 py-0.5 text-[10px] font-black\">\n                    {tab.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Tab 1: Day-by-Day Schedule */}\n      {activeTab === \'schedule\' && (\n        <div className=\"space-y-8\">\n          {/* Day Selector Pill Filter */}\n          <div className=\"print:hidden flex flex-wrap items-center justify-between gap-3 rounded-2xl border-2 border-[#1A1A1A] bg-white p-4 shadow-[3px_3px_0px_0px_#1A1A1A]\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xs font-black uppercase tracking-wider text-stone-500\">\n                Filter Day:\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => setSelectedDayFilter(\'all\')}\n                  className={`rounded-xl border border-[#1A1A1A] px-3.5 py-1.5 text-xs font-black transition ${\n                    selectedDayFilter === \'all\'\n                      ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                      : \'bg-white text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n                  }`}\n                >\n                  All Days ({plan.itinerary.length})\n                </button>\n                {plan.itinerary.map((d) => (\n                  <button\n                    key={d.day_number}\n                    type=\"button\"\n                    onClick={() => setSelectedDayFilter(d.day_number)}\n                    className={`rounded-xl border border-[#1A1A1A] px-3.5 py-1.5 text-xs font-black transition ${\n                      selectedDayFilter === d.day_number\n                        ? \'bg-[#C5E876] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                        : \'bg-white text-[#1A1A1A] hover:bg-[#F3F4F1]\'\n                    }`}\n                  >\n                    Day {d.day_number}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <button\n                onClick={() => setActiveTab(\'map\')}\n                className=\"inline-flex items-center gap-1.5 text-xs font-black text-[#3B82F6] hover:underline\"\n              >\n                <MapPin className=\"w-3.5 h-3.5\" />\n                <span>View Full Map & Routes</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Day Cards */}\n          <div className=\"space-y-6\">\n            {filteredDays.map((day) => (\n              <DayScheduleCard\n                key={day.day_number}\n                day={day}\n                destination={plan.trip_summary.destination}\n                completedActivities={completedActivities}\n                onToggleComplete={onToggleComplete}\n                onOpenSwapModal={onOpenSwapModal}\n                isLargeText={isLargeText}\n              />\n            ))}\n          </div>\n\n          {/* Interactive Map Quick-View (Embedded in schedule tab as well) */}\n          <div className=\"mt-8\">\n            <InteractiveMapWidget\n              plan={plan}\n              selectedDay={selectedDayFilter === \'all\' ? undefined : selectedDayFilter}\n              onSelectDay={(dayNum) => setSelectedDayFilter(dayNum === 0 ? \'all\' : dayNum)}\n            />\n          </div>\n\n          {/* Cost Breakdown in Plan Currency */}\n          <CostBreakdownCard\n            costs={plan.estimated_costs}\n            totalDays={plan.trip_summary.total_days}\n            isLargeText={isLargeText}\n          />\n\n          {/* Researched Fun Facts & Trivia */}\n          <FunFactsSection\n            funFacts={plan.fun_facts}\n            destination={plan.trip_summary.destination}\n            isLargeText={isLargeText}\n          />\n        </div>\n      )}\n\n      {/* Tab 2: Interactive Map & Google Maps Routes */}\n      {activeTab === \'map\' && (\n        <div className=\"space-y-6\">\n          <InteractiveMapWidget plan={plan} />\n        </div>\n      )}\n\n      {/* Tab 3: Flights & Transit */}\n      {activeTab === \'flights\' && (\n        <FlightFinderSection plan={plan} initialOrigin={originCity || \'New York (JFK)\'} />\n      )}\n\n      {/* Tab 4: Hotels & Stays */}\n      {activeTab === \'hotels\' && (\n        <HotelSection\n          hotels={plan.hotel_recommendations}\n          destination={plan.trip_summary.destination}\n          currency={plan.estimated_costs.currency}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 5: Food & Dining */}\n      {activeTab === \'restaurants\' && (\n        <RestaurantSection\n          restaurants={plan.restaurant_recommendations}\n          destination={plan.trip_summary.destination}\n          currency={plan.estimated_costs.currency}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 6: Survival Phrases & Local Dialect */}\n      {activeTab === \'phrases\' && (\n        <SurvivalPhrasesSection\n          phrases={plan.local_phrases}\n          destination={plan.trip_summary.destination}\n          isLargeText={isLargeText}\n        />\n      )}\n\n      {/* Tab 7: Tips & Logistics */}\n      {activeTab === \'logistics\' && (\n        <LogisticsGuideCard\n          guide={plan.local_logistics_guide}\n          isLargeText={isLargeText}\n        />\n      )}\n    </div>\n  );\n};\n"
    }
