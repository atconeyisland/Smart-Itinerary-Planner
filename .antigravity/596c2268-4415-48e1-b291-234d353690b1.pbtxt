    instruction: "Update PlannerForm to Bento Grid design theme"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Users,\n  Wallet,\n  Zap,\n  Heart,\n  ShieldAlert,\n  Sparkles,\n  ArrowRight,\n  BookmarkCheck,\n  Compass,\n} from \'lucide-react\';\nimport { PlannerInputs } from \'../types\';\nimport { SAMPLE_PRESETS } from \'../sampleData\';\n\ninterface PlannerFormProps {\n  inputs: PlannerInputs;\n  onChange: (inputs: PlannerInputs) => void;\n  onSubmit: (e: React.FormEvent) => void;\n  isLoading: boolean;\n  onSelectPreset: (presetIndex: number) => void;\n}\n\nconst COMMON_INTERESTS = [\n  \'Historic Sites\',\n  \'Street Food & Markets\',\n  \'Fine Dining\',\n  \'Art & Museums\',\n  \'Architecture\',\n  \'Scenic Nature & Parks\',\n  \'Nightlife & Bars\',\n  \'Photography Spots\',\n  \'Vintage & Flea Markets\',\n  \'Local Neighborhoods\',\n  \'Coffee & Bakeries\',\n  \'Hiking & Coastal Walks\',\n];\n\nconst COMMON_CONSTRAINTS = [\n  \'Vegetarian / Vegan only\',\n  \'Wheelchair accessible\',\n  \'Avoid tourist crowds\',\n  \'Early riser schedule\',\n  \'Family friendly\',\n  \'Museum pass optimization\',\n  \'Public transit only\',\n  \'Halal food options\',\n];\n\nconst DESTINATION_SUGGESTIONS = [\n  \'Kyoto, Japan\',\n  \'Paris, France\',\n  \'Rome, Italy\',\n  \'Tokyo, Japan\',\n  \'Barcelona, Spain\',\n  \'Reykjavik, Iceland\',\n  \'Bangkok, Thailand\',\n  \'Lisbon, Portugal\',\n  \'Cape Town, South Africa\',\n  \'Oaxaca, Mexico\',\n];\n\nexport const PlannerForm: React.FC<PlannerFormProps> = ({\n  inputs,\n  onChange,\n  onSubmit,\n  isLoading,\n  onSelectPreset,\n}) => {\n  const [customInterest, setCustomInterest] = useState(\'\');\n  const [customConstraint, setCustomConstraint] = useState(\'\');\n\n  const currentInterestsList = inputs.interests\n    ? inputs.interests.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const currentConstraintsList = inputs.constraints\n    ? inputs.constraints.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const toggleInterest = (interest: string) => {\n    let updated: string[];\n    if (currentInterestsList.includes(interest)) {\n      updated = currentInterestsList.filter((i) => i !== interest);\n    } else {\n      updated = [...currentInterestsList, interest];\n    }\n    onChange({ ...inputs, interests: updated.join(\', \') });\n  };\n\n  const addCustomInterest = (e: React.KeyboardEvent | React.MouseEvent) => {\n    if (customInterest.trim() && !currentInterestsList.includes(customInterest.trim())) {\n      const updated = [...currentInterestsList, customInterest.trim()];\n      onChange({ ...inputs, interests: updated.join(\', \') });\n      setCustomInterest(\'\');\n    }\n  };\n\n  const toggleConstraint = (constraint: string) => {\n    let updated: string[];\n    if (currentConstraintsList.includes(constraint)) {\n      updated = currentConstraintsList.filter((c) => c !== constraint);\n    } else {\n      updated = [...currentConstraintsList, constraint];\n    }\n    onChange({ ...inputs, constraints: updated.join(\', \') });\n  };\n\n  const addCustomConstraint = (e: React.KeyboardEvent | React.MouseEvent) => {\n    if (customConstraint.trim() && !currentConstraintsList.includes(customConstraint.trim())) {\n      const updated = [...currentConstraintsList, customConstraint.trim()];\n      onChange({ ...inputs, constraints: updated.join(\', \') });\n      setCustomConstraint(\'\');\n    }\n  };\n\n  return (\n    <div className=\"mx-auto max-w-4xl space-y-8\">\n      {/* Preset Inspiration Banner */}\n      <div className=\"rounded-2xl border border-amber-200/70 bg-gradient-to-br from-amber-50/80 via-orange-50/40 to-stone-50 p-5 shadow-xs\">\n        <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-amber-600/10 text-amber-800\">\n              <BookmarkCheck className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-semibold text-stone-900\">\n                Quick Inspiration Presets\n              </h2>\n              <p className=\"text-xs text-stone-600\">\n                Instantly load proven realistic itineraries crafted to operational rules\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2\">\n            {SAMPLE_PRESETS.map((preset, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => onSelectPreset(idx)}\n                className=\"inline-flex items-center gap-1.5 rounded-lg border border-amber-300/80 bg-white/90 px-3 py-1.5 text-xs font-medium text-stone-800 shadow-2xs transition hover:border-amber-500 hover:bg-white hover:text-amber-900\"\n              >\n                <Compass className=\"h-3.5 w-3.5 text-amber-700\" />\n                <span>{preset.label.split(\' \')[0]} ({preset.inputs.duration}d)</span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Main Parameters Card */}\n      <form\n        onSubmit={onSubmit}\n        className=\"rounded-2xl border border-stone-200 bg-white p-6 shadow-sm md:p-8\"\n      >\n        <div className=\"mb-6 border-b border-stone-100 pb-4\">\n          <h2 className=\"text-xl font-bold tracking-tight text-stone-900\">\n            Trip Specifications & Variables\n          </h2>\n          <p className=\"mt-1 text-sm text-stone-500\">\n            Configure your target constraints. The engine optimizes for geographic realism, neighborhood proximity, timing buffers, and fatigue avoidance.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2\">\n          {/* Destination */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label\n              htmlFor=\"destination-input\"\n              className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\"\n            >\n              <MapPin className=\"h-4 w-4 text-amber-700\" />\n              Target Destination\n            </label>\n            <input\n              id=\"destination-input\"\n              type=\"text\"\n              required\n              placeholder=\"e.g. Kyoto, Japan or Florence, Italy\"\n              value={inputs.destination}\n              onChange={(e) => onChange({ ...inputs, destination: e.target.value })}\n              className=\"w-full rounded-xl border border-stone-300 bg-stone-50/50 px-4 py-2.5 text-sm text-stone-900 placeholder:text-stone-400 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n            />\n            {/* Quick Suggestions */}\n            <div className=\"flex flex-wrap items-center gap-1.5 pt-1 text-xs\">\n              <span className=\"text-stone-500\">Quick picks:</span>\n              {DESTINATION_SUGGESTIONS.slice(0, 6).map((dest) => (\n                <button\n                  key={dest}\n                  type=\"button\"\n                  onClick={() => onChange({ ...inputs, destination: dest })}\n                  className=\"rounded-md bg-stone-100 px-2 py-0.5 text-stone-600 transition hover:bg-amber-100 hover:text-amber-800\"\n                >\n                  {dest}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Duration */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label\n                htmlFor=\"duration-input\"\n                className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\"\n              >\n                <Calendar className=\"h-4 w-4 text-amber-700\" />\n                Trip Duration (Days)\n              </label>\n              <span className=\"rounded-md bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800\">\n                {inputs.duration} {inputs.duration === 1 ? \'Day\' : \'Days\'}\n              </span>\n            </div>\n            <input\n              id=\"duration-input\"\n              type=\"range\"\n              min={1}\n              max={10}\n              step={1}\n              value={inputs.duration}\n              onChange={(e) =>\n                onChange({ ...inputs, duration: parseInt(e.target.value, 10) || 1 })\n              }\n              className=\"w-full accent-amber-700 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[11px] text-stone-400\">\n              <span>1 Day</span>\n              <span>3 Days</span>\n              <span>5 Days</span>\n              <span>7 Days</span>\n              <span>10 Days</span>\n            </div>\n          </div>\n\n          {/* Travelers */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"travelers-select\"\n              className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\"\n            >\n              <Users className=\"h-4 w-4 text-amber-700\" />\n              Travelers Composition\n            </label>\n            <select\n              id=\"travelers-select\"\n              value={inputs.travelers}\n              onChange={(e) => onChange({ ...inputs, travelers: e.target.value })}\n              className=\"w-full rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-2.5 text-sm text-stone-900 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n            >\n              <option value=\"Solo Traveler\">Solo Traveler</option>\n              <option value=\"Couple\">Couple (Romantic & Scenic)</option>\n              <option value=\"Family with young kids\">Family with young kids</option>\n              <option value=\"Family with teens\">Family with teens</option>\n              <option value=\"Group of friends\">Group of friends</option>\n              <option value=\"Business + Leisure\">Business + Leisure</option>\n            </select>\n          </div>\n\n          {/* Budget Tier */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"budget-select\"\n              className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\"\n            >\n              <Wallet className=\"h-4 w-4 text-amber-700\" />\n              Budget Tier / Target\n            </label>\n            <select\n              id=\"budget-select\"\n              value={inputs.budget}\n              onChange={(e) => onChange({ ...inputs, budget: e.target.value })}\n              className=\"w-full rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-2.5 text-sm text-stone-900 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n            >\n              <option value=\"Budget ($50-90/day)\">Budget ($50\342\200\223$90/day, street food, public transit)</option>\n              <option value=\"Moderate ($120-220/day)\">Moderate ($120\342\200\223$220/day, bistros, standard attractions)</option>\n              <option value=\"Luxury ($300+/day)\">Luxury ($300+/day, fine dining, private tours, taxis)</option>\n              <option value=\"Strictly Low Cost / Backpacker\">Strictly Low Cost / Backpacker (Free activities priority)</option>\n            </select>\n          </div>\n\n          {/* Pace Intensity */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"pace-select\"\n              className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\"\n            >\n              <Zap className=\"h-4 w-4 text-amber-700\" />\n              Pace & Intensity\n            </label>\n            <select\n              id=\"pace-select\"\n              value={inputs.pace}\n              onChange={(e) => onChange({ ...inputs, pace: e.target.value })}\n              className=\"w-full rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-2.5 text-sm text-stone-900 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n            >\n              <option value=\"Relaxed\">Relaxed (1-2 main spots/day, generous cafe downtime)</option>\n              <option value=\"Balanced\">Balanced (Optimal variety, 2-3 spots/day + food highlights)</option>\n              <option value=\"Fast-paced\">Fast-paced (Maximize highlights, early starts, packed days)</option>\n            </select>\n          </div>\n\n          {/* Interests Multi-Select */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\">\n              <Heart className=\"h-4 w-4 text-amber-700\" />\n              Primary Interests & Focus\n            </label>\n            <p className=\"text-xs text-stone-500\">\n              Select key categories or add custom focus areas:\n            </p>\n            <div className=\"flex flex-wrap gap-1.5 pt-1\">\n              {COMMON_INTERESTS.map((interest) => {\n                const isSelected = currentInterestsList.includes(interest);\n                return (\n                  <button\n                    key={interest}\n                    type=\"button\"\n                    onClick={() => toggleInterest(interest)}\n                    className={`rounded-lg px-3 py-1.5 text-xs font-medium transition ${\n                      isSelected\n                        ? \'bg-amber-800 text-white shadow-2xs\'\n                        : \'border border-stone-200 bg-stone-50 text-stone-700 hover:bg-stone-100\'\n                    }`}\n                  >\n                    {interest}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"flex gap-2 pt-2\">\n              <input\n                type=\"text\"\n                placeholder=\"Add custom interest (e.g. ceramics, wine tasting, photography)...\"\n                value={customInterest}\n                onChange={(e) => setCustomInterest(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    addCustomInterest(e);\n                  }\n                }}\n                className=\"flex-1 rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-1.5 text-xs text-stone-900 placeholder:text-stone-400 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n              />\n              <button\n                type=\"button\"\n                onClick={addCustomInterest}\n                className=\"rounded-xl border border-stone-300 bg-stone-100 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-200\"\n              >\n                Add\n              </button>\n            </div>\n          </div>\n\n          {/* Constraints & Needs */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label className=\"flex items-center gap-1.5 text-sm font-semibold text-stone-800\">\n              <ShieldAlert className=\"h-4 w-4 text-amber-700\" />\n              Specific Constraints & Needs\n            </label>\n            <p className=\"text-xs text-stone-500\">\n              Select operational constraints or specify unique dietary/accessibility parameters:\n            </p>\n            <div className=\"flex flex-wrap gap-1.5 pt-1\">\n              {COMMON_CONSTRAINTS.map((constraint) => {\n                const isSelected = currentConstraintsList.includes(constraint);\n                return (\n                  <button\n                    key={constraint}\n                    type=\"button\"\n                    onClick={() => toggleConstraint(constraint)}\n                    className={`rounded-lg px-3 py-1.5 text-xs font-medium transition ${\n                      isSelected\n                        ? \'bg-amber-800 text-white shadow-2xs\'\n                        : \'border border-stone-200 bg-stone-50 text-stone-700 hover:bg-stone-100\'\n                    }`}\n                  >\n                    {constraint}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"flex gap-2 pt-2\">\n              <input\n                type=\"text\"\n                placeholder=\"Add specific constraint (e.g. no steep uphill walking, gluten-free restaurants)...\"\n                value={customConstraint}\n                onChange={(e) => setCustomConstraint(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    addCustomConstraint(e);\n                  }\n                }}\n                className=\"flex-1 rounded-xl border border-stone-300 bg-stone-50/50 px-3.5 py-1.5 text-xs text-stone-900 placeholder:text-stone-400 focus:border-amber-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n              />\n              <button\n                type=\"button\"\n                onClick={addCustomConstraint}\n                className=\"rounded-xl border border-stone-300 bg-stone-100 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-200\"\n              >\n                Add\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Submit Action */}\n        <div className=\"mt-8 border-t border-stone-100 pt-6\">\n          <button\n            type=\"submit\"\n            disabled={isLoading || !inputs.destination}\n            className=\"flex w-full items-center justify-center gap-2 rounded-xl bg-amber-800 py-3.5 px-6 text-sm font-semibold text-stone-50 shadow-md transition hover:bg-amber-900 focus:outline-none focus:ring-4 focus:ring-amber-500/30 disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            {isLoading ? (\n              <>\n                <div className=\"h-4 w-4 animate-spin rounded-full border-2 border-stone-50 border-t-transparent\" />\n                <span>Generating Geographically Optimized Itinerary...</span>\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"h-4 w-4\" />\n                <span>Generate Smart Day-by-Day Itinerary</span>\n                <ArrowRight className=\"h-4 w-4\" />\n              </>\n            )}\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport {\n  MapPin,\n  Calendar,\n  Users,\n  Wallet,\n  Zap,\n  Heart,\n  ShieldAlert,\n  Sparkles,\n  ArrowRight,\n  BookmarkCheck,\n  Compass,\n} from \'lucide-react\';\nimport { PlannerInputs } from \'../types\';\nimport { SAMPLE_PRESETS } from \'../sampleData\';\n\ninterface PlannerFormProps {\n  inputs: PlannerInputs;\n  onChange: (inputs: PlannerInputs) => void;\n  onSubmit: (e: React.FormEvent) => void;\n  isLoading: boolean;\n  onSelectPreset: (presetIndex: number) => void;\n}\n\nconst COMMON_INTERESTS = [\n  \'Historic Sites\',\n  \'Street Food & Markets\',\n  \'Fine Dining\',\n  \'Art & Museums\',\n  \'Architecture\',\n  \'Scenic Nature & Parks\',\n  \'Nightlife & Bars\',\n  \'Photography Spots\',\n  \'Vintage & Flea Markets\',\n  \'Local Neighborhoods\',\n  \'Coffee & Bakeries\',\n  \'Hiking & Coastal Walks\',\n];\n\nconst COMMON_CONSTRAINTS = [\n  \'Vegetarian / Vegan only\',\n  \'Wheelchair accessible\',\n  \'Avoid tourist crowds\',\n  \'Early riser schedule\',\n  \'Family friendly\',\n  \'Museum pass optimization\',\n  \'Public transit only\',\n  \'Halal food options\',\n];\n\nconst DESTINATION_SUGGESTIONS = [\n  \'Kyoto, Japan\',\n  \'Paris, France\',\n  \'Rome, Italy\',\n  \'Tokyo, Japan\',\n  \'Barcelona, Spain\',\n  \'Reykjavik, Iceland\',\n  \'Bangkok, Thailand\',\n  \'Lisbon, Portugal\',\n  \'Cape Town, South Africa\',\n  \'Oaxaca, Mexico\',\n];\n\nexport const PlannerForm: React.FC<PlannerFormProps> = ({\n  inputs,\n  onChange,\n  onSubmit,\n  isLoading,\n  onSelectPreset,\n}) => {\n  const [customInterest, setCustomInterest] = useState(\'\');\n  const [customConstraint, setCustomConstraint] = useState(\'\');\n\n  const currentInterestsList = inputs.interests\n    ? inputs.interests.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const currentConstraintsList = inputs.constraints\n    ? inputs.constraints.split(\',\').map((s) => s.trim()).filter(Boolean)\n    : [];\n\n  const toggleInterest = (interest: string) => {\n    let updated: string[];\n    if (currentInterestsList.includes(interest)) {\n      updated = currentInterestsList.filter((i) => i !== interest);\n    } else {\n      updated = [...currentInterestsList, interest];\n    }\n    onChange({ ...inputs, interests: updated.join(\', \') });\n  };\n\n  const addCustomInterest = (e: React.KeyboardEvent | React.MouseEvent) => {\n    if (customInterest.trim() && !currentInterestsList.includes(customInterest.trim())) {\n      const updated = [...currentInterestsList, customInterest.trim()];\n      onChange({ ...inputs, interests: updated.join(\', \') });\n      setCustomInterest(\'\');\n    }\n  };\n\n  const toggleConstraint = (constraint: string) => {\n    let updated: string[];\n    if (currentConstraintsList.includes(constraint)) {\n      updated = currentConstraintsList.filter((c) => c !== constraint);\n    } else {\n      updated = [...currentConstraintsList, constraint];\n    }\n    onChange({ ...inputs, constraints: updated.join(\', \') });\n  };\n\n  const addCustomConstraint = (e: React.KeyboardEvent | React.MouseEvent) => {\n    if (customConstraint.trim() && !currentConstraintsList.includes(customConstraint.trim())) {\n      const updated = [...currentConstraintsList, customConstraint.trim()];\n      onChange({ ...inputs, constraints: updated.join(\', \') });\n      setCustomConstraint(\'\');\n    }\n  };\n\n  return (\n    <div className=\"mx-auto max-w-4xl space-y-6\">\n      {/* Preset Inspiration Bento Banner */}\n      <div className=\"rounded-3xl border-2 border-[#1A1A1A] bg-[#C5E876] p-6 shadow-[6px_6px_0px_0px_#1A1A1A]\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex h-10 w-10 items-center justify-center rounded-xl border-2 border-[#1A1A1A] bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\">\n              <BookmarkCheck className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-black uppercase tracking-tight text-[#1A1A1A]\">\n                Quick Inspiration Presets\n              </h2>\n              <p className=\"text-xs font-medium text-[#1A1A1A]/80\">\n                Load proven realistic itineraries crafted to strict operational clustering rules\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2\">\n            {SAMPLE_PRESETS.map((preset, idx) => (\n              <button\n                key={idx}\n                type=\"button\"\n                onClick={() => onSelectPreset(idx)}\n                className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-white px-3.5 py-1.5 text-xs font-bold text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-[#FFD4D4] active:translate-x-0.5 active:translate-y-0.5\"\n              >\n                <Compass className=\"h-3.5 w-3.5\" />\n                <span>{preset.label.split(\' \')[0]} ({preset.inputs.duration}d)</span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Main Parameters Bento Card */}\n      <form\n        onSubmit={onSubmit}\n        className=\"rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[6px_6px_0px_0px_#1A1A1A] md:p-8\"\n      >\n        <div className=\"mb-6 border-b-2 border-[#1A1A1A] border-dashed pb-4\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"h-2.5 w-2.5 rounded-full bg-[#1A1A1A]\" />\n            <h2 className=\"text-xl font-black uppercase italic tracking-tighter text-[#1A1A1A] sm:text-2xl\">\n              Trip Specifications & Constraints\n            </h2>\n          </div>\n          <p className=\"text-xs font-medium text-[#1A1A1A]/70\">\n            Configure your target constraints. The engine optimizes for geographic realism, neighborhood proximity, timing buffers, and fatigue avoidance.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 gap-6 md:grid-cols-2\">\n          {/* Destination */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label\n              htmlFor=\"destination-input\"\n              className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\"\n            >\n              <MapPin className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Target Destination\n            </label>\n            <input\n              id=\"destination-input\"\n              type=\"text\"\n              required\n              placeholder=\"e.g. Kyoto, Japan or Florence, Italy\"\n              value={inputs.destination}\n              onChange={(e) => onChange({ ...inputs, destination: e.target.value })}\n              className=\"w-full rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-4 py-3 text-sm font-bold text-[#1A1A1A] placeholder:text-[#1A1A1A]/40 shadow-[3px_3px_0px_0px_#1A1A1A] focus:bg-white focus:outline-none\"\n            />\n            {/* Quick Suggestions */}\n            <div className=\"flex flex-wrap items-center gap-1.5 pt-1 text-xs\">\n              <span className=\"font-bold text-[11px] uppercase opacity-60\">Quick picks:</span>\n              {DESTINATION_SUGGESTIONS.slice(0, 6).map((dest) => (\n                <button\n                  key={dest}\n                  type=\"button\"\n                  onClick={() => onChange({ ...inputs, destination: dest })}\n                  className=\"rounded-lg border border-[#1A1A1A] bg-[#F3F4F1] px-2 py-0.5 text-xs font-bold text-[#1A1A1A] transition hover:bg-[#C5E876]\"\n                >\n                  {dest}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Duration */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label\n                htmlFor=\"duration-input\"\n                className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\"\n              >\n                <Calendar className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n                Trip Duration\n              </label>\n              <span className=\"rounded-lg border border-[#1A1A1A] bg-[#FFD4D4] px-2.5 py-0.5 text-xs font-black text-[#1A1A1A]\">\n                {inputs.duration} {inputs.duration === 1 ? \'Day\' : \'Days\'}\n              </span>\n            </div>\n            <input\n              id=\"duration-input\"\n              type=\"range\"\n              min={1}\n              max={10}\n              step={1}\n              value={inputs.duration}\n              onChange={(e) =>\n                onChange({ ...inputs, duration: parseInt(e.target.value, 10) || 1 })\n              }\n              className=\"w-full accent-[#1A1A1A] cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[11px] font-bold text-[#1A1A1A]/60\">\n              <span>1 Day</span>\n              <span>3 Days</span>\n              <span>5 Days</span>\n              <span>7 Days</span>\n              <span>10 Days</span>\n            </div>\n          </div>\n\n          {/* Travelers */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"travelers-select\"\n              className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\"\n            >\n              <Users className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Travelers Composition\n            </label>\n            <select\n              id=\"travelers-select\"\n              value={inputs.travelers}\n              onChange={(e) => onChange({ ...inputs, travelers: e.target.value })}\n              className=\"w-full rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-4 py-3 text-sm font-bold text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] focus:bg-white focus:outline-none\"\n            >\n              <option value=\"Solo Traveler\">Solo Traveler</option>\n              <option value=\"Couple\">Couple (Romantic & Scenic)</option>\n              <option value=\"Family with young kids\">Family with young kids</option>\n              <option value=\"Family with teens\">Family with teens</option>\n              <option value=\"Group of friends\">Group of friends</option>\n              <option value=\"Business + Leisure\">Business + Leisure</option>\n            </select>\n          </div>\n\n          {/* Budget Tier */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"budget-select\"\n              className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\"\n            >\n              <Wallet className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Budget Tier\n            </label>\n            <select\n              id=\"budget-select\"\n              value={inputs.budget}\n              onChange={(e) => onChange({ ...inputs, budget: e.target.value })}\n              className=\"w-full rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-4 py-3 text-sm font-bold text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] focus:bg-white focus:outline-none\"\n            >\n              <option value=\"Budget ($50-90/day)\">Budget ($50\342\200\223$90/day, street food, public transit)</option>\n              <option value=\"Moderate ($120-220/day)\">Moderate ($120\342\200\223$220/day, bistros, standard attractions)</option>\n              <option value=\"Luxury ($300+/day)\">Luxury ($300+/day, fine dining, private tours, taxis)</option>\n              <option value=\"Strictly Low Cost / Backpacker\">Strictly Low Cost / Backpacker (Free activities priority)</option>\n            </select>\n          </div>\n\n          {/* Pace Intensity */}\n          <div className=\"space-y-2\">\n            <label\n              htmlFor=\"pace-select\"\n              className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\"\n            >\n              <Zap className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Pace & Intensity\n            </label>\n            <select\n              id=\"pace-select\"\n              value={inputs.pace}\n              onChange={(e) => onChange({ ...inputs, pace: e.target.value })}\n              className=\"w-full rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-4 py-3 text-sm font-bold text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] focus:bg-white focus:outline-none\"\n            >\n              <option value=\"Relaxed\">Relaxed (1-2 main spots/day, generous cafe downtime)</option>\n              <option value=\"Balanced\">Balanced (Optimal variety, 2-3 spots/day + food highlights)</option>\n              <option value=\"Fast-paced\">Fast-paced (Maximize highlights, early starts, packed days)</option>\n            </select>\n          </div>\n\n          {/* Interests Multi-Select */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\">\n              <Heart className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Primary Interests & Focus\n            </label>\n            <div className=\"flex flex-wrap gap-2 pt-1\">\n              {COMMON_INTERESTS.map((interest) => {\n                const isSelected = currentInterestsList.includes(interest);\n                return (\n                  <button\n                    key={interest}\n                    type=\"button\"\n                    onClick={() => toggleInterest(interest)}\n                    className={`rounded-xl border-2 border-[#1A1A1A] px-3.5 py-1.5 text-xs font-bold transition ${\n                      isSelected\n                        ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                        : \'bg-[#F3F4F1] text-[#1A1A1A] hover:bg-[#C5E876] hover:-translate-y-0.5\'\n                    }`}\n                  >\n                    {interest}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"flex gap-2 pt-2\">\n              <input\n                type=\"text\"\n                placeholder=\"Add custom interest (e.g. ceramics, wine tasting, photography)...\"\n                value={customInterest}\n                onChange={(e) => setCustomInterest(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    addCustomInterest(e);\n                  }\n                }}\n                className=\"flex-1 rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3.5 py-2 text-xs font-bold text-[#1A1A1A] placeholder:text-[#1A1A1A]/40 focus:bg-white focus:outline-none\"\n              />\n              <button\n                type=\"button\"\n                onClick={addCustomInterest}\n                className=\"rounded-xl border-2 border-[#1A1A1A] bg-[#89CFF0] px-4 py-2 text-xs font-black uppercase tracking-wider text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] hover:bg-sky-300\"\n              >\n                Add\n              </button>\n            </div>\n          </div>\n\n          {/* Constraints & Needs */}\n          <div className=\"space-y-2 md:col-span-2\">\n            <label className=\"flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#1A1A1A]\">\n              <ShieldAlert className=\"h-3.5 w-3.5 text-[#1A1A1A]\" />\n              Specific Constraints & Needs\n            </label>\n            <div className=\"flex flex-wrap gap-2 pt-1\">\n              {COMMON_CONSTRAINTS.map((constraint) => {\n                const isSelected = currentConstraintsList.includes(constraint);\n                return (\n                  <button\n                    key={constraint}\n                    type=\"button\"\n                    onClick={() => toggleConstraint(constraint)}\n                    className={`rounded-xl border-2 border-[#1A1A1A] px-3.5 py-1.5 text-xs font-bold transition ${\n                      isSelected\n                        ? \'bg-[#1A1A1A] text-white shadow-[2px_2px_0px_0px_#1A1A1A]\'\n                        : \'bg-[#F3F4F1] text-[#1A1A1A] hover:bg-[#FFD4D4] hover:-translate-y-0.5\'\n                    }`}\n                  >\n                    {constraint}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"flex gap-2 pt-2\">\n              <input\n                type=\"text\"\n                placeholder=\"Add specific constraint (e.g. no steep uphill walking, gluten-free restaurants)...\"\n                value={customConstraint}\n                onChange={(e) => setCustomConstraint(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    e.preventDefault();\n                    addCustomConstraint(e);\n                  }\n                }}\n                className=\"flex-1 rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3.5 py-2 text-xs font-bold text-[#1A1A1A] placeholder:text-[#1A1A1A]/40 focus:bg-white focus:outline-none\"\n              />\n              <button\n                type=\"button\"\n                onClick={addCustomConstraint}\n                className=\"rounded-xl border-2 border-[#1A1A1A] bg-[#FFD4D4] px-4 py-2 text-xs font-black uppercase tracking-wider text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] hover:bg-rose-300\"\n              >\n                Add\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Submit Action Button */}\n        <div className=\"mt-8 border-t-2 border-[#1A1A1A] border-dashed pt-6\">\n          <button\n            type=\"submit\"\n            disabled={isLoading || !inputs.destination}\n            className=\"flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-[#1A1A1A] bg-[#C5E876] py-4 px-6 text-sm font-black uppercase italic tracking-tight text-[#1A1A1A] shadow-[4px_4px_0px_0px_#1A1A1A] transition hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#1A1A1A] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[2px_2px_0px_0px_#1A1A1A] disabled:cursor-not-allowed disabled:opacity-50\"\n          >\n            {isLoading ? (\n              <>\n                <div className=\"h-4 w-4 animate-spin rounded-full border-2 border-[#1A1A1A] border-t-transparent\" />\n                <span>Optimizing Bento Schedule & Buffer Timing...</span>\n              </>\n            ) : (\n              <>\n                <Sparkles className=\"h-4 w-4\" />\n                <span>Generate Bento Travel Itinerary</span>\n                <ArrowRight className=\"h-4 w-4\" />\n              </>\n            )}\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
