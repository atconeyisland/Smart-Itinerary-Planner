    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { X, Sparkles, RefreshCw, AlertCircle } from \'lucide-react\';\nimport { ActivityItem } from \'../types\';\n\ninterface ActivitySwapModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  dayNumber: number;\n  dayTheme: string;\n  geographicalFocus: string;\n  activityIndex: number;\n  currentActivity: ActivityItem | null;\n  destination: string;\n  budget: string;\n  onActivitySwapped: (\n    dayNumber: number,\n    activityIndex: number,\n    newActivity: ActivityItem\n  ) => void;\n}\n\nconst SWAP_PROMPT_SUGGESTIONS = [\n  \'Recommend a quiet indoor museum / gallery instead\',\n  \'Find an authentic local bakery, tea house, or coffee roaster\',\n  \'Suggest a budget-friendly or free viewpoint / park\',\n  \'Give me an active walking or shopping lane alternative\',\n  \'Suggest a family-friendly activity suitable for all ages\',\n];\n\nexport const ActivitySwapModal: React.FC<ActivitySwapModalProps> = ({\n  isOpen,\n  onClose,\n  dayNumber,\n  dayTheme,\n  geographicalFocus,\n  activityIndex,\n  currentActivity,\n  destination,\n  budget,\n  onActivitySwapped,\n}) => {\n  const [preference, setPreference] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  if (!isOpen || !currentActivity) return null;\n\n  const handleSwap = async (customPref?: string) => {\n    const finalPreference = customPref || preference;\n    setLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\'/api/swap-activity\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          destination,\n          dayTheme,\n          geographicalFocus,\n          timeSlot: currentActivity.time_slot,\n          currentActivity,\n          preference: finalPreference,\n          budget,\n        }),\n      });\n\n      const data = await response.json();\n      if (data.success && data.activity) {\n        onActivitySwapped(dayNumber, activityIndex, data.activity);\n        onClose();\n      } else {\n        throw new Error(data.error || \'Could not replace activity.\');\n      }\n    } catch (err: any) {\n      console.error(err);\n      setError(err.message || \'Failed to replace activity.\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-stone-900/60 p-4 backdrop-blur-xs\">\n      <div className=\"relative w-full max-w-lg rounded-2xl border border-stone-200 bg-white p-6 shadow-2xl\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-stone-100 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-800\">\n              <Sparkles className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-bold text-stone-900\">\n                Replace Activity (Day {dayNumber})\n              </h3>\n              <p className=\"text-xs text-stone-500\">\n                Maintains geographic proximity in: <span className=\"font-semibold text-stone-700\">{geographicalFocus}</span>\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-lg p-1.5 text-stone-400 hover:bg-stone-100 hover:text-stone-700\"\n          >\n            <X className=\"h-5 w-5\" />\n          </button>\n        </div>\n\n        {/* Current Activity Overview */}\n        <div className=\"mt-4 rounded-xl border border-stone-100 bg-stone-50 p-3 text-xs\">\n          <span className=\"text-[11px] font-bold text-stone-500 uppercase\">\n            Replacing {currentActivity.time_slot} Slot:\n          </span>\n          <p className=\"mt-0.5 font-bold text-stone-900\">{currentActivity.activity_name}</p>\n          <p className=\"mt-0.5 text-stone-600 line-clamp-2\">{currentActivity.description}</p>\n        </div>\n\n        {/* Swap suggestions */}\n        <div className=\"mt-4 space-y-2\">\n          <label className=\"text-xs font-semibold text-stone-800\">\n            What kind of alternative would you like?\n          </label>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {SWAP_PROMPT_SUGGESTIONS.map((sug, i) => (\n              <button\n                key={i}\n                type=\"button\"\n                onClick={() => {\n                  setPreference(sug);\n                  handleSwap(sug);\n                }}\n                disabled={loading}\n                className=\"rounded-lg border border-stone-200 bg-white px-2.5 py-1 text-xs text-stone-700 transition hover:border-amber-400 hover:bg-amber-50 hover:text-amber-900 disabled:opacity-50\"\n              >\n                {sug}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"pt-2\">\n            <input\n              type=\"text\"\n              placeholder=\"Or write custom requirement (e.g. scenic canal walk, quiet garden)...\"\n              value={preference}\n              onChange={(e) => setPreference(e.target.value)}\n              onKeyDown={(e) => {\n                if (e.key === \'Enter\' && preference.trim()) {\n                  e.preventDefault();\n                  handleSwap();\n                }\n              }}\n              disabled={loading}\n              className=\"w-full rounded-xl border border-stone-300 px-3.5 py-2 text-xs text-stone-900 placeholder:text-stone-400 focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500/20\"\n            />\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"mt-3 flex items-center gap-1.5 text-xs text-red-600\">\n            <AlertCircle className=\"h-4 w-4 shrink-0\" />\n            <span>{error}</span>\n          </div>\n        )}\n\n        {/* Footer actions */}\n        <div className=\"mt-6 flex justify-end gap-2 border-t border-stone-100 pt-4\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            disabled={loading}\n            className=\"rounded-xl border border-stone-300 px-4 py-2 text-xs font-medium text-stone-700 hover:bg-stone-50\"\n          >\n            Cancel\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleSwap()}\n            disabled={loading}\n            className=\"inline-flex items-center gap-1.5 rounded-xl bg-amber-800 px-4 py-2 text-xs font-bold text-white shadow-xs transition hover:bg-amber-900 disabled:opacity-50\"\n          >\n            {loading ? (\n              <>\n                <div className=\"h-3.5 w-3.5 animate-spin rounded-full border-2 border-white border-t-transparent\" />\n                <span>Generating Alternative...</span>\n              </>\n            ) : (\n              <>\n                <RefreshCw className=\"h-3.5 w-3.5\" />\n                <span>Generate Alternative</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Sparkles, RefreshCw, AlertCircle } from \'lucide-react\';\nimport { ActivityItem } from \'../types\';\n\ninterface ActivitySwapModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  dayNumber: number;\n  dayTheme: string;\n  geographicalFocus: string;\n  activityIndex: number;\n  currentActivity: ActivityItem | null;\n  destination: string;\n  budget: string;\n  onActivitySwapped: (\n    dayNumber: number,\n    activityIndex: number,\n    newActivity: ActivityItem\n  ) => void;\n}\n\nconst SWAP_PROMPT_SUGGESTIONS = [\n  \'Recommend a quiet indoor museum / gallery instead\',\n  \'Find an authentic local bakery, tea house, or coffee roaster\',\n  \'Suggest a budget-friendly or free viewpoint / park\',\n  \'Give me an active walking or shopping lane alternative\',\n  \'Suggest a family-friendly activity suitable for all ages\',\n];\n\nexport const ActivitySwapModal: React.FC<ActivitySwapModalProps> = ({\n  isOpen,\n  onClose,\n  dayNumber,\n  dayTheme,\n  geographicalFocus,\n  activityIndex,\n  currentActivity,\n  destination,\n  budget,\n  onActivitySwapped,\n}) => {\n  const [preference, setPreference] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  if (!isOpen || !currentActivity) return null;\n\n  const handleSwap = async (customPref?: string) => {\n    const finalPreference = customPref || preference;\n    setLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\'/api/swap-activity\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          destination,\n          dayTheme,\n          geographicalFocus,\n          timeSlot: currentActivity.time_slot,\n          currentActivity,\n          preference: finalPreference,\n          budget,\n        }),\n      });\n\n      const data = await response.json();\n      if (data.success && data.activity) {\n        onActivitySwapped(dayNumber, activityIndex, data.activity);\n        onClose();\n      } else {\n        throw new Error(data.error || \'Could not replace activity.\');\n      }\n    } catch (err: any) {\n      console.error(err);\n      setError(err.message || \'Failed to replace activity.\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-xs\">\n      <div className=\"relative w-full max-w-lg rounded-3xl border-2 border-[#1A1A1A] bg-white p-6 shadow-[8px_8px_0px_0px_#1A1A1A] text-[#1A1A1A]\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b-2 border-[#1A1A1A] border-dashed pb-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-[#1A1A1A]\" />\n            <div>\n              <h3 className=\"text-sm font-black uppercase tracking-wider text-[#1A1A1A]\">\n                Replace Activity (Day 0{dayNumber})\n              </h3>\n              <p className=\"text-[11px] font-bold opacity-60\">\n                Proximity zone: <span className=\"underline font-black\">{geographicalFocus}</span>\n              </p>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"rounded-xl border-2 border-[#1A1A1A] bg-white p-1.5 shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#FFD4D4]\"\n          >\n            <X className=\"h-4 w-4\" />\n          </button>\n        </div>\n\n        {/* Current Activity Overview */}\n        <div className=\"mt-4 rounded-2xl border-2 border-[#1A1A1A] bg-[#F3F4F1] p-3.5 text-xs\">\n          <span className=\"text-[10px] font-black uppercase tracking-wider opacity-60 block\">\n            Replacing {currentActivity.time_slot} Slot:\n          </span>\n          <p className=\"mt-0.5 font-black text-sm text-[#1A1A1A]\">{currentActivity.activity_name}</p>\n          <p className=\"mt-0.5 font-medium opacity-70 line-clamp-2\">{currentActivity.description}</p>\n        </div>\n\n        {/* Swap suggestions */}\n        <div className=\"mt-4 space-y-2\">\n          <label className=\"text-xs font-black uppercase tracking-wider text-[#1A1A1A]\">\n            Select an alternative style or write below:\n          </label>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {SWAP_PROMPT_SUGGESTIONS.map((sug, i) => (\n              <button\n                key={i}\n                type=\"button\"\n                onClick={() => {\n                  setPreference(sug);\n                  handleSwap(sug);\n                }}\n                disabled={loading}\n                className=\"rounded-xl border-2 border-[#1A1A1A] bg-white px-2.5 py-1 text-xs font-bold text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] transition hover:bg-[#C5E876] disabled:opacity-50\"\n              >\n                {sug}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"pt-2\">\n            <input\n              type=\"text\"\n              placeholder=\"Or custom prompt (e.g. quiet alleyway noodle spot, rooftop view)...\"\n              value={preference}\n              onChange={(e) => setPreference(e.target.value)}\n              onKeyDown={(e) => {\n                if (e.key === \'Enter\' && preference.trim()) {\n                  e.preventDefault();\n                  handleSwap();\n                }\n              }}\n              disabled={loading}\n              className=\"w-full rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-3.5 py-2 text-xs font-bold text-[#1A1A1A] placeholder:text-[#1A1A1A]/40 focus:bg-white focus:outline-none\"\n            />\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"mt-3 flex items-center gap-1.5 text-xs font-bold text-red-600\">\n            <AlertCircle className=\"h-4 w-4 shrink-0\" />\n            <span>{error}</span>\n          </div>\n        )}\n\n        {/* Footer actions */}\n        <div className=\"mt-6 flex justify-end gap-2 border-t-2 border-[#1A1A1A] border-dashed pt-4\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            disabled={loading}\n            className=\"rounded-xl border-2 border-[#1A1A1A] bg-[#F3F4F1] px-4 py-2 text-xs font-black uppercase text-[#1A1A1A] shadow-[2px_2px_0px_0px_#1A1A1A] hover:bg-white\"\n          >\n            Cancel\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => handleSwap()}\n            disabled={loading}\n            className=\"inline-flex items-center gap-1.5 rounded-xl border-2 border-[#1A1A1A] bg-[#C5E876] px-4 py-2 text-xs font-black uppercase text-[#1A1A1A] shadow-[3px_3px_0px_0px_#1A1A1A] transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none disabled:opacity-50\"\n          >\n            {loading ? (\n              <>\n                <div className=\"h-3.5 w-3.5 animate-spin rounded-full border-2 border-[#1A1A1A] border-t-transparent\" />\n                <span>Generating Alternative...</span>\n              </>\n            ) : (\n              <>\n                <RefreshCw className=\"h-3.5 w-3.5\" />\n                <span>Swap Slot</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
