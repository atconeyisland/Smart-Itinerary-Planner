        }
        lines {
          text: "          title: \"Why is Jaipur Called the \'Pink City\'?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fact: \"In 1876, Maharaja Ram Singh painted the entire city terracotta pink\342\200\224the color of hospitality\342\200\224to welcome the Prince of Wales. A local law still mandates buildings in the walled city to maintain this hue!\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          tag: \"History & Heritage\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          title: \"World\'s Largest Stone Sundial\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fact: \"The Vrihat Samrat Yantra at Jantar Mantar stands 27 meters (88 feet) tall and can measure local solar time accurate to within 2 seconds.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          tag: \"Ancient Science\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          title: \"The Floating Mystery of Jal Mahal\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fact: \"While Jal Mahal appears to be a one-story pavilion floating on water, it actually has four submerged lower floors constructed with special waterproof lime mortar that has survived over 250 years.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          tag: \"Architecture\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          title: \"Wind Palace Designed for Royal Queens\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          fact: \"Hawa Mahal\'s 953 screened jharokhas were engineered like an air-conditioner using the Venturi effect, allowing royal women to observe street festivals in complete privacy while enjoying breezy cool air.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          tag: \"Ingenious Design\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
